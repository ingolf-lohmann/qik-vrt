name: QIK-VRT one-shot PR356 PR204 reciprocal equality receipt v3
on:
  pull_request:
    branches:
      - main
    types:
      - opened
      - reopened
      - synchronize
    paths:
      - .github/workflows/qikvrt_materialize_pr356_pr204_receipt_once.yml
permissions:
  contents: write
concurrency:
  group: qikvrt-pr356-pr204-receipt-v3-${{ github.repository }}
  cancel-in-progress: false
jobs:
  materialize:
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository &&
      github.actor != 'github-actions[bot]'
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    env:
      SOURCE_REPOSITORY: Goldkelch/qik-vrt
      SOURCE_COMMIT: 1a7ca2e99a0791a27a0a280a8925e570b373264a
      SOURCE_WORKFLOW_BLOB: 1d220f6a6601f4b6dd88446cd07b12bc84ea6516
      WORKFLOW_PATH: .github/workflows/qikvrt_materialize_pr356_pr204_receipt_once.yml
      EXECUTOR_SHA256: 73bd9542f602201774b96ec54f755133e3dcbaf27b582abdb4691958d995b9a2
    steps:
      - name: Check out the exact proxy event head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
      - name: Recover and execute the exact reciprocal-receipt program
        shell: bash
        run: |
          set -euo pipefail
          git remote add receipt-source "https://github.com/$SOURCE_REPOSITORY.git"
          git fetch --no-tags receipt-source "$SOURCE_COMMIT"
          test "$(git rev-parse "$SOURCE_COMMIT:$WORKFLOW_PATH")" = "$SOURCE_WORKFLOW_BLOB"
          git show "$SOURCE_COMMIT:$WORKFLOW_PATH" > "$RUNNER_TEMP/source-workflow.yml"
          python3 - "$RUNNER_TEMP/source-workflow.yml" \
            "$RUNNER_TEMP/qikvrt_pr356_pr204_receipt_executor.py" <<'PY'
          import base64
          import hashlib
          import os
          from pathlib import Path
          import sys
          import zlib

          source = Path(sys.argv[1]).read_text(encoding="utf-8")
          start_marker = '          encoded = """\n'
          end_marker = '\n          """.replace("\\n", "").replace(" ", "")'
          start = source.index(start_marker) + len(start_marker)
          end = source.index(end_marker, start)
          encoded = "".join(
              line.strip() for line in source[start:end].splitlines()
          )
          raw = zlib.decompress(base64.b64decode(encoded))
          observed = hashlib.sha256(raw).hexdigest()
          if observed != os.environ["EXECUTOR_SHA256"]:
              raise SystemExit(f"BLOCK: executor digest differs: {observed}")
          Path(sys.argv[2]).write_bytes(raw)
          PY
          python3 "$RUNNER_TEMP/qikvrt_pr356_pr204_receipt_executor.py"
