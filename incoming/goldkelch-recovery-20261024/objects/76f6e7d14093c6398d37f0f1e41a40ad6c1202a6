name: QIK-VRT one-shot PR356 PR204 reciprocal equality receipt
on:
  pull_request:
    branches: [main]
    types: [opened, reopened, synchronize]
    paths: [.github/workflows/qikvrt_materialize_pr356_pr204_receipt_once.yml]
permissions:
  contents: write
concurrency:
  group: qikvrt-pr356-pr204-receipt-${{ github.repository }}
  cancel-in-progress: false
jobs:
  materialize:
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository &&
      github.actor != 'github-actions[bot]'
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    env:
      WORKFLOW_PATH: .github/workflows/qikvrt_materialize_pr356_pr204_receipt_once.yml
      PARENT_WORKFLOW_BLOB: 3ce95cad6b2664ff20473d7a7c6bbed4552dab03
      EXECUTOR_SHA256: f6b0e82e52aa2b147dd3f253b09153c07513e49317c013c29a5a6d13030dcc36
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
      - name: Recover and execute the exact digest-bound parent payload
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse "HEAD^:$WORKFLOW_PATH")" = "$PARENT_WORKFLOW_BLOB"
          git show "HEAD^:$WORKFLOW_PATH" > "$RUNNER_TEMP/parent-workflow.yml"
          python3 - "$RUNNER_TEMP/parent-workflow.yml" \
            "$RUNNER_TEMP/qikvrt_pr356_pr204_receipt_executor.py" <<'PY'
          import base64
          import hashlib
          import os
          from pathlib import Path
          import sys
          import zlib

          source = Path(sys.argv[1]).read_text(encoding="utf-8")
          start_marker = '          encoded = """\n'
          end_marker = '\n          """.replace("\\n", "")'
          start = source.index(start_marker) + len(start_marker)
          end = source.index(end_marker, start)
          encoded = "".join(source[start:end].splitlines())
          raw = zlib.decompress(base64.b64decode(encoded))
          observed = hashlib.sha256(raw).hexdigest()
          if observed != os.environ["EXECUTOR_SHA256"]:
              raise SystemExit(f"BLOCK: executor digest differs: {observed}")
          Path(sys.argv[2]).write_bytes(raw)
          PY
          python3 "$RUNNER_TEMP/qikvrt_pr356_pr204_receipt_executor.py"
