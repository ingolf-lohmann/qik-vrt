{
  "schema": "qikvrt_public_explanation_and_proof_program_v1",
  "title": "Explain QIK-VRT to the public and establish classical and machine-verifiable evidence",
  "author": "Ingolf Lohmann",
  "state": "OPEN_CANDIDATE",
  "objective": "Produce a human-readable, scientifically bounded and machine-verifiable reconstruction of QIK-VRT, its genesis, architecture, proofs, limits, publication chain and possible consequences.",
  "phases": [
    {
      "id": "P0_EXECUTIVE_EXPLANATION",
      "outputs": [
        "docs/explanation/QIKVRT_FOR_THE_PUBLIC_EXECUTIVE_SUMMARY_DE.md",
        "publications/QIKVRT_WHATSAPP_READALOUD_SUMMARY_DE.md"
      ],
      "acceptance": [
        "understandable_without_repository_specialism",
        "claims_separated_from_interpretations",
        "no_unverified_completion_claims"
      ]
    },
    {
      "id": "P1_HISTORICAL_RECONSTRUCTION",
      "outputs": [
        "chronology with issue, work-unit, commit, gate, merge, publication and synchronization bindings",
        "source inventory and text-family genealogy"
      ],
      "acceptance": [
        "complete traceability for included claims",
        "explicit omissions and unresolved conflicts"
      ]
    },
    {
      "id": "P2_CLASSICAL_SCIENTIFIC_MONOGRAPH",
      "outputs": [
        "LaTeX source",
        "reproducible PDF",
        "definitions, propositions, theorems, proofs and limitations"
      ],
      "acceptance": [
        "two deterministic builds where toolchain permits",
        "all figures and tables source-bound",
        "no physical claim inferred from repository mechanics"
      ]
    },
    {
      "id": "P3_MACHINE_PROOF",
      "outputs": [
        "closed claim inventory",
        "machine-readable claim matrix",
        "formal kernel statements and receipts where applicable",
        "positive and negative tests",
        "proof-object and provenance manifests"
      ],
      "acceptance": [
        "every completion-relevant claim dispositioned",
        "kernel dependency audit",
        "no proof escape or hidden axiom",
        "exact artifact bindings"
      ]
    },
    {
      "id": "P4_ZENODO_CANDIDATE",
      "outputs": [
        "exact upload manifest",
        "metadata candidate",
        "CITATION.cff",
        "file-level rights map",
        "prepublication return receipt",
        "machine-proof bundle"
      ],
      "acceptance": [
        "all bytes, sizes and digests frozen",
        "rights complete and non-ambiguous",
        "publication remains separate authorized effect"
      ]
    },
    {
      "id": "P5_IETF_CANDIDATES",
      "outputs": [
        "protocol gap analysis",
        "RFCXML candidates only where interoperability requirements exist",
        "deterministic TXT and HTML renderings"
      ],
      "acceptance": [
        "clear protocol scope",
        "security, privacy and IANA considerations",
        "no IETF consensus claim"
      ]
    },
    {
      "id": "P6_AUTHORITY_MIRROR_PROMOTION",
      "outputs": [
        "exact-head gate evidence",
        "Authority promotion",
        "history-preserving Mirror port",
        "reciprocal equality receipt"
      ],
      "acceptance": [
        "all applicable mandatory gates terminal",
        "zero executed failures",
        "verified scoped Authority/Mirror synchronization"
      ]
    }
  ],
  "epistemic_classes": [
    "FORMALLY_PROVED",
    "EMPIRICALLY_SUPPORTED",
    "SOURCE_BOUND",
    "NORMATIVE",
    "INTERPRETATIVE",
    "OPEN"
  ],
  "hard_boundaries": [
    "NO_PASS_WITHOUT_COMPLETE_CLAIM_INVENTORY",
    "NO_FINAL_PASS_WITHOUT_KERNEL_RECEIPTS_AND_TRACEABILITY",
    "NO_EFFECT_ACK_DONE_WITHOUT_VERIFIED_EXTERNAL_EFFECT",
    "NO_ZENODO_MUTATION_WITHOUT_EXACT_BYTE_BOUND_AUTHORIZATION",
    "NO_IETF_DATATRACKER_MUTATION_WITHOUT_EXACT_ARTIFACT_AUTHORIZATION",
    "NO_ABSOLUTE_AUTONOMY_CLAIM",
    "NO_PHYSICAL_RETROCAUSALITY_CLAIM_FROM_REPOSITORY_MODEL"
  ],
  "completion_claims": {
    "PASS": false,
    "FINAL_PASS": false,
    "EFFECT_ACK_DONE": false
  }
}
