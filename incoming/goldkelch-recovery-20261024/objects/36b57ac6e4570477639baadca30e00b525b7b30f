name: QIK-VRT history-preserving Mirror synchronizer v4

on:
  pull_request:
    branches:
      - main
    types:
      - opened
      - synchronize
      - reopened
    paths:
      - work-units/HISTORY_PRESERVING_MIRROR_SYNC_REQUEST.json

permissions:
  contents: write

concurrency:
  group: qikvrt-history-preserving-mirror-sync-v4-${{ github.event.pull_request.head.sha }}
  cancel-in-progress: false

jobs:
  construct-candidate-object:
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      MARKER_PATH: work-units/HISTORY_PRESERVING_MIRROR_SYNC_REQUEST.json
      TRIGGER_SHA: ${{ github.event.pull_request.head.sha }}
      TRIGGER_REF_NAME: ${{ github.head_ref }}
      GH_TOKEN: ${{ github.token }}
    steps:
      - name: Check out immutable trigger head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.TRIGGER_SHA }}
          fetch-depth: 0

      - name: Validate request and export frozen transaction
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$TRIGGER_SHA"
          python3 - <<'PY'
          import json
          import os
          import pathlib
          import re

          marker = json.loads(pathlib.Path(os.environ['MARKER_PATH']).read_text(encoding='utf-8'))
          sha40 = re.compile(r'^[0-9a-f]{40}$')
          sha64 = re.compile(r'^[0-9a-f]{64}$')
          safe_branch = re.compile(r'^[A-Za-z0-9._/-]+$')

          assert marker['schema'] == 'qikvrt_history_preserving_mirror_candidate_request_v4'
          assert marker['state'] == 'READY'
          assert marker['operation'] == 'DISPOSITION_BATCH_003_FIRST_SUBJECT_FROM_EXACT_PUBLIC_FREEZE'
          assert marker['authority_repository'] == 'Goldkelch/qik-vrt'
          assert marker['authority_pull_request'] == 225
          assert marker['authority_main'] == '0fea97ca7957c1ea76611fb9eb6c39f558f33355'
          assert marker['authority_exact_green_head'] == '0a760662fca8796117430ff4be452b47e959b6bb'
          assert marker['mirror_repository'] == 'ingolf-lohmann/qik-vrt'
          assert marker['execution_branch'] == os.environ['TRIGGER_REF_NAME']
          assert marker['execution_branch'].startswith('execution/history-preserving-mirror-sync-')
          assert marker['target_branch'].startswith('sync/')
          assert safe_branch.fullmatch(marker['execution_branch'])
          assert safe_branch.fullmatch(marker['target_branch'])
          assert '..' not in marker['execution_branch']
          assert '..' not in marker['target_branch']
          for key in (
              'authority_main',
              'authority_exact_green_head',
              'mirror_parent',
              'authority_manifest_git_blob_sha1',
          ):
              assert sha40.fullmatch(marker[key])
          for key in ('authority_manifest_sha256', 'repository_content_tree_sha256'):
              assert sha64.fullmatch(marker[key])
          assert marker['authority_manifest_git_blob_sha1'] == '901daa49e5bb9c03b7ce523d6b56f6e1392a4314'
          assert marker['authority_manifest_sha256'] == '3b077ff0574719ced950deb357f44935685a9e93123deb9ec29d33c20e4ab7a9'
          assert marker['repository_content_tree_sha256'] == '975c76ef7b2743a2b1502eabe240adf5375e43e5641eee388e925354de9d8c37'
          assert marker['authority_file_count'] == 2967
          assert marker['authority_immutable_file_count'] == 2958
          assert marker['corpus_binding'] == {
              'subject_count': 19,
              'dispositioned_subject_count': 13,
              'open_subject_count': 6,
              'active_batch': 'CONTENT-DISPOSITION-BATCH-003',
              'terminal_subject': 'SUBJECT-2581811b342e505d',
              'active_subject': 'SUBJECT-172dd9bc2738fa43',
              'batch_state': 'FIRST_SUBJECT_TERMINAL_NEXT_SUBJECT_READY',
          }
          assert marker['projected_next_effect'] == (
              'EXTRACT_ARCHIVE_CONTENT_THEN_DISPOSITION_CLAIMS_'
              'BATCH_003_SUBJECT_172DD9BC2738FA43'
          )
          assert marker['next_deterministic_effect_after_sync'] == (
              'REOBSERVE_AND_PERSIST_RECIPROCAL_EQUALITY_RECEIPT_FOR_'
              'BATCH003_FIRST_SUBJECT_DISPOSITION'
          )
          assert marker['completion_claims'] == {
              'candidate_created': False,
              'mirror_promoted': False,
              'reciprocal_equality_refreshed': False,
              'first_subject_disposition_synchronized': False,
              'batch_003_terminal': False,
              'zenodo_mutation_authorized': False,
              'pass': False,
              'final_pass': False,
              'effect_ack_done': False,
          }

          values = {
              'AUTHORITY_URL': 'https://github.com/' + marker['authority_repository'] + '.git',
              'AUTHORITY_MAIN': marker['authority_main'],
              'AUTHORITY_PR': str(marker['authority_pull_request']),
              'MIRROR_PARENT': marker['mirror_parent'],
              'EXECUTION_BRANCH': marker['execution_branch'],
              'TARGET_BRANCH': marker['target_branch'],
              'EXPECTED_MANIFEST_BLOB': marker['authority_manifest_git_blob_sha1'],
              'EXPECTED_MANIFEST_SHA256': marker['authority_manifest_sha256'],
              'EXPECTED_CONTENT_DIGEST': marker['repository_content_tree_sha256'],
              'EXPECTED_FILE_COUNT': str(marker['authority_file_count']),
              'EXPECTED_IMMUTABLE_FILE_COUNT': str(marker['authority_immutable_file_count']),
              'OPERATION': marker['operation'],
              'NEXT_EFFECT': marker['projected_next_effect'],
          }
          with pathlib.Path(os.environ['GITHUB_ENV']).open('a', encoding='utf-8', newline='\n') as handle:
              for key, value in values.items():
                  assert '\n' not in value and '\r' not in value
                  handle.write(f'{key}={value}\n')
          PY

      - name: Verify leases and exact Authority integrity
        shell: bash
        run: |
          set -euo pipefail
          test "$TRIGGER_REF_NAME" = "$EXECUTION_BRANCH"
          test "$(git ls-remote origin refs/heads/$EXECUTION_BRANCH | cut -f1)" = "$TRIGGER_SHA"
          test "$(git ls-remote origin refs/heads/main | cut -f1)" = "$MIRROR_PARENT"
          test "$(git ls-remote origin refs/heads/$TARGET_BRANCH | cut -f1)" = "$MIRROR_PARENT"
          test "$(git ls-remote "$AUTHORITY_URL" refs/heads/main | cut -f1)" = "$AUTHORITY_MAIN"
          git fetch --no-tags "$AUTHORITY_URL" "refs/heads/main:refs/remotes/authority/main"
          test "$(git rev-parse refs/remotes/authority/main)" = "$AUTHORITY_MAIN"
          test "$(git rev-parse "$AUTHORITY_MAIN:REPOSITORY_FILE_MANIFEST.json")" = "$EXPECTED_MANIFEST_BLOB"
          python3 - <<'PY'
          import hashlib
          import json
          import os
          import subprocess

          raw = subprocess.check_output(
              ['git', 'show', os.environ['AUTHORITY_MAIN'] + ':REPOSITORY_FILE_MANIFEST.json']
          )
          manifest = json.loads(raw)
          assert hashlib.sha256(raw).hexdigest() == os.environ['EXPECTED_MANIFEST_SHA256']
          assert manifest['repository_content_tree_sha256'] == os.environ['EXPECTED_CONTENT_DIGEST']
          assert manifest['file_count'] == int(os.environ['EXPECTED_FILE_COUNT'])
          assert manifest['immutable_file_count'] == int(os.environ['EXPECTED_IMMUTABLE_FILE_COUNT'])
          detached = subprocess.check_output(
              ['git', 'show', os.environ['AUTHORITY_MAIN'] + ':REPOSITORY_FILE_MANIFEST.json.sha256'],
              text=True,
          ).strip()
          assert detached == os.environ['EXPECTED_MANIFEST_SHA256'] + '  REPOSITORY_FILE_MANIFEST.json'
          PY

      - name: Create exact unreferenced one-parent candidate
        id: candidate
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import base64
          import json
          import os
          import pathlib
          import subprocess
          import urllib.error
          import urllib.request

          repo = os.environ['GITHUB_REPOSITORY']
          token = os.environ['GH_TOKEN']
          authority = os.environ['AUTHORITY_MAIN']
          parent = os.environ['MIRROR_PARENT']
          api = 'https://api.github.com/repos/' + repo

          def git_bytes(*args: str) -> bytes:
              return subprocess.check_output(['git', *args])

          def git_text(*args: str) -> str:
              return subprocess.check_output(['git', *args], text=True).strip()

          def post(path: str, payload: dict) -> dict:
              request = urllib.request.Request(
                  api + path,
                  data=json.dumps(payload, separators=(',', ':')).encode('utf-8'),
                  method='POST',
                  headers={
                      'Accept': 'application/vnd.github+json',
                      'Authorization': 'Bearer ' + token,
                      'X-GitHub-Api-Version': '2022-11-28',
                      'User-Agent': 'qikvrt-history-preserving-mirror-sync/4',
                      'Content-Type': 'application/json',
                  },
              )
              try:
                  with urllib.request.urlopen(request, timeout=120) as response:
                      value = json.loads(response.read().decode('utf-8'))
              except urllib.error.HTTPError as exc:
                  body = exc.read().decode('utf-8', 'replace')
                  raise RuntimeError(f'GitHub API {path} failed: {exc.code}: {body}') from exc
              if not isinstance(value, dict):
                  raise RuntimeError(f'GitHub API {path} returned a non-object')
              return value

          authority_tree = git_text('rev-parse', authority + '^{tree}')
          parent_tree = git_text('rev-parse', parent + '^{tree}')
          raw = git_bytes('diff', '--name-status', '-z', '--no-renames', parent, authority)
          fields = raw.split(b'\0')
          if fields and fields[-1] == b'':
              fields.pop()
          if len(fields) % 2:
              raise RuntimeError('unexpected git diff --name-status -z shape')

          entries = []
          changed_paths = []
          for index in range(0, len(fields), 2):
              status = fields[index].decode('ascii')
              path = fields[index + 1].decode('utf-8', 'surrogateescape')
              changed_paths.append(path)
              if status == 'D':
                  entries.append({'path': path, 'mode': '100644', 'type': 'blob', 'sha': None})
                  continue
              tree_line = git_text('ls-tree', authority, '--', path)
              if not tree_line:
                  raise RuntimeError('Authority tree entry missing: ' + path)
              metadata, observed_path = tree_line.split('\t', 1)
              mode, object_type, object_sha = metadata.split(' ', 2)
              if observed_path != path or object_type not in {'blob', 'commit'}:
                  raise RuntimeError('unexpected Authority tree entry: ' + tree_line)
              if object_type == 'blob':
                  content = git_bytes('cat-file', 'blob', object_sha)
                  created = post('/git/blobs', {
                      'content': base64.b64encode(content).decode('ascii'),
                      'encoding': 'base64',
                  })
                  if created.get('sha') != object_sha:
                      raise RuntimeError('content-addressed blob identity drift: ' + path)
              entries.append({
                  'path': path,
                  'mode': mode,
                  'type': object_type,
                  'sha': object_sha,
              })

          if not entries:
              raise RuntimeError('Authority and Mirror parent unexpectedly have identical trees')
          tree = post('/git/trees', {'base_tree': parent_tree, 'tree': entries})
          if tree.get('sha') != authority_tree:
              raise RuntimeError(
                  'constructed tree is not exact Authority tree: '
                  + str(tree.get('sha')) + ' != ' + authority_tree
              )

          message = f'''Synchronize Batch-003 first-subject disposition from Authority {authority[:8]}

Authority repository: Goldkelch/qik-vrt
Authority main: {authority}
Authority PR: {os.environ['AUTHORITY_PR']}
Authority tree: {authority_tree}
Mirror parent: {parent}
Repository manifest SHA-256: {os.environ['EXPECTED_MANIFEST_SHA256']}
Repository content-tree SHA-256: {os.environ['EXPECTED_CONTENT_DIGEST']}
Operation: {os.environ['OPERATION']}
Next content effect: {os.environ['NEXT_EFFECT']}
Preserved corpus: 19 subjects, 13 dispositioned, 6 open
Terminal subject: SUBJECT-2581811b342e505d
Active subject: SUBJECT-172dd9bc2738fa43

The sole parent is the frozen Mirror main and the complete Git tree is the exact Authority tree. This candidate does not complete Batch 003, process the remaining six corpus subjects, authorize Zenodo mutation, publish a proof corpus, establish Mirror promotion or reciprocal equality, or claim repository-wide PASS, FINAL_PASS, or EFFECT_ACK_DONE.'''
          commit = post('/git/commits', {
              'message': message,
              'tree': authority_tree,
              'parents': [parent],
          })
          candidate = commit.get('sha')
          commit_tree = (commit.get('tree') or {}).get('sha')
          parents = [item.get('sha') for item in commit.get('parents', []) if isinstance(item, dict)]
          if not isinstance(candidate, str) or len(candidate) != 40:
              raise RuntimeError('candidate SHA missing')
          if commit_tree != authority_tree or parents != [parent]:
              raise RuntimeError('candidate tree or sole-parent binding drift')

          with pathlib.Path(os.environ['GITHUB_OUTPUT']).open('a', encoding='utf-8', newline='\n') as handle:
              handle.write('candidate_sha=' + candidate + '\n')
              handle.write('authority_tree=' + authority_tree + '\n')
              handle.write('changed_file_count=' + str(len(changed_paths)) + '\n')
          with pathlib.Path(os.environ['GITHUB_STEP_SUMMARY']).open('a', encoding='utf-8', newline='\n') as handle:
              handle.write(f'CANDIDATE_HEAD={candidate}\n')
              handle.write(f'AUTHORITY_TREE={authority_tree}\n')
              handle.write(f'MIRROR_PARENT={parent}\n')
              handle.write(f'AUTHORITY_MAIN={authority}\n')
              handle.write(f'CHANGED_FILE_COUNT={len(changed_paths)}\n')
              handle.write('TREE_EQUALITY=true\n')
              handle.write('SOLE_PARENT_BOUND=true\n')
              handle.write('PASS=false FINAL_PASS=false EFFECT_ACK_DONE=false\n')
          print('CANDIDATE_HEAD=' + candidate)
          print('AUTHORITY_TREE=' + authority_tree)
          print('MIRROR_PARENT=' + parent)
          print('CHANGED_FILE_COUNT=' + str(len(changed_paths)))
          print('TREE_EQUALITY=true')
          print('SOLE_PARENT_BOUND=true')
          PY

      - name: Preserve fail-closed boundary
        shell: bash
        run: |
          set -euo pipefail
          test -n "${{ steps.candidate.outputs.candidate_sha }}"
          test -n "${{ steps.candidate.outputs.authority_tree }}"
          echo "Candidate object is content-addressed but intentionally unreferenced pending connector lease recheck."
          echo "PASS=false FINAL_PASS=false EFFECT_ACK_DONE=false"
