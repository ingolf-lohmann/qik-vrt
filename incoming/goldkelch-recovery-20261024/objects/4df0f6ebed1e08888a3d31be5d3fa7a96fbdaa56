asyncapi: 3.0.0
info:
  title: TEMDD Event API
  version: 1.1.0-rc1
  description: >
    Event profile for non-terminal event acknowledgement and terminal
    EFFECT_ACK_DONE notification. EVENT_ACK MUST NOT be interpreted as effect success.
servers:
  production:
    host: events.example.com
    protocol: mqtt
channels:
  transactionEvents:
    address: temdd/v1/transactions/{transactionId}/events
    parameters:
      transactionId:
        description: TEMDD transaction identifier
    messages:
      EventAck:
        $ref: "#/components/messages/EventAck"
      EffectAckDone:
        $ref: "#/components/messages/EffectAckDone"
operations:
  receiveEventAck:
    action: receive
    channel:
      $ref: "#/channels/transactionEvents"
    messages:
      - $ref: "#/channels/transactionEvents/messages/EventAck"
  receiveEffectAckDone:
    action: receive
    channel:
      $ref: "#/channels/transactionEvents"
    messages:
      - $ref: "#/channels/transactionEvents/messages/EffectAckDone"
components:
  messages:
    EventAck:
      name: EVENT_ACK
      title: Non-terminal event acknowledgement
      payload:
        type: object
        additionalProperties: false
        required: [temddVersion, transactionId, eventId, acknowledgedAt]
        properties:
          temddVersion: { const: "1.1" }
          transactionId: { type: string }
          eventId: { type: string }
          acknowledgedAt: { type: string, format: date-time }
          transportStatus: { type: string }
    EffectAckDone:
      name: EFFECT_ACK_DONE
      title: Terminal accepted effect notification
      payload:
        type: object
        additionalProperties: false
        required: [temddVersion, transactionId, state, certificateId, certificateHash, issuedAt]
        properties:
          temddVersion: { const: "1.1" }
          transactionId: { type: string }
          state: { const: EFFECT_ACK_DONE }
          certificateId: { type: string }
          certificateHash:
            type: string
            pattern: "^sha256:[0-9a-f]{64}$"
          issuedAt: { type: string, format: date-time }
x-temdd-invariant: "EVENT_ACK != EFFECT_ACK_DONE"
