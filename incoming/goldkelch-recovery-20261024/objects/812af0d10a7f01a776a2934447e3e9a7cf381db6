name: QIK-VRT trusted trigger quantum runtime article Mirror sync 3a186cb5

on:
  pull_request:
    branches:
      - main
    types:
      - opened
      - reopened
    paths:
      - .github/workflows/qikvrt_trigger_quantum_runtime_article_sync_3a186cb5_once.yml

permissions:
  contents: write

concurrency:
  group: qikvrt-quantum-runtime-article-mirror-sync-3a186cb5
  cancel-in-progress: false

jobs:
  construct-exact-authority-tree:
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    env:
      GH_TOKEN: ${{ github.token }}
      AUTHORITY_REPOSITORY: Goldkelch/qik-vrt
      EXPECTED_AUTHORITY_MAIN: 3a186cb54077e959f9072b78bd24eb85a61b5c3d
      EXPECTED_MIRROR_BEFORE: dc217c8cb19bc113401a1f91dae27bf1733b5b5e
      TARGET_BRANCH: sync/quantum-runtime-article-zenodo-3a186cb5-v1
      FIXED_GIT_DATE: '2026-07-28T08:45:00Z'
    steps:
      - name: Check out current Mirror object graph
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false

      - name: Construct, verify and persist exact Authority tree with Mirror history
        shell: bash
        run: |
          set -euo pipefail
          [ "$GITHUB_REPOSITORY" = 'ingolf-lohmann/qik-vrt' ]
          [ "${{ github.event.pull_request.base.sha }}" = "$EXPECTED_MIRROR_BEFORE" ]
          [ "$(git rev-parse HEAD)" = "$EXPECTED_MIRROR_BEFORE" ]
          [ "$(git ls-remote origin refs/heads/main | cut -f1)" = "$EXPECTED_MIRROR_BEFORE" ]
          [ "$(git ls-remote origin refs/heads/$TARGET_BRANCH | cut -f1)" = "$EXPECTED_MIRROR_BEFORE" ]

          git remote remove authority 2>/dev/null || true
          git remote add authority "https://github.com/${AUTHORITY_REPOSITORY}.git"
          observed_authority="$(git ls-remote authority refs/heads/main | cut -f1)"
          [ "$observed_authority" = "$EXPECTED_AUTHORITY_MAIN" ]
          git fetch --no-tags authority "$EXPECTED_AUTHORITY_MAIN"

          authority_tree="$(git rev-parse "$EXPECTED_AUTHORITY_MAIN^{tree}")"
          message="Synchronize quantum-classical runtime article, kernel proof and Zenodo receipt from Authority 3a186cb5

Authority repository: $AUTHORITY_REPOSITORY
Authority commit: $EXPECTED_AUTHORITY_MAIN
Authority tree: $authority_tree
Previous Mirror main: $EXPECTED_MIRROR_BEFORE
Zenodo DOI: 10.5281/zenodo.21640173
Concept DOI: 10.5281/zenodo.21640172
Semantics: preserve Mirror history as sole parent while replacing the complete content tree with the exact verified Authority tree.
QRT-018 real QPU integration remains IMPLEMENTATION_OPEN.
No PASS, FINAL_PASS or EFFECT_ACK_DONE is claimed by this synchronization commit."

          sync_commit="$(printf '%s\n' "$message" | env \
            GIT_AUTHOR_NAME='QIK-VRT Repository Mesh' \
            GIT_AUTHOR_EMAIL='ingolf.lohmann@live.com' \
            GIT_AUTHOR_DATE="$FIXED_GIT_DATE" \
            GIT_COMMITTER_NAME='QIK-VRT Repository Mesh' \
            GIT_COMMITTER_EMAIL='ingolf.lohmann@live.com' \
            GIT_COMMITTER_DATE="$FIXED_GIT_DATE" \
            git commit-tree "$authority_tree" -p "$EXPECTED_MIRROR_BEFORE")"

          [ "$(git rev-parse "$sync_commit^{tree}")" = "$authority_tree" ]
          [ "$(git show -s --format=%P "$sync_commit")" = "$EXPECTED_MIRROR_BEFORE" ]
          git diff --exit-code "$EXPECTED_AUTHORITY_MAIN" "$sync_commit" --

          verify_root="$RUNNER_TEMP/qikvrt-mirror-sync-verify"
          git worktree add --detach "$verify_root" "$sync_commit"
          PYTHONDONTWRITEBYTECODE=1 python3 -B "$verify_root/tools/qikvrt_integrity.py" verify
          python3 -B "$verify_root/tests/test_quantum_classical_runtime_article.py"

          push_url="https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git"
          git push "$push_url" \
            --force-with-lease="refs/heads/$TARGET_BRANCH:$EXPECTED_MIRROR_BEFORE" \
            "$sync_commit:refs/heads/$TARGET_BRANCH"
          persisted="$(git ls-remote "$push_url" refs/heads/$TARGET_BRANCH | cut -f1)"
          [ "$persisted" = "$sync_commit" ]
          [ "$(git rev-parse "$persisted^{tree}")" = "$authority_tree" ]

          {
            echo '## Exact Authority-tree synchronization candidate'
            echo
            echo "- Authority commit: \`$EXPECTED_AUTHORITY_MAIN\`"
            echo "- Authority tree: \`$authority_tree\`"
            echo "- Previous Mirror main: \`$EXPECTED_MIRROR_BEFORE\`"
            echo "- Mirror candidate: \`$sync_commit\`"
            echo '- Complete file delta Authority↔candidate: empty'
            echo '- Repository integrity: verified'
            echo '- Article/Zenodo receipt contract: verified'
            echo '- QRT-018: IMPLEMENTATION_OPEN'
          } >> "$GITHUB_STEP_SUMMARY"
