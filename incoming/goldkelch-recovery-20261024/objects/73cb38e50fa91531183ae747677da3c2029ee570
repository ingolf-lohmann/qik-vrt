name: QIK-VRT history-preserving Mirror synchronizer v2

on:
  push:
    branches:
      - 'execution/history-preserving-mirror-sync-*'
    paths:
      - work-units/HISTORY_PRESERVING_MIRROR_SYNC_REQUEST.json

permissions:
  contents: write

concurrency:
  group: qikvrt-history-preserving-mirror-sync-v2
  cancel-in-progress: false

jobs:
  construct-and-persist:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      MARKER_PATH: work-units/HISTORY_PRESERVING_MIRROR_SYNC_REQUEST.json
    steps:
      - name: Check out immutable trigger event
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0

      - name: Validate request and export frozen transaction
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          python3 - <<'PY'
          import json, os, pathlib, re

          marker = json.loads(pathlib.Path(os.environ['MARKER_PATH']).read_text(encoding='utf-8'))
          sha40 = re.compile(r'^[0-9a-f]{40}$')
          sha64 = re.compile(r'^[0-9a-f]{64}$')
          branch = re.compile(r'^[A-Za-z0-9._/-]+$')

          assert marker['schema'] == 'qikvrt_history_preserving_mirror_candidate_request_v2'
          assert marker['state'] == 'READY'
          assert marker['authority_repository'] == 'Goldkelch/qik-vrt'
          assert marker['mirror_repository'] == 'ingolf-lohmann/qik-vrt'
          assert marker['execution_branch'] == os.environ['GITHUB_REF_NAME']
          assert marker['execution_branch'].startswith('execution/history-preserving-mirror-sync-')
          assert marker['target_branch'].startswith('sync/')
          assert branch.fullmatch(marker['execution_branch'])
          assert branch.fullmatch(marker['target_branch'])
          assert '..' not in marker['execution_branch']
          assert '..' not in marker['target_branch']
          for key in ('authority_main', 'mirror_parent', 'authority_manifest_git_blob_sha1'):
              assert sha40.fullmatch(marker[key])
          for key in (
              'authority_manifest_sha256',
              'repository_content_tree_sha256',
          ):
              assert sha64.fullmatch(marker[key])
          assert isinstance(marker['authority_file_count'], int)
          assert marker['authority_file_count'] > 0
          assert isinstance(marker['authority_immutable_file_count'], int)
          assert marker['authority_immutable_file_count'] > 0
          assert marker['authority_immutable_file_count'] <= marker['authority_file_count']
          assert marker['completion_claims'] == {
              'candidate_created': False,
              'mirror_promoted': False,
              'reciprocal_equality_refreshed': False,
              'batch_003_executed': False,
              'zenodo_mutation_authorized': False,
              'pass': False,
              'final_pass': False,
              'effect_ack_done': False,
          }
          assert marker['next_deterministic_effect_after_sync'] == (
              'REOBSERVE_AND_PERSIST_RECIPROCAL_EQUALITY_RECEIPT_FOR_POST_ACCEPTANCE_STATUS'
          )

          values = {
              'AUTHORITY_URL': 'https://github.com/' + marker['authority_repository'] + '.git',
              'AUTHORITY_MAIN': marker['authority_main'],
              'MIRROR_PARENT': marker['mirror_parent'],
              'EXECUTION_BRANCH': marker['execution_branch'],
              'TARGET_BRANCH': marker['target_branch'],
              'EXPECTED_MANIFEST_BLOB': marker['authority_manifest_git_blob_sha1'],
              'EXPECTED_MANIFEST_SHA256': marker['authority_manifest_sha256'],
              'EXPECTED_CONTENT_DIGEST': marker['repository_content_tree_sha256'],
              'EXPECTED_FILE_COUNT': str(marker['authority_file_count']),
              'EXPECTED_IMMUTABLE_FILE_COUNT': str(marker['authority_immutable_file_count']),
              'OPERATION': marker['operation'],
              'NEXT_EFFECT': marker['projected_next_effect'],
          }
          github_env = pathlib.Path(os.environ['GITHUB_ENV'])
          with github_env.open('a', encoding='utf-8', newline='\n') as handle:
              for key, value in values.items():
                  assert '\n' not in value and '\r' not in value
                  handle.write(f'{key}={value}\n')
          PY

      - name: Verify remote leases
        shell: bash
        run: |
          set -euo pipefail
          test "$GITHUB_REF_NAME" = "$EXECUTION_BRANCH"
          test "$(git ls-remote origin refs/heads/main | cut -f1)" = "$MIRROR_PARENT"
          test "$(git ls-remote origin refs/heads/$TARGET_BRANCH | cut -f1)" = "$MIRROR_PARENT"
          test "$(git ls-remote "$AUTHORITY_URL" refs/heads/main | cut -f1)" = "$AUTHORITY_MAIN"

      - name: Fetch and verify exact Authority tree
        shell: bash
        run: |
          set -euo pipefail
          git fetch --no-tags "$AUTHORITY_URL" "refs/heads/main:refs/remotes/authority/main"
          test "$(git rev-parse refs/remotes/authority/main)" = "$AUTHORITY_MAIN"
          test "$(git rev-parse "$AUTHORITY_MAIN:REPOSITORY_FILE_MANIFEST.json")" = "$EXPECTED_MANIFEST_BLOB"
          python3 - <<'PY'
          import hashlib, json, os, subprocess

          raw = subprocess.check_output(
              ['git', 'show', os.environ['AUTHORITY_MAIN'] + ':REPOSITORY_FILE_MANIFEST.json']
          )
          manifest = json.loads(raw)
          assert hashlib.sha256(raw).hexdigest() == os.environ['EXPECTED_MANIFEST_SHA256']
          assert manifest['repository_content_tree_sha256'] == os.environ['EXPECTED_CONTENT_DIGEST']
          assert manifest['file_count'] == int(os.environ['EXPECTED_FILE_COUNT'])
          assert manifest['immutable_file_count'] == int(os.environ['EXPECTED_IMMUTABLE_FILE_COUNT'])
          detached = subprocess.check_output(
              ['git', 'show', os.environ['AUTHORITY_MAIN'] + ':REPOSITORY_FILE_MANIFEST.json.sha256'],
              text=True,
          ).strip()
          assert detached == os.environ['EXPECTED_MANIFEST_SHA256'] + '  REPOSITORY_FILE_MANIFEST.json'
          PY

      - name: Construct exact candidate and publish under lease
        shell: bash
        run: |
          set -euo pipefail
          authority_tree="$(git rev-parse "$AUTHORITY_MAIN^{tree}")"
          git config user.name 'QIK-VRT Mirror Synchronizer'
          git config user.email 'ingolf.lohmann@live.com'
          candidate="$(cat <<EOF | git commit-tree "$authority_tree" -p "$MIRROR_PARENT"
          Synchronize repository state from Authority $AUTHORITY_MAIN

          Authority repository: Goldkelch/qik-vrt
          Authority main: $AUTHORITY_MAIN
          Mirror parent: $MIRROR_PARENT
          Authority tree: $authority_tree
          Repository manifest SHA-256: $EXPECTED_MANIFEST_SHA256
          Repository content-tree SHA-256: $EXPECTED_CONTENT_DIGEST
          Operation: $OPERATION
          Next content effect: $NEXT_EFFECT

          The sole parent is the frozen Mirror main and the complete Git tree is the exact Authority tree. This candidate does not execute the projected next content effect, authorize Zenodo mutation, complete the corpus, publish a proof corpus, or claim repository-wide PASS, FINAL_PASS, or EFFECT_ACK_DONE.
          EOF
          )"
          test "$(git rev-parse "$candidate^")" = "$MIRROR_PARENT"
          test "$(git rev-parse "$candidate^{tree}")" = "$authority_tree"
          git diff --quiet "$AUTHORITY_MAIN^{tree}" "$candidate^{tree}"
          git push origin \
            --force-with-lease="refs/heads/$TARGET_BRANCH:$MIRROR_PARENT" \
            "$candidate:refs/heads/$TARGET_BRANCH"
          persisted="$(git ls-remote origin refs/heads/$TARGET_BRANCH | cut -f1)"
          test "$persisted" = "$candidate"
          {
            echo "CANDIDATE_HEAD=$candidate"
            echo "AUTHORITY_TREE=$authority_tree"
            echo "MIRROR_PARENT=$MIRROR_PARENT"
            echo "AUTHORITY_MAIN=$AUTHORITY_MAIN"
            echo "REPOSITORY_MANIFEST_SHA256=$EXPECTED_MANIFEST_SHA256"
            echo "REPOSITORY_CONTENT_TREE_SHA256=$EXPECTED_CONTENT_DIGEST"
            echo "PROJECTED_NEXT_EFFECT=$NEXT_EFFECT"
            echo "PASS=false FINAL_PASS=false EFFECT_ACK_DONE=false"
          } | tee -a "$GITHUB_STEP_SUMMARY"
