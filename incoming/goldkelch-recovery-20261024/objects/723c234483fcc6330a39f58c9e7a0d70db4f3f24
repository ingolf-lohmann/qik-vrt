{
  "$id": "https://temdd.org/schema/temdd-effect-certificate-v1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEMDD 1.1 Effect Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "temddVersion",
    "certificateId",
    "transactionId",
    "subjectId",
    "result",
    "policyId",
    "policyDigest",
    "transactionDigest",
    "evidenceSetDigest",
    "acceptanceScopeDigest",
    "evaluationContextDigest",
    "issuedAt",
    "canonicalization",
    "hashAlgorithm",
    "signerId",
    "keyId",
    "certificateHash",
    "signature"
  ],
  "properties": {
    "temddVersion": {
      "const": "1.1"
    },
    "certificateId": {
      "type": "string",
      "minLength": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "const": "EFFECT_ACK_DONE"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transactionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acceptanceScopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluationContextDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalization": {
      "const": "RFC8785-JCS"
    },
    "hashAlgorithm": {
      "const": "SHA-256"
    },
    "signerId": {
      "type": "string",
      "minLength": 1
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "certificateHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
