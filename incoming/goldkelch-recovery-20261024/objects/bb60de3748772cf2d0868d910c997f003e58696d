# User service. Initialize the store explicitly before starting this unit.
[Unit]
Description=QIK-VRT persistent transputer and TEMDD service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=%h/.local/bin/qikvrt-next serve %h/.local/state/qikvrt/store 127.0.0.1:8771
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
