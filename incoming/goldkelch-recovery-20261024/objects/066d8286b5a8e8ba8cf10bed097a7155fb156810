{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-ir-v1.schema.json",
  "title": "TEMDD canonical program IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ir_version",
    "language_version",
    "authority",
    "subject",
    "request",
    "handlers",
    "dod",
    "semantic_contract"
  ],
  "properties": {
    "schema": {
      "const": "temdd_ir_v1"
    },
    "ir_version": {
      "const": "1"
    },
    "language_version": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "binding"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "const": "exact"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handlers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "statements"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "statements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dod": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantic_contract": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "enum": [
          "T13_CAUSAL_BINDING",
          "T14_EVIDENCE_NON_TRANSFER",
          "T15_EFFECT_CONSTRUCTION",
          "T16_CONFORMANCE_BINDING"
        ]
      }
    }
  }
}
