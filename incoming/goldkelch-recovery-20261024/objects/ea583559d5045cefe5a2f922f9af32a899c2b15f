name: QIKVRT Lean v2 Mesh recovery M68000 compiler

on:
  pull_request:
    paths:
      - "src/m68000/qikvrt_lean_v2_mesh_recovery.s"
      - "runtime/m68000/qikvrt_lean_v2_mesh_recovery.hex"
      - "runtime/m68000/QIKVRT_COMPILED_KERNELS_V1.json"
      - "tools/qikvrt_lean_v2_m68000_mesh_recovery_compiler.py"
      - "tests/test_qikvrt_lean_v2_m68000_mesh_recovery_compiler.py"
      - ".github/workflows/qikvrt_lean_v2_m68000_mesh_recovery.yml"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  prove-compile-verify:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.12"
      - name: Kernel-check frozen v2 formal source
        uses: leanprover/lean-action@38fbc41a8c28c4cbaec22d7f7de508ec2e7c0dd9
        with:
          lake-package-directory: formalization/QIKVRT_Formalization_v2.0
          test: false
      - name: Compile and exhaustively verify recovery projection
        run: |
          set -euo pipefail
          python3 tools/qikvrt_lean_v2_m68000_mesh_recovery_compiler.py | tee qikvrt-lean-v2-mesh-recovery-m68000-report.json
          python3 -m unittest tests.test_qikvrt_lean_v2_m68000_mesh_recovery_compiler -v
      - name: Bind frozen proof source without release mutation
        run: |
          set -euo pipefail
          target=formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Hardware/AuthorityMirrorWitness.lean
          for theorem in \
            T06_crash_before_witness_recovers_predecessor \
            T07_crash_after_witness_recovers_successor \
            T16_safe_witnessless_recovery_is_fail_closed
          do
            grep -q "$theorem" "$target"
          done
          git fetch --no-tags --depth=1 origin "${{ github.event.pull_request.base.sha }}"
          if git diff --name-only "${{ github.event.pull_request.base.sha }}" HEAD -- \
              formalization/QIKVRT_Formalization_v2.0 | grep -q .; then
            echo 'BLOCK: frozen formalization-v2 source drifted'
            exit 1
          fi
      - name: Publish compiler report
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: qikvrt-lean-v2-mesh-recovery-m68000-${{ github.sha }}
          path: qikvrt-lean-v2-mesh-recovery-m68000-report.json
          retention-days: 30
          if-no-files-found: error
