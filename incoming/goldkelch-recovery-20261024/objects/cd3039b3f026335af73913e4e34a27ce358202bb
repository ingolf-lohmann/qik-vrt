name: QIKVRT requested-review stale work-unit reaper

on:
  push:
    branches: [main]
  pull_request_target:
    types: [synchronize, closed, reopened, edited]
  workflow_dispatch:

permissions:
  actions: write
  contents: read
  pull-requests: read

concurrency:
  group: qikvrt-requested-review-stale-work-unit-reaper-${{ github.repository }}
  cancel-in-progress: false

jobs:
  reap:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    env:
      GH_TOKEN: ${{ github.token }}
      REPOSITORY: ${{ github.repository }}
    steps:
      - name: Check out exact trusted main classifier
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: main
          fetch-depth: 1
          persist-credentials: false

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.12"

      - name: Reap only stale recursive workflow-dispatch children
        shell: bash
        run: |
          set -euo pipefail
          root=.qikvrt/requested-review-stale-work-unit-reaper
          mkdir -p "$root"
          python3 -B - <<'PY'
          import json, os, pathlib, subprocess
          from tools.qikvrt_requested_review_stale_work_unit_reaper import classify_run

          repo=os.environ['REPOSITORY']
          root=pathlib.Path('.qikvrt/requested-review-stale-work-unit-reaper')

          def api(method,path):
              command=['gh','api','--method',method,path]
              completed=subprocess.run(command,text=True,capture_output=True,check=False)
              if completed.returncode:
                  raise SystemExit(
                      f'GITHUB_API_{method}_FAILED {path}: {completed.stderr.strip()[:300]}'
                  )
              return json.loads(completed.stdout) if completed.stdout.strip() else {}

          main=api('GET',f'repos/{repo}/git/ref/heads/main')['object']['sha']
          runs=api(
              'GET',
              f'repos/{repo}/actions/workflows/qikvrt_requested_review_executor.yml/'
              'runs?event=workflow_dispatch&per_page=100',
          ).get('workflow_runs',[])
          observations=[]
          for run in runs:
              if run.get('status') not in {'pending','queued','requested','waiting'}:
                  continue
              title=str(run.get('display_title') or '')
              parts=title.split()
              pr_token=next((item for item in parts if item.startswith('pr=')),None)
              if pr_token is None or not pr_token[3:].isdigit():
                  observations.append({
                      'run_id':run.get('id'),
                      'state':'HOLD_UNVERIFIED',
                      'first_blocker':'RECURSIVE_WORK_UNIT_TITLE_UNBOUND',
                      'cancelled':False,
                  })
                  continue
              number=int(pr_token[3:])
              pr=api('GET',f'repos/{repo}/pulls/{number}')
              decision=classify_run(run,pr,main)
              observation={
                  'run_id':int(run['id']),
                  'pr_number':number,
                  'queued_status':run.get('status'),
                  'current_main_sha':main,
                  'live_head_sha':(pr.get('head') or {}).get('sha'),
                  'live_base_sha':(pr.get('base') or {}).get('sha'),
                  **decision,
                  'cancelled':False,
                  'post_cancel_status':None,
              }
              if decision['cancel']:
                  completed=subprocess.run([
                      'gh','api','--method','POST',
                      f"repos/{repo}/actions/runs/{run['id']}/cancel",
                  ],text=True,capture_output=True,check=False)
                  reread=api('GET',f"repos/{repo}/actions/runs/{run['id']}")
                  observation['post_cancel_status']=reread.get('status')
                  observation['cancelled']=(
                      reread.get('status') not in {'pending','queued','requested','waiting'}
                      or completed.returncode == 0
                  )
                  if not observation['cancelled']:
                      raise SystemExit(
                          'STALE_RECURSIVE_TRANSPORT_CANCEL_NOT_OBSERVED_'
                          + str(run['id'])
                      )
              observations.append(observation)

          value={
              'schema':'qikvrt_requested_review_stale_work_unit_reaper_v1',
              'current_main_sha':main,
              'observations':observations,
              'cancelled_run_ids':[
                  item['run_id'] for item in observations if item.get('cancelled')
              ],
              'completion_claims':{
                  'PASS':False,'FINAL_PASS':False,
                  'EFFECT_ACK_DONE':False,'MERGE':False,
              },
          }
          (root/'receipt.json').write_text(
              json.dumps(value,sort_keys=True,indent=2)+'\n',encoding='utf-8'
          )
          print(json.dumps(value,sort_keys=True))
          PY

      - name: Preserve reaper receipt
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: qikvrt-requested-review-stale-work-unit-reaper-${{ github.run_id }}
          if-no-files-found: warn
          retention-days: 90
          path: .qikvrt/requested-review-stale-work-unit-reaper
