name: QIKVRT Lean v2 D3 M68000 compiler

on:
  pull_request:
    paths:
      - "src/m68000/qikvrt_lean_v2_d3_step.s"
      - "runtime/m68000/qikvrt_lean_v2_d3_step.hex"
      - "tools/qikvrt_lean_v2_m68000_d3_compiler.py"
      - "tests/test_qikvrt_lean_v2_m68000_d3_compiler.py"
      - ".github/workflows/qikvrt_lean_v2_m68000_d3.yml"
      - "distribution/qikvrt-megast/**"
      - "src/cloud_transputer/**"
      - "deploy/universal-terminal/**"
      - "browser/firefox/qikvrt-terminal/**"
      - "runtime/toolchains/**"
  push:
    branches: [main]
    paths:
      - "src/m68000/qikvrt_lean_v2_d3_step.s"
      - "runtime/m68000/qikvrt_lean_v2_d3_step.hex"
      - "tools/qikvrt_lean_v2_m68000_d3_compiler.py"
      - "tests/test_qikvrt_lean_v2_m68000_d3_compiler.py"
      - ".github/workflows/qikvrt_lean_v2_m68000_d3.yml"
      - "distribution/qikvrt-megast/**"
      - "src/cloud_transputer/**"
      - "deploy/universal-terminal/**"
      - "browser/firefox/qikvrt-terminal/**"
      - "runtime/toolchains/**"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  prove-compile-verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EVIDENCE_DIR: /tmp/qikvrt-lean-v2-${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.12"
      - name: Bind exact checkout and verify declared runtime
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_HEAD"
          git diff --exit-code HEAD --
          python3 -B tools/qikvrt_tool_cache.py verify
          mkdir -p "$EVIDENCE_DIR"
      - name: Assert frozen v2 release source is not in PR diff
        if: github.event_name == 'pull_request'
        run: |
          set -euo pipefail
          test -n "$EXPECTED_BASE"
          git fetch --no-tags --depth=1 origin "$EXPECTED_BASE"
          git diff --exit-code "$EXPECTED_BASE" HEAD -- \
            formalization/QIKVRT_Formalization_v2.0
      - name: Provision the pinned Lean runtime
        uses: leanprover/lean-action@38fbc41a8c28c4cbaec22d7f7de508ec2e7c0dd9
        with:
          lake-package-directory: formalization/QIKVRT_Formalization_v2.0
          build: false
          test: false
          lint: false
      - name: Kernel-check frozen v2 formal source freshly
        working-directory: formalization/QIKVRT_Formalization_v2.0
        run: |
          set -euo pipefail
          test "$(cat lean-toolchain)" = 'leanprover/lean4:v4.19.0'
          lake --version | tee "$EVIDENCE_DIR/lake-version.log"
          lake env lean --version | tee "$EVIDENCE_DIR/lean-version.log"
          lake env lean --githash | tee "$EVIDENCE_DIR/lean-githash.log"
          # Reuse provisioned dependencies, never a predecessor's project proof.
          lake clean
          lake build 2>&1 | tee "$EVIDENCE_DIR/lake-build.log"
          lake build QIKVRTFormalization.Hardware.D3FixedPoint 2>&1 \
            | tee -a "$EVIDENCE_DIR/lake-build.log"
      - name: Audit axioms, proof escapes and canonical proof coverage
        working-directory: formalization/QIKVRT_Formalization_v2.0
        run: |
          set -euo pipefail
          (
            set -e
            python3 scripts/audit_lean_axioms.py
            python3 scripts/audit_completion_axioms.py
            python3 scripts/audit_proof_escapes.py
            python3 scripts/materialize_completion.py --check
            python3 scripts/render_completion_proof_map.py --check
            python3 scripts/render_completion_verification_report.py --check
            python3 scripts/validate_completion_claim_graph.py
            python3 scripts/validate_effect_ack_claims.py
          ) 2>&1 | tee "$EVIDENCE_DIR/proof-audits.log"
          cat > "$EVIDENCE_DIR/d3-axioms.lean" <<'LEAN'
          import QIKVRTFormalization.Hardware.D3FixedPoint
          #print axioms QIKVRT.V2.D3FixedPoint.d3_projection_fixed_under_step
          #print axioms QIKVRT.V2.D3FixedPoint.d3_projection_fixed_under_any_finite_trace
          #print axioms QIKVRT.V2.D3FixedPoint.one_ied_cycle_returns_phase_and_preserves_d3
          LEAN
          lake env lean "$EVIDENCE_DIR/d3-axioms.lean" 2>&1 \
            | tee "$EVIDENCE_DIR/d3-axioms.log"
      - name: Compile and exhaustively verify finite machine projection
        run: |
          set -euo pipefail
          python3 tools/qikvrt_lean_v2_m68000_d3_compiler.py \
            | tee "$EVIDENCE_DIR/compiler-report.json"
          python3 -m unittest tests.test_qikvrt_lean_v2_m68000_d3_compiler -v
      - name: Reject proof-hole syntax in frozen source the compiler relies on
        run: |
          set -euo pipefail
          for target in \
            formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Hardware/D3FixedPoint.lean \
            formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Hardware/AuthorityMirrorWitness.lean
          do
            if grep -nE '^[[:space:]]*(axiom|sorry|admit)([[:space:]]|$)' "$target"; then
              echo "BLOCK: proof-hole syntax in $target"
              exit 1
            fi
          done
      - name: Seal exact-subject kernel receipt after successful gates
        run: |
          set -euo pipefail
          python3 -B - <<'PY'
          # BEGIN_EXACT_SUBJECT_KERNEL_RECEIPT
          import hashlib, json, os, re, subprocess
          from pathlib import Path

          expected = os.environ['EXPECTED_HEAD']
          if re.fullmatch(r'[0-9a-f]{40}', expected) is None:
              raise SystemExit('invalid expected HEAD')
          head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
          tree = subprocess.check_output(['git', 'rev-parse', 'HEAD^{tree}'], text=True).strip()
          if head != expected or re.fullmatch(r'[0-9a-f]{40}', tree) is None:
              raise SystemExit('exact subject changed')
          subprocess.run(['git', 'diff', '--exit-code', 'HEAD', '--'], check=True)
          root = Path.cwd()
          evidence = Path(os.environ['EVIDENCE_DIR'])
          formal = 'formalization/QIKVRT_Formalization_v2.0'
          if (root / formal / 'lean-toolchain').read_text().strip() != 'leanprover/lean4:v4.19.0':
              raise SystemExit('toolchain lock differs')
          version = (evidence / 'lean-version.log').read_text().strip()
          if re.match(r'Lean \(version 4\.19\.0(?:,|\))', version) is None:
              raise SystemExit('executed Lean version differs')
          lean_commit = (evidence / 'lean-githash.log').read_text().strip()
          if re.fullmatch(r'[0-9a-f]{40}', lean_commit) is None:
              raise SystemExit('Lean compiler identity missing')
          theorems = [
              'd3_projection_fixed_under_step',
              'd3_projection_fixed_under_any_finite_trace',
              'one_ied_cycle_returns_phase_and_preserves_d3',
          ]
          names = ['QIKVRT.V2.D3FixedPoint.' + name for name in theorems]
          expected_audit = ["'" + name + "' does not depend on any axioms" for name in names]
          observed_audit = [line.strip() for line in (evidence / 'd3-axioms.log').read_text().splitlines() if line.strip()]
          if observed_audit != expected_audit:
              raise SystemExit('D3 axiom audit differs or is incomplete')
          report = json.loads((evidence / 'compiler-report.json').read_text())
          if (report.get('valid_state_tuples_verified') != 3072 or
                  report.get('invalid_phase_values_fail_closed') != 253 or
                  report.get('d3_preserved') is not True or
                  report.get('physical_m68000_execution_observed') is not False):
              raise SystemExit('finite compiler verification differs')

          def identity(path, label):
              raw = path.read_bytes()
              return {'path': label, 'bytes': len(raw),
                      'sha256': hashlib.sha256(raw).hexdigest(),
                      'git_blob_sha1': hashlib.sha1(b'blob ' + str(len(raw)).encode() + b'\0' + raw).hexdigest()}

          workflow = '.github/workflows/qikvrt_lean_v2_m68000_d3.yml'
          paths = subprocess.check_output(['git', 'ls-files', '-z', '--', formal, workflow,
              'tools/qikvrt_lean_v2_m68000_d3_compiler.py',
              'tests/test_qikvrt_lean_v2_m68000_d3_compiler.py']).decode().split('\0')
          sources = [identity(root / path, path) for path in sorted(set(paths) - {''})]
          if not sources:
              raise SystemExit('source inventory missing')
          logs = ['lake-version.log', 'lean-version.log', 'lean-githash.log',
                  'lake-build.log', 'proof-audits.log', 'd3-axioms.lean',
                  'd3-axioms.log', 'compiler-report.json']
          outputs = [identity(evidence / name, name) for name in logs]
          for key in ('GITHUB_REPOSITORY', 'GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'GITHUB_EVENT_NAME'):
              if not os.environ.get(key):
                  raise SystemExit('native run binding missing: ' + key)
          receipt = {
              'schema': 'qikvrt_lean_v2_exact_subject_kernel_receipt_v1',
              'state': 'KERNEL_EXECUTION_RECORDED',
              'repository': os.environ['GITHUB_REPOSITORY'],
              'source_sha': head, 'source_tree': tree,
              'workflow': identity(root / workflow, workflow),
              'event': os.environ['GITHUB_EVENT_NAME'],
              'run_id': os.environ['GITHUB_RUN_ID'],
              'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],
              'lean_version': version, 'lean_githash': lean_commit,
              'd3_axioms_by_theorem': {name: [] for name in names},
              'source_inventory': sources, 'outputs': outputs,
              'compiler_report': report,
              'predecessor_evidence_transfer': False,
              'independent_code_owner_approval': False,
              'physical_atari_boot': False, 'effect_ack_done': False,
              'scope': 'Fresh Lean v2 kernel, canonical proof audits and finite M68000 projection; not deployment or physical verification',
          }
          target = evidence / 'kernel-receipt.json'
          with target.open('x', encoding='utf-8') as stream:
              json.dump(receipt, stream, sort_keys=True, indent=2)
              stream.write('\n')
          print('EXACT_SUBJECT_KERNEL_RECEIPT head=' + head + ' tree=' + tree)
          # END_EXACT_SUBJECT_KERNEL_RECEIPT
          PY
      - name: Preserve compiler report and inspectable kernel evidence
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: qikvrt-lean-v2-d3-m68000-${{ github.event.pull_request.head.sha || github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ env.EVIDENCE_DIR }}/
          retention-days: 30
          if-no-files-found: error
