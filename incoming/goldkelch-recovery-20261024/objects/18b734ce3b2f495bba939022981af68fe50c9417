name: QIK-VRT one-shot PR356 PR204 reciprocal equality receipt v4
on:
  pull_request:
    branches:
      - main
    types:
      - opened
      - reopened
      - synchronize
    paths:
      - .github/workflows/qikvrt_materialize_pr356_pr204_receipt_once.yml
permissions:
  contents: write
concurrency:
  group: qikvrt-pr356-pr204-receipt-v4-${{ github.repository }}
  cancel-in-progress: false
jobs:
  materialize:
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository &&
      github.actor != 'github-actions[bot]'
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    env:
      SOURCE_REPOSITORY: Goldkelch/qik-vrt
      SOURCE_COMMIT: 342d4a2a6b5b0bf09fe542ef3b143125b3d471c9
      SOURCE_WORKFLOW_BLOB: 3ce95cad6b2664ff20473d7a7c6bbed4552dab03
      WORKFLOW_PATH: .github/workflows/qikvrt_materialize_pr356_pr204_receipt_once.yml
      SOURCE_EXECUTOR_SHA256: f6b0e82e52aa2b147dd3f253b09153c07513e49317c013c29a5a6d13030dcc36
      PATCHED_EXECUTOR_SHA256: ae98de38006f92724a40628f2aba259adac1c4427605b3522d0fc5c35aa71d51
    steps:
      - name: Check out the exact proxy event head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
      - name: Recover, patch and execute the exact reciprocal-receipt program
        shell: bash
        run: |
          set -euo pipefail
          git remote add receipt-source "https://github.com/$SOURCE_REPOSITORY.git"
          git fetch --no-tags receipt-source "$SOURCE_COMMIT"
          test "$(git rev-parse "$SOURCE_COMMIT:$WORKFLOW_PATH")" = "$SOURCE_WORKFLOW_BLOB"
          git show "$SOURCE_COMMIT:$WORKFLOW_PATH" > "$RUNNER_TEMP/source-workflow.yml"
          python3 - "$RUNNER_TEMP/source-workflow.yml" "$RUNNER_TEMP/qikvrt_pr356_pr204_receipt_executor.py" <<'PY'
          import base64
          import hashlib
          import os
          from pathlib import Path
          import sys
          import zlib

          source = Path(sys.argv[1]).read_text(encoding="utf-8")
          start_marker = '          encoded = """\n'
          end_marker = '\n          """.replace("\\n", "")'
          start = source.index(start_marker) + len(start_marker)
          end = source.index(end_marker, start)
          encoded = "".join(line.strip() for line in source[start:end].splitlines())
          raw = zlib.decompress(base64.b64decode(encoded))
          observed = hashlib.sha256(raw).hexdigest()
          if observed != os.environ["SOURCE_EXECUTOR_SHA256"]:
              raise SystemExit(f"BLOCK: source executor digest differs: {observed}")

          text = raw.decode("utf-8")
          replacements = (
              (
                  '"trusted/pr356-pr204-receipt-executor-authority-v1"',
                  '"trusted/pr356-pr204-receipt-executor-authority-v4"',
              ),
              (
                  '"trusted/pr356-pr204-receipt-executor-mirror-v1"',
                  '"trusted/pr356-pr204-receipt-executor-mirror-v4"',
              ),
              ('authority_paths = git(\n    "diff", "--name-only", "--no-renames", AUTHORITY_BASE, AUTHORITY_HEAD, "--"\n).splitlines()\nmirror_paths = git(\n    "diff", "--name-only", "--no-renames", MIRROR_PREDECESSOR, MIRROR_HEAD, "--"\n).splitlines()\nif len(authority_paths) != 76 or authority_paths != mirror_paths:\n    raise SystemExit("BLOCK: scoped 76-path boundary differs")\n', 'authority_paths = git(\n    "diff", "--name-only", "--no-renames", AUTHORITY_BASE, AUTHORITY_HEAD, "--"\n).splitlines()\nmirror_paths = git(\n    "diff", "--name-only", "--no-renames", MIRROR_PREDECESSOR, MIRROR_HEAD, "--"\n).splitlines()\nmirror_predecessor_carried_paths = {\n    "docs/publications/2026-08-03-virtual-past-reception/CLAIM_MATRIX.json",\n    "docs/publications/2026-08-03-virtual-past-reception/CORRECTION_NOTICE.md",\n    "docs/publications/2026-08-03-virtual-past-reception/EVIDENCE_BOUNDARY.md",\n    "docs/publications/2026-08-03-virtual-past-reception/NOTE_DE.md",\n    "docs/publications/2026-08-03-virtual-past-reception/README.md",\n    "external/ietf/draft-lohmann-qikvrt-effect-ack-03.PUBLICATION_RECEIPT.json",\n    "tests/test_ietf_revision_03.py",\n    "tests/test_qikvrt_self_disclosure.py",\n    "tests/test_virtual_past_reception.py",\n    "work-units/QIKVRT_VIRTUAL_PAST_RECEPTION_INTEGRATION_V1.json",\n}\nif len(authority_paths) != 76:\n    raise SystemExit("BLOCK: Authority scoped path count differs")\nif len(mirror_paths) != 66:\n    raise SystemExit("BLOCK: Mirror successor delta path count differs")\nif set(authority_paths) != set(mirror_paths) | mirror_predecessor_carried_paths:\n    raise SystemExit("BLOCK: Authority/Mirror scoped path partition differs")\nif set(mirror_paths) & mirror_predecessor_carried_paths:\n    raise SystemExit("BLOCK: Mirror successor rewrites predecessor-carried scope")\nfor path in sorted(mirror_predecessor_carried_paths):\n    predecessor_blob = git("rev-parse", f"{MIRROR_PREDECESSOR}:{path}")\n    promoted_blob = git("rev-parse", f"{MIRROR_MAIN}:{path}")\n    if predecessor_blob != promoted_blob:\n        raise SystemExit(\n            f"BLOCK: Mirror predecessor-carried path changed in successor: {path}"\n        )\n'),
              ('binding_equality = {\n    "authority_candidate_tree": authority_tree,\n    "mirror_candidate_tree": mirror_tree,\n    "portable_path_count": len(portable_paths),\n', 'binding_equality = {\n    "authority_candidate_tree": authority_tree,\n    "mirror_candidate_tree": mirror_tree,\n    "authority_scoped_path_count": len(authority_paths),\n    "mirror_successor_delta_path_count": len(mirror_paths),\n    "mirror_predecessor_carried_path_count": len(\n        mirror_predecessor_carried_paths\n    ),\n    "mirror_predecessor_carried_paths": sorted(\n        mirror_predecessor_carried_paths\n    ),\n    "portable_path_count": len(portable_paths),\n'),
          )
          for old, new in replacements:
              count = text.count(old)
              if count != 1:
                  raise SystemExit(
                      f"BLOCK: executor patch anchor count is {count}, expected 1"
                  )
              text = text.replace(old, new, 1)

          patched = text.encode("utf-8")
          observed = hashlib.sha256(patched).hexdigest()
          if observed != os.environ["PATCHED_EXECUTOR_SHA256"]:
              raise SystemExit(f"BLOCK: patched executor digest differs: {observed}")
          Path(sys.argv[2]).write_bytes(patched)
          PY
          python3 "$RUNNER_TEMP/qikvrt_pr356_pr204_receipt_executor.py"
