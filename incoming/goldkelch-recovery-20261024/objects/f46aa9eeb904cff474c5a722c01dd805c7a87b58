      "source_refs",
      "observed_at_utc",
      "coverage",
      "censored_count",
      "measurement_method"
    ],
    "status_enum": [
      "MEASURED",
      "UNKNOWN",
      "INCOMPLETE",
      "INVALID",
      "NOT_APPLICABLE",
      "NO_FAILURE_OBSERVED",
      "NO_EXPOSURE"
    ],
    "null_is_not_zero": true,
    "zero_denominator": "value=null with explicit status and raw counts",
    "zero_failures": "MTBF=null, NO_FAILURE_OBSERVED, preserve exposure",
    "percentiles": "Nearest-rank on sorted complete samples, k=ceil(p*n), with sample count and open/censored cases; empty samples=null",
    "missing_evidence": "UNKNOWN; cannot produce PASS"
  },
  "population_rules": [
    "Fix workload, obligations, deadlines, node roster and observation window before comparison",
    "Rejected work and cancellations remain in the original due-obligation denominator unless the owner withdraws the obligation explicitly; disclose every exclusion",
    "Count unique effects, not attempts, commits or heartbeats",
    "Do not pool different workloads or policy versions; stratify before comparing",
    "Do not infer causal edges from this diagnostic hierarchy"
  ],
  "aggregation_rules": [
    "Mesh availability and MTBF require directly observed Mesh service predicate",
    "Never average node MTBFs or latency percentiles",
    "Pool compatible raw event populations for percentiles; sum eligible numerators/denominators only for disjoint compatible populations",
    "Use union durations for overlapping outages at the same service scope",
    "Retain node breakdowns, weakest scope, unknown coverage and incident bounds"
  ],
  "decision_policy": {
    "order": [
      "Validate identity, coverage, workload comparability and clocks",
      "Enforce correctness, losslessness, authorization and required gates",
      "Restore breached end-to-end service obligations; prioritize user-visible incident impact and age",
      "Compare feasible candidates by service-SLO vector, including availability, overdue rate and latency",
      "Prefer Pareto improvements; unresolved tradeoffs require explicit versioned owner-approved budgets"
    ],
    "weighted_average": "FORBIDDEN_WITHOUT_EXPLICIT_VERSIONED_WEIGHTS; cannot compensate a hard-gate violation",
    "unknown_target": "SLO verdict UNKNOWN until target is specified; descriptive measurements remain usable",
    "mtbf_role": "Reliability branch indicator, no longer sole optimization objective",
    "error_budget": "Only after service SLO and eligibility window are declared; unavailable/unknown intervals may not be hidden",
    "automatic_mutation_authority": false
  },
  "implementation": {
    "reuse": "Existing repository stall/watchdog and durable ledger path",
    "instrumentation_verified": false,
    "node_rollout_verified": false,
    "activation_requires": [
      "Executable measurement and schema validation",
      "Boundary and adversarial tests",
      "Integrity materialization",
      "Fresh exact-head gates",
      "Independent adoption and telemetry receipts for every declared node"
    ]
  },
  "acceptance_cases": [
    "Zero exposure and zero failures remain distinct",
    "Open and left/right-censored incidents remain visible",
    "Repeated retries cannot reset stalls or inflate throughput",
    "Unknown/404/incomplete pagination never mean idle or available",
    "Reject duplicate IDs, invalid timestamps and contradictory event sequences",
    "Keep historical incident continuity across HEAD mutation without candidate evidence transfer",
    "No aggregation across incompatible scopes or double-counted outages",
    "No percentile-of-percentiles aggregation",
    "Cancelled or rejected obligations cannot silently disappear",
    "Poor coverage or missing nodes cannot improve a score",
    "A safety-gate violation cannot be offset by higher throughput",
    "Killing observer and pipeline independently produces distinguishable durable evidence"
  ],
  "PREDECESSOR_EVIDENCE_TRANSFER": false
}
