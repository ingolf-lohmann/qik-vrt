name: QIKVRT ruleset effect dispatch bridge

on:
  workflow_run:
    workflows:
      - "QIKVRT required code-owner review"
      - "QIKVRT requested review executor"
    types: [completed]

permissions:
  actions: write
  contents: read
  pull-requests: read
  statuses: read

concurrency:
  group: qikvrt-ruleset-effect-dispatch-bridge-${{ github.repository }}
  cancel-in-progress: false

jobs:
  dispatch-exact-subject:
    if: >-
      github.ref == 'refs/heads/main' &&
      (github.event.workflow_run.conclusion == 'success' ||
       (github.event.workflow_run.name == 'QIKVRT requested review executor' &&
        github.event.workflow_run.conclusion == 'failure'))
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    env:
      GH_TOKEN: ${{ secrets.QIKVRT_RULESET_ADMIN_TOKEN }}
      REPOSITORY: ${{ github.repository }}
      UPSTREAM_RUN_ID: ${{ github.event.workflow_run.id }}
      REVIEW_STATUS_CONTEXT: QIKVRT required code-owner review
    steps:
      - name: Check out trusted Main bridge implementation
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: main
          fetch-depth: 1
          persist-credentials: false

      - name: Bind one exact deduplicated ruleset subject
        id: bind
        shell: bash
        run: |
          set -euo pipefail
          test -n "${GH_TOKEN:-}"
          root="$RUNNER_TEMP/qikvrt-ruleset-effect-dispatch"
          rm -rf "$root"
          mkdir -p "$root/artifact"

          checkout="$(git rev-parse --verify HEAD^{commit})"
          live_main="$(gh api "repos/${REPOSITORY}/commits/main" --jq .sha)"
          test "$checkout" = "$live_main"

          run="$(gh api "repos/${REPOSITORY}/actions/runs/${UPSTREAM_RUN_ID}")"
          upstream_name="$(jq -r .name <<<"$run")"
          upstream_path="$(jq -r .path <<<"$run")"
          upstream_conclusion="$(jq -r .conclusion <<<"$run")"
          test "$(jq -r .repository.full_name <<<"$run")" = "$REPOSITORY"

          case "$upstream_name" in
            "QIKVRT required code-owner review")
              test "$upstream_path" = ".github/workflows/qikvrt_required_review_gate.yml"
              test "$upstream_conclusion" = success
              test "$(jq -r .head_branch <<<"$run")" = main
              test "$(jq -r .head_sha <<<"$run")" = "$live_main"
              expected="qikvrt-required-code-owner-selection-${UPSTREAM_RUN_ID}-CANDIDATE"
              selection_name=qikvrt-required-review-selection.json
              selection_schema=qikvrt_required_code_owner_review_selection_v1
              selection_kind=required-review
              ;;
            "QIKVRT requested review executor")
              test "$upstream_path" = ".github/workflows/qikvrt_requested_review_executor.yml"
              case "$upstream_conclusion" in success|failure) ;; *) exit 1 ;; esac
              expected="qikvrt-mesh-review-selection-${UPSTREAM_RUN_ID}-CANDIDATE"
              selection_name=qikvrt-review-selection.json
              selection_schema=qikvrt_requested_review_selection_v1
              selection_kind=requested-review
              ;;
            *)
              exit 1
              ;;
          esac

          artifacts="$(gh api "repos/${REPOSITORY}/actions/runs/${UPSTREAM_RUN_ID}/artifacts?per_page=100")"
          count="$(jq --arg name "$expected" '[.artifacts[] | select(.name == $name and (.expired != true))] | length' <<<"$artifacts")"
          if [ "$count" != 1 ]; then
            echo "state=NOOP" >> "$GITHUB_OUTPUT"
            echo "blocker=UPSTREAM_CANDIDATE_ARTIFACT_MISSING_OR_AMBIGUOUS" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          archive_url="$(jq -r --arg name "$expected" '.artifacts[] | select(.name == $name and (.expired != true)) | .archive_download_url' <<<"$artifacts")"
          gh api "$archive_url" > "$root/evidence.zip"
          unzip -q "$root/evidence.zip" -d "$root/artifact"
          mapfile -t files < <(find "$root/artifact" -type f -name "$selection_name" -print)
          test "${#files[@]}" -eq 1
          cp "${files[0]}" "$root/selection.json"

          test "$(jq -r .schema "$root/selection.json")" = "$selection_schema"
          test "$(jq -r .state "$root/selection.json")" = CANDIDATE
          if [ "$selection_kind" = required-review ]; then
            test "$(jq '.pr_numbers | length' "$root/selection.json")" = 1
            pr="$(jq -r '.pr_numbers[0]' "$root/selection.json")"
          else
            pr="$(jq -r '.candidate_pr_number // .pr_number' "$root/selection.json")"
            test "$(jq -r .selection_basis "$root/selection.json")" = EXACT_EVENT_OR_DISPATCH
            test "$(jq -r .review_execution "$root/selection.json")" = true
          fi
          head="$(jq -r .expected_head "$root/selection.json")"
          [[ "$pr" =~ ^[1-9][0-9]*$ ]]
          [[ "$head" =~ ^[0-9a-f]{40}$ ]]

          pull="$(gh api "repos/${REPOSITORY}/pulls/${pr}")"
          test "$(jq -r .state <<<"$pull")" = open
          test "$(jq -r .base.ref <<<"$pull")" = main
          test "$(jq -r .head.repo.full_name <<<"$pull")" = "$REPOSITORY"
          test "$(jq -r .head.sha <<<"$pull")" = "$head"
          head_ref="$(jq -r .head.ref <<<"$pull")"
          test "$(gh api "repos/${REPOSITORY}/git/ref/heads/${head_ref}" --jq .object.sha)" = "$head"

          statuses="$(gh api --paginate --slurp "repos/${REPOSITORY}/commits/${head}/statuses?per_page=100")"
          exact_count="$(jq --arg context "$REVIEW_STATUS_CONTEXT" '[.[][] | select(.context == $context and .state == "failure" and .description == "failure: CODE_OWNER_RULE_NOT_ENFORCED")] | length' <<<"$statuses")"
          if [ "$exact_count" -lt 1 ]; then
            echo "state=NOOP" >> "$GITHUB_OUTPUT"
            echo "blocker=EXACT_RULESET_BLOCKER_STATUS_MISSING" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          test "$(gh api "repos/${REPOSITORY}/commits/main" --jq .sha)" = "$live_main"
          test "$(gh api "repos/${REPOSITORY}/pulls/${pr}" --jq .head.sha)" = "$head"
          test "$(gh api "repos/${REPOSITORY}/git/ref/heads/${head_ref}" --jq .object.sha)" = "$head"

          echo "state=CANDIDATE" >> "$GITHUB_OUTPUT"
          echo "pr=$pr" >> "$GITHUB_OUTPUT"
          echo "head=$head" >> "$GITHUB_OUTPUT"
          echo "main=$live_main" >> "$GITHUB_OUTPUT"

      - name: Dispatch existing single ruleset effect writer
        if: steps.bind.outputs.state == 'CANDIDATE'
        env:
          PR_NUMBER: ${{ steps.bind.outputs.pr }}
          EXPECTED_HEAD: ${{ steps.bind.outputs.head }}
          EXPECTED_MAIN: ${{ steps.bind.outputs.main }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(gh api "repos/${REPOSITORY}/commits/main" --jq .sha)" = "$EXPECTED_MAIN"
          test "$(gh api "repos/${REPOSITORY}/pulls/${PR_NUMBER}" --jq .head.sha)" = "$EXPECTED_HEAD"
          jq -n --arg pr "$PR_NUMBER" --arg head "$EXPECTED_HEAD" \
            '{ref:"main",inputs:{pr:$pr,expected_head:$head}}' \
            | gh api --method POST \
                "repos/${REPOSITORY}/actions/workflows/qikvrt_autonomous_ruleset_effect_loop.yml/dispatches" \
                --input -
