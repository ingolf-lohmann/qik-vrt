{
  "$id": "https://temdd.org/schema/temdd-verification-policy-v1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEMDD 1.1 Verification Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "temddVersion",
    "policyId",
    "version",
    "freshness",
    "trust",
    "binding",
    "quorum",
    "canonicalizationProfile",
    "hashAlgorithm",
    "securityProfile"
  ],
  "properties": {
    "temddVersion": {
      "const": "1.1"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAgeSeconds",
        "requireAfterExecution",
        "maxClockSkewSeconds"
      ],
      "properties": {
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "requireAfterExecution": {
          "type": "boolean"
        },
        "maxClockSkewSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumEvidenceClass",
        "requireSignature",
        "allowedAlgorithms",
        "trustedSources"
      ],
      "properties": {
        "minimumEvidenceClass": {
          "type": "string",
          "enum": [
            "E1",
            "E2",
            "E3"
          ]
        },
        "requireSignature": {
          "type": "boolean"
        },
        "allowedAlgorithms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ed25519",
              "ecdsa",
              "rsa-pss"
            ]
          }
        },
        "trustedSources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireSubjectMatch",
        "requireTransactionMatch",
        "requireExecutionMatch",
        "requireNonceBinding"
      ],
      "properties": {
        "requireSubjectMatch": {
          "type": "boolean"
        },
        "requireTransactionMatch": {
          "type": "boolean"
        },
        "requireExecutionMatch": {
          "type": "boolean"
        },
        "requireNonceBinding": {
          "type": "boolean"
        }
      }
    },
    "quorum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "members",
        "k",
        "requireDistinctSources"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "NONE",
            "SINGLE",
            "K_OF_N",
            "MAJORITY",
            "TWO_THIRDS",
            "ALL"
          ]
        },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "requireDistinctSources": {
          "type": "boolean"
        }
      }
    },
    "canonicalizationProfile": {
      "const": "RFC8785-JCS"
    },
    "hashAlgorithm": {
      "const": "SHA-256"
    },
    "securityProfile": {
      "type": "string",
      "enum": [
        "CORE",
        "ENHANCED",
        "HIGH_ASSURANCE",
        "CRITICAL_SYSTEMS"
      ]
    },
    "acceptanceEvaluatorIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
