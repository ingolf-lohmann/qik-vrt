name: One-shot PR295 isolated reflexive watchdog Mirror materializer

on:
  pull_request:
    types: [opened, reopened, synchronize]
    paths:
      - ".github/workflows/_materialize_authority_pr582_reflexive_watchdog_port_v2.yml"

permissions:
  contents: write

concurrency:
  group: qikvrt-mirror-pr295-isolated-reflexive-watchdog-materializer
  cancel-in-progress: false

jobs:
  materialize:
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository &&
      (github.event.pull_request.head.ref == 'repair/pr295-isolated-materializer-v1' ||
       github.event.pull_request.head.ref == 'trusted/execute-pr295-isolated-materializer-v1')
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    env:
      EXPECTED_MIRROR_BASE: b559841ea03d3103435125f8d0ac095ff8e2346e
      EXPECTED_MIRROR_BASE_TREE: afe752c514718c7a09e37ea6687b08365a787d65
      AUTHORITY_COMMIT: 8c4845af39b33895ae40c0861b257488f9875a0b
      AUTHORITY_TREE: 05c6af302cf89e946b5378f1dc3a1930e10c17ef
      EXPECTED_MATERIALIZED_TREE: 85eed663d9299c065e352308260aca78fe968b34
      TARGET_BRANCH: successor/pr295-reflexive-watchdog-85eed663-v1
      CARRIER_PATH: .github/workflows/_materialize_authority_pr582_reflexive_watchdog_port_v2.yml
      EVENT_HEAD: ${{ github.event.pull_request.head.sha }}
    steps:
      - name: Check out literal carrier or trusted proxy head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          persist-credentials: true

      - name: Materialize exact portable Authority bytes on an isolated target ref
        id: materialize
        shell: bash
        run: |
          set -euo pipefail

          receipt_dir="$RUNNER_TEMP/qikvrt-mirror-pr295-isolated-materializer"
          mkdir -p "$receipt_dir"
          printf '%s\n' "$EVENT_HEAD" > "$receipt_dir/carrier-or-proxy-head.txt"
          printf '%s\n' "$EXPECTED_MIRROR_BASE" > "$receipt_dir/mirror-base.txt"
          printf '%s\n' "$EXPECTED_MIRROR_BASE_TREE" > "$receipt_dir/mirror-base-tree.txt"
          printf '%s\n' "$AUTHORITY_COMMIT" > "$receipt_dir/authority-commit.txt"
          printf '%s\n' "$AUTHORITY_TREE" > "$receipt_dir/authority-tree.txt"
          printf '%s\n' "$EXPECTED_MATERIALIZED_TREE" > "$receipt_dir/expected-materialized-tree.txt"
          printf '%s\n' "$TARGET_BRANCH" > "$receipt_dir/target-branch.txt"
          trap 'status=$?; printf "%s\n" "$status" > "$receipt_dir/materialize-step-status.txt"' EXIT

          test "$(git rev-parse --verify HEAD^{commit})" = "$EVENT_HEAD"
          test "$(git rev-parse --verify HEAD^1)" = "$EXPECTED_MIRROR_BASE"
          test "$(git rev-parse --verify "$EXPECTED_MIRROR_BASE^{tree}")" = "$EXPECTED_MIRROR_BASE_TREE"

          mapfile -t carrier_delta < <(git diff --name-only "$EXPECTED_MIRROR_BASE" HEAD --)
          test "${#carrier_delta[@]}" -eq 1
          test "${carrier_delta[0]}" = "$CARRIER_PATH"

          live_main="$(git ls-remote origin refs/heads/main | awk '{print $1}')"
          printf '%s\n' "$live_main" > "$receipt_dir/live-main-before-materialization.txt"
          test "$live_main" = "$EXPECTED_MIRROR_BASE"

          git fetch --no-tags --depth=1 \
            https://github.com/Goldkelch/qik-vrt.git \
            "$AUTHORITY_COMMIT:refs/remotes/authority/pr582"
          test "$(git rev-parse --verify refs/remotes/authority/pr582^{commit})" = "$AUTHORITY_COMMIT"
          test "$(git rev-parse --verify "$AUTHORITY_COMMIT^{tree}")" = "$AUTHORITY_TREE"

          portable_paths=(
            .github/workflows/qikvrt_reflexive_repository_watchdog.yml
            .github/workflows/qikvrt_workflow_executor_watchdog.yml
            docs/REFLEXIVE_REPOSITORY_WATCHDOG.md
            registry/NODE_DISCOVERY_POLICY.json
            state/autonomy/WORKFLOW_EXECUTOR_MESH_CONTRACT_V1.json
            state/work_units/REFLEXIVE_REPOSITORY_WATCHDOG_V1.json
            tests/test_qikvrt_reflexive_repository_watchdog.py
            tools/qikvrt_reflexive_repository_watchdog.py
          )

          for path in "${portable_paths[@]}"; do
            entry="$(git ls-tree "$AUTHORITY_COMMIT" -- "$path")"
            test -n "$entry"
            read -r mode type blob tree_path <<< "$entry"
            expected_mode=100644
            if test "$path" = tools/qikvrt_reflexive_repository_watchdog.py; then
              expected_mode=100755
            fi
            test "$mode" = "$expected_mode"
            test "$type" = blob
            test "$tree_path" = "$path"
            git checkout "$AUTHORITY_COMMIT" -- "$path"
            test "$(git hash-object "$path")" = "$blob"
          done

          rm -- "$CARRIER_PATH"

          python3 -B tools/qikvrt_integrity.py generate
          python3 -B tools/qikvrt_integrity.py verify

          expected="$RUNNER_TEMP/pr295-isolated-expected.txt"
          actual="$RUNNER_TEMP/pr295-isolated-actual.txt"
          printf '%s\n' \
            .github/workflows/qikvrt_reflexive_repository_watchdog.yml \
            .github/workflows/qikvrt_workflow_executor_watchdog.yml \
            REPOSITORY_FILE_MANIFEST.json \
            REPOSITORY_FILE_MANIFEST.json.sha256 \
            SHA256SUMS.txt \
            docs/REFLEXIVE_REPOSITORY_WATCHDOG.md \
            registry/NODE_DISCOVERY_POLICY.json \
            state/autonomy/WORKFLOW_EXECUTOR_MESH_CONTRACT_V1.json \
            state/work_units/REFLEXIVE_REPOSITORY_WATCHDOG_V1.json \
            tests/test_qikvrt_reflexive_repository_watchdog.py \
            tools/qikvrt_reflexive_repository_watchdog.py | LC_ALL=C sort > "$expected"
          git diff --name-only "$EXPECTED_MIRROR_BASE" -- | LC_ALL=C sort > "$actual"
          diff -u "$expected" "$actual"
          git diff --check "$EXPECTED_MIRROR_BASE" --

          for path in "${portable_paths[@]}"; do
            read -r mode type blob tree_path <<< "$(git ls-tree "$AUTHORITY_COMMIT" -- "$path")"
            expected_mode=100644
            if test "$path" = tools/qikvrt_reflexive_repository_watchdog.py; then
              expected_mode=100755
            fi
            test "$mode" = "$expected_mode"
            test "$type" = blob
            test "$tree_path" = "$path"
            test "$(git hash-object "$path")" = "$blob"
          done

          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B -m unittest -v \
            tests.test_qikvrt_reflexive_repository_watchdog \
            tests.test_qikvrt_workflow_executor_mesh_contract \
            tests.test_seed_workflows
          make test

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git diff --cached --name-only "$EXPECTED_MIRROR_BASE" -- | LC_ALL=C sort > "$actual"
          diff -u "$expected" "$actual"
          git diff --cached --check

          materialized_tree="$(git write-tree)"
          printf '%s\n' "$materialized_tree" > "$receipt_dir/materialized-tree.txt"
          test "$materialized_tree" = "$EXPECTED_MATERIALIZED_TREE"

          commit_date="$(git show -s --format=%aI "$EVENT_HEAD")"
          export GIT_AUTHOR_NAME="github-actions[bot]"
          export GIT_AUTHOR_EMAIL="41898282+github-actions[bot]@users.noreply.github.com"
          export GIT_AUTHOR_DATE="$commit_date"
          export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
          export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
          export GIT_COMMITTER_DATE="$commit_date"
          materialized_commit="$(printf '%s\n\n%s\n' \
            'Port Authority PR #582 reflexive pre-deadlock watchdog' \
            'Direct current-main successor with eight Authority-identical portable paths and Mirror-native integrity; no release, deployment, Zenodo, DOI, or IETF effect.' \
            | git commit-tree "$materialized_tree" -p "$EXPECTED_MIRROR_BASE")"

          test "$(git rev-parse "$materialized_commit^{tree}")" = "$EXPECTED_MATERIALIZED_TREE"
          test "$(git rev-parse "$materialized_commit^1")" = "$EXPECTED_MIRROR_BASE"
          git diff --name-only "$EXPECTED_MIRROR_BASE" "$materialized_commit" -- | LC_ALL=C sort \
            > "$receipt_dir/final-diff-from-base.txt"
          cp "$expected" "$receipt_dir/final-diff-expected.txt"
          diff -u "$receipt_dir/final-diff-expected.txt" "$receipt_dir/final-diff-from-base.txt"
          git diff --check "$EXPECTED_MIRROR_BASE" "$materialized_commit" --

          printf '%s\n' "$materialized_commit" > "$receipt_dir/materialized-commit.txt"
          git diff-tree --no-commit-id --name-status -r "$materialized_commit" \
            > "$receipt_dir/materialized-commit-delta.txt"
          git update-ref refs/qikvrt/pr295-isolated-materialized "$materialized_commit"
          git bundle create "$receipt_dir/materialized-commit.bundle" \
            refs/qikvrt/pr295-isolated-materialized ^"$EXPECTED_MIRROR_BASE"

          existing_target="$(git ls-remote origin "refs/heads/$TARGET_BRANCH" | awk '{print $1}')"
          printf '%s\n' "$existing_target" > "$receipt_dir/existing-target-before-push.txt"
          if test -n "$existing_target"; then
            test "$existing_target" = "$materialized_commit"
            push_status=0
            printf '%s\n' 'IDEMPOTENT_TARGET_ALREADY_EXACT' > "$receipt_dir/push.log"
          else
            set +e
            git push origin "$materialized_commit:refs/heads/$TARGET_BRANCH" \
              > "$receipt_dir/push.log" 2>&1
            push_status=$?
            set -e
          fi
          printf '%s\n' "$push_status" > "$receipt_dir/push-status.txt"
          cat "$receipt_dir/push.log"
          test "$push_status" -eq 0

          remote_target="$(git ls-remote origin "refs/heads/$TARGET_BRANCH" | awk '{print $1}')"
          printf '%s\n' "$remote_target" > "$receipt_dir/remote-target-after-push.txt"
          test "$remote_target" = "$materialized_commit"

          echo "materialized_commit=$materialized_commit" >> "$GITHUB_OUTPUT"
          echo "materialized_tree=$materialized_tree" >> "$GITHUB_OUTPUT"
          echo "target_branch=$TARGET_BRANCH" >> "$GITHUB_OUTPUT"
          echo "QIKVRT_MATERIALIZED_COMMIT=$materialized_commit"
          echo "QIKVRT_MATERIALIZED_TREE=$materialized_tree"
          echo "QIKVRT_TARGET_BRANCH=$TARGET_BRANCH"

      - name: Preserve exact isolated materialization receipt
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: qikvrt-mirror-pr295-isolated-materializer-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: error
          retention-days: 30
          path: ${{ runner.temp }}/qikvrt-mirror-pr295-isolated-materializer
