name: QIKVRT virtual Mesh M68000 acceptance

on:
  pull_request:
    paths:
      - "runtime/m68000/QIKVRT_COMPILED_KERNELS_V1.json"
      - "runtime/m68000/*.hex"
      - "tools/qikvrt_lean_gate_m68000_compiler.py"
      - "tools/qikvrt_lean_v2_m68000_d3_compiler.py"
      - "tools/qikvrt_lean_v2_m68000_mesh_recovery_compiler.py"
      - "tools/qikvrt_virtual_mesh_m68000_acceptance.py"
      - "tests/test_qikvrt_virtual_mesh_m68000_acceptance.py"
      - "Makefile"
      - ".github/workflows/qikvrt_virtual_mesh_m68000_acceptance.yml"
  push:
    branches:
      - main
    paths:
      - "runtime/m68000/QIKVRT_COMPILED_KERNELS_V1.json"
      - "runtime/m68000/*.hex"
      - "tools/qikvrt_lean_gate_m68000_compiler.py"
      - "tools/qikvrt_lean_v2_m68000_d3_compiler.py"
      - "tools/qikvrt_lean_v2_m68000_mesh_recovery_compiler.py"
      - "tools/qikvrt_virtual_mesh_m68000_acceptance.py"
      - "tests/test_qikvrt_virtual_mesh_m68000_acceptance.py"
      - "Makefile"
      - ".github/workflows/qikvrt_virtual_mesh_m68000_acceptance.yml"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  execute-registered-machine-bytes:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: "3.12"
      - name: Execute registered M68000 bytes through the bounded virtual Mesh
        run: |
          set -euo pipefail
          python3 -B tools/qikvrt_virtual_mesh_m68000_acceptance.py \
            --iterations 3 --json \
            | tee qikvrt-virtual-mesh-m68000-acceptance.json
      - name: Verify registry, ABI separation, fail-closed recovery and boundaries
        run: |
          set -euo pipefail
          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
            python3 -B -m unittest -v \
            tests.test_qikvrt_virtual_mesh_m68000_acceptance
      - name: Preserve virtual-execution evidence
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: qikvrt-virtual-mesh-m68000-${{ github.sha }}
          path: qikvrt-virtual-mesh-m68000-acceptance.json
          retention-days: 30
          if-no-files-found: error
