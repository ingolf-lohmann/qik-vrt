name: QIKVRT Firefox proxy delegation bridge

on:
  pull_request:
    paths:
      - 'tools/qikvrt_firefox_proxy_delegate.py'
      - 'tests/test_qikvrt_firefox_proxy_delegate.py'
      - 'policy/FIREFOX_PROXY_DELEGATION_V1.json'
      - 'docs/terminal/FIREFOX_PROXY_DELEGATION_BRIDGE_V1.md'
      - 'browser/firefox/qikvrt-terminal/manifest.json'
      - 'browser/firefox/qikvrt-terminal/review_effect.js'
      - '.github/workflows/qikvrt_firefox_proxy_delegation.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.12'
      - name: Verify review-effect JavaScript syntax
        run: node --check browser/firefox/qikvrt-terminal/review_effect.js
      - name: Verify delegation policy JSON
        run: python3 -m json.tool policy/FIREFOX_PROXY_DELEGATION_V1.json >/dev/null
      - name: Run delegation bridge regression tests
        run: python3 -B -m unittest tests.test_qikvrt_firefox_proxy_delegate -v
      - name: Verify dry-run owner-authenticated target binding
        run: |
          python3 -B tools/qikvrt_firefox_proxy_delegate.py \
            --url https://github.com/settings/personal-access-tokens \
            --expected-owner Goldkelch \
            --repository Goldkelch/qik-vrt \
            --dry-run \
            --json | tee /tmp/delegation.json
          python3 - <<'PY'
          import json
          value = json.load(open('/tmp/delegation.json', encoding='utf-8'))
          assert value['secret_serialized'] is False
          assert value['effect_executed'] is False
          assert value['next_boundary'] == 'HUMAN_AUTHENTICATION_OR_SECRET_ENTRY'
          assert value['post_boundary_requirement'] == 'AUTHORITATIVE_REOBSERVATION'
          PY
