name: QIKVRT PR closure engine

on:
  workflow_dispatch:
  schedule:
    - cron: "*/5 * * * *"
  push:
    branches: [main]
  workflow_run:
    workflows:
      - "QIKVRT CI"
      - "QIKVRT repository evidence materialization"
      - "QIKVRT requested review executor"
      - "QIKVRT required code-owner review"
    types: [completed]
  pull_request:
    paths:
      - ".github/workflows/qikvrt_pr_closure_engine.yml"
      - "tools/qikvrt_pr_closure_engine.py"
      - "tests/test_qikvrt_pr_closure_engine.py"
      - "state/autonomy/AUTONOMOUS_PR_CLOSURE_POLICY_V1.json"
      - "state/authorization/delegations/OWNER_AUTONOMOUS_REPOSITORY_CLOSURE_V1.json"

permissions:
  contents: read

concurrency:
  group: qikvrt-pr-closure-${{ github.repository }}
  cancel-in-progress: false

jobs:
  validate:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - name: Check out exact pull-request head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.12"
      - name: Validate closure policy and decision core
        shell: bash
        run: |
          set -euo pipefail
          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B tools/qikvrt_pr_closure_engine.py validate-policy
          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B -m unittest -v tests.test_qikvrt_pr_closure_engine

  close-open-pr-queue:
    if: github.event_name != 'pull_request'
    permissions:
      actions: read
      checks: read
      contents: write
      issues: write
      pull-requests: write
      statuses: read
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - name: Check out trusted current main
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.12"
      - name: Validate trusted closure engine
        shell: bash
        run: |
          set -euo pipefail
          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B tools/qikvrt_pr_closure_engine.py validate-policy --repository "$GITHUB_REPOSITORY"
          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B -m unittest -v tests.test_qikvrt_pr_closure_engine
      - name: Execute one bounded closure mutation
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -euo pipefail
          PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 python3 -B tools/qikvrt_pr_closure_engine.py run \
            --repository "$GITHUB_REPOSITORY" \
            --apply \
            --output /tmp/qikvrt-pr-closure-receipt.json
      - name: Preserve closure receipt
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: qikvrt-pr-closure-receipt-${{ github.run_id }}-${{ github.run_attempt }}
          path: /tmp/qikvrt-pr-closure-receipt.json
          if-no-files-found: warn
          retention-days: 30
