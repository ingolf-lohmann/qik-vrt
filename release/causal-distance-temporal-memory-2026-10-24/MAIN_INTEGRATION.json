on\\n cf38f611e3bd108f52f59ff2fe85f406c50e9be4d458a65d7df1ff419c3051f2  evidence/benchmarks/browser-assistant-ab/2026-10-05/self-test-run/fixtures/research-costs.json\\n 53a9ebe89988e390a5200add525536dc0729e1619aacd8ea5e8309203e39e69f  evidence/benchmarks/browser-assistant-ab/2026-10-05/self-test-run/manifest.json\\n+52c1819c5923271b500450c14fb0b7f15cb9c183bb8ba263438ddfd828ad8a87  evidence/causal-distance/2026-10-24/ARBEITSDEFINITION.md\\n+3b3302b6a005095e37b1a7d1b6f52485e124fc1cfc593d71885c9a6c34997886  evidence/causal-distance/2026-10-24/PERSISTENCE_RECEIPT.json\\n+b87c955489efcbdfcaff356ac8d9cec2984840ebd74b7fa5a85a066a7d93a843  evidence/causal-distance/2026-10-24/README.md\\n+ac7f0518583e126f2a373089569758d2360cd93e3c73c8b2b575b90f7cc711c2  evidence/causal-distance/2026-10-24/REPRODUCIBLE_PACKAGE.json\\n+930ac935fdaf9e3f86cd20e5152363a8bd3b965e8aa606893595d4f7c0578ee2  evidence/causal-distance/2026-10-24/qikvrt_causal_distance.py\\n 05da17e139c269797364bcc7c2ece1aeab096a6d0e57a0360aa7ca8e07a3cd70  evidence/claims/QIKVRT_TRUTHFULNESS_INVARIANT_V1.json\\n bc825e931271eb85a5e7588af49676866c5f42f58fae167f42a0218c26588811  evidence/claims/QIKVRT_UNIVERSAL_META_INTEGRATION_MESH_PERSISTENCE_V1.json\\n fd0717e9edbfdecc1a22d6d45147672499fbbb51d3d705d65db3d7624f762dde  evidence/claude-mcp-connector/2026-10-09/INDEPENDENT_LIVE_BYTE_CHECK.json\"},{\"sha\":\"145c67014d462217a5fb1179ef9fe09907bd4a4d\",\"filename\":\"evidence/causal-distance/2026-10-24/ARBEITSDEFINITION.md\",\"status\":\"added\",\"additions\":54,\"deletions\":0,\"changes\":54,\"blob_url\":\"https://github.com/ingolf-lohmann/qik-vrt/blob/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FARBEITSDEFINITION.md\",\"raw_url\":\"https://github.com/ingolf-lohmann/qik-vrt/raw/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FARBEITSDEFINITION.md\",\"contents_url\":\"https://api.github.com/repos/ingolf-lohmann/qik-vrt/contents/evidence%2Fcausal-distance%2F2026-10-24%2FARBEITSDEFINITION.md?ref=51f516368ae33d1d788e50b0301929d0252187e5\",\"patch\":\"@@ -0,0 +1,54 @@\\n+# QIKVRT: Arbeitsdefinition zu Kausalität, Zeitbezug und Aktivität\\n+\\n+Datum: 24. Oktober 2026\\n+Status: Begriffliche Arbeitsnotiz; keine neue empirische Bestätigung.\\n+Urheber des hier dokumentierten Architekturgedankens: Ingolf Lohmann.\\n+Redaktionelle Präzisierung und Evidenzabgrenzung: ChatGPT.\\n+\\n+## 1. Festgehaltene Begriffe\\n+\\n+Kausalität bezeichnet Wirkungsabhängigkeiten allgemein. Vorwärtskausalität bezeichnet den Einfluss früherer Bedingungen auf spätere Ereignisse.\\n+\\n+Retrokausalität bezeichnet den Einfluss späterer Bedingungen auf frühere Ereignisse beziehungsweise die ausdrücklich modellierte Abhängigkeit früherer Zustände von späteren Eingangs- oder Randbedingungen. Ein solcher Modellzusammenhang und seine physikalische Verwirklichung sind getrennt nachzuweisen.\\n+\\n+Retrodiktion oder kausale Rekonstruktion bezeichnet den Rückschluss von beobachteten Wirkungen auf mögliche vergangene Ursachen. Die Richtung dieses Schlusses allein etabliert keine rückwärtsgerichtete physische Wirkung.\\n+\\n+Kausale Distanz benötigt neben einer identifizierten Abhängigkeit eine explizite Messregel, einschließlich Ereignisauflösung, Einheit beziehungsweise Gewichtung, Pfadauswahl und Evidenzgrenze.\\n+\\n+## 2. Ingolf Lohmanns Architekturgedanke\\n+\\n+Ingolf Lohmann beschreibt natürliche Kognition als aktive Verknüpfung von Vergangenheit, Gegenwart und möglichen Zukünften, die ohne ausdrückliche Reflexion erfolgen kann. Er fordert, diese zeitübergreifende Verknüpfung künstlich kognitiven Systemen ausdrücklich als Arbeitsverfahren zu vermitteln.\\n+\\n+Er ordnet dem Effect Acknowledgement Protocol in Verbindung mit dem doppelkanonischen QIKVRT-Speicher die technische Aufgabe zu, solche Verknüpfungen dauerhaft und überprüfbar zu tragen. Dies wird hier als seine Architekturthese festgehalten. Konkrete Speicherinvarianten sind aus der bestehenden Spezifikation zu übernehmen; diese Notiz erfindet keine neue Speichersemantik.\\n+\\n+## 3. Funktionale Präzisierung\\n+\\n+Für die Implementierung wird Aktivität funktional betrachtet: Ein System verbindet erhaltene Erfahrung, gegenwärtige Beobachtung und mögliche Folgen mit der Auswahl, zugelassenen Ausführung und unabhängigen Prüfung einer Handlung.\\n+\\n+Gedächtnis, Ursachenrekonstruktion, Vorhersage, Handlungsauswahl, Autorisierung und Wirkungsprüfung sind unterschiedliche Funktionen. Ein Speicher oder Bestätigungsprotokoll allein belegt noch nicht ihre vollständige Integration.\\n+\\n+Die pauschale Gleichsetzung „belebt = aktiv, unbelebt = passiv“ wird als Formulierung des Owners dokumentiert, jedoch nicht als etablierte biologische Definition übernommen. Unbelebte physikalische Systeme sind dynamisch; technische Systeme können selbsttätige Regelkreise ausführen. Umgekehrt besitzt nicht jedes Lebewesen episodisches Gedächtnis oder bewusste Zukunftsplanung.\\n+\\n+## 4. Prüffähiger QIKVRT-Arbeitsanspruch\\n+\\n+Vergangene Evidenz erhalten; mögliche Ursachen unter Bewahrung ihrer Unsicherheit rekonstruieren; bedingte Zukunftsfolgen berechnen; eine zugelassene Handlung ausführen; ihre tatsächliche Wirkung unabhängig zurücklesen; das Ergebnis zur Korrektur der nächsten Handlung verwenden.\\n+\\n+Dieser Anspruch bezeichnet eine technische Aufgabenstellung. Sein Vollzug ist am konkreten System und Ausführungslauf nachzuweisen. Rückwärts gerichtete physische Einflussnahme, biologische Lebendigkeit und eine universelle kausale Distanzmessung sind durch diese Definition nicht festgestellt.\\n+\\n+## 5. Quellen und Geltungsbereiche\\n+\\n+Ingolf Lohmann: Von Softwarearchitektur zur Weltformel – Das Universum als Round Trip, Originalversion 1.0.0-candidate.1; insbesondere Abschnitte 6 und 8 zur Referenzbindung und Trennung von Vorhersage und Messung. Die in dieser Sitzung gelesene PDF ist eine spätere Lesefassung des Originals.\\n+https://doi.org/10.5281/zenodo.21888130\\n+https://zenodo.org/records/21888130\\n+\\n+K. B. Wharton und N. Argaman: Colloquium: Bell’s theorem and locally mediated reformulations of quantum mechanics. Reviews of Modern Physics 92, 021002 (2020). Quelle für explizite Future-Input-Abhängigkeit in retrokausalen Modellen, kein QIKVRT-Wirkungsnachweis.\\n+https://doi.org/10.1103/RevModPhys.92.021002\\n+https://arxiv.org/abs/1906.04313\\n+\\n+Donna Rose Addis, Alana T. Wong und Daniel L. Schacter: Remembering the past and imagining the future: common and distinct neural substrates during event construction and elaboration. Neuropsychologia 45, 1363–1377 (2007). Untersucht menschliches Erinnern und Zukunftsvorstellung; keine Aussage über alle Lebewesen oder physische Retrokausalität.\\n+https://doi.org/10.1016/j.neuropsychologia.2006.10.016\\n+https://pubmed.ncbi.nlm.nih.gov/17126370/\\n+\\n+NASA: How can we tell if something is alive or not? Quelle zur biologischen Definitionsfrage; keine Gleichsetzung von Aktivität und Leben.\\n+https://science.nasa.gov/astrobiology/learning-resources/alp/alive-or-not/\\n+\"},{\"sha\":\"d55cf1ee572ec637d333126404a755fa9ce7534f\",\"filename\":\"evidence/causal-distance/2026-10-24/PERSISTENCE_RECEIPT.json\",\"status\":\"added\",\"additions\":26,\"deletions\":0,\"changes\":26,\"blob_url\":\"https://github.com/ingolf-lohmann/qik-vrt/blob/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FPERSISTENCE_RECEIPT.json\",\"raw_url\":\"https://github.com/ingolf-lohmann/qik-vrt/raw/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FPERSISTENCE_RECEIPT.json\",\"contents_url\":\"https://api.github.com/repos/ingolf-lohmann/qik-vrt/contents/evidence%2Fcausal-distance%2F2026-10-24%2FPERSISTENCE_RECEIPT.json?ref=51f516368ae33d1d788e50b0301929d0252187e5\",\"patch\":\"@@ -0,0 +1,26 @@\\n+{\\n+  \\\"schema\\\": \\\"QIKVRT_CAUSAL_DISTANCE_REPOSITORY_PERSISTENCE_V1\\\",\\n+  \\\"repository\\\": \\\"ingolf-lohmann/qik-vrt\\\",\\n+  \\\"branch\\\": \\\"work/causal-distance-evidence-20261024\\\",\\n+  \\\"source_base\\\": \\\"8273ef8127edccf4b357fdacdd17a1e6b0f3f87f\\\",\\n+  \\\"package\\\": {\\n+    \\\"commit\\\": \\\"3579e34272521375dc2801f215547478b8c5f8eb\\\",\\n+    \\\"path\\\": \\\"evidence/causal-distance/2026-10-24/REPRODUCIBLE_PACKAGE.json\\\",\\n+    \\\"git_blob\\\": \\\"dfcbb7044b91c3adea882fc2f8261b9df6bee209\\\",\\n+    \\\"byte_exact_remote_readback\\\": true,\\n+    \\\"artifact_sha256\\\": \\\"d070ae7e9c15feeadedddf55b3bf77072a3b74289dad60bb3adce4aee7089f91\\\",\\n+    \\\"artifact_size_bytes\\\": 262030\\n+  },\\n+  \\\"metric\\\": {\\n+    \\\"commit\\\": \\\"87eb628ad480ae7c172044514a0305305368e86f\\\",\\n+    \\\"path\\\": \\\"evidence/causal-distance/2026-10-24/qikvrt_causal_distance.py\\\",\\n+    \\\"git_blob\\\": \\\"125ea0fefc03462a10e22d8445b9a7cadf1e5cf5\\\",\\n+    \\\"byte_exact_remote_readback\\\": true\\n+  },\\n+  \\\"scope\\\": \\\"REPOSITORY_PERSISTENCE_OF_REVIEW_CANDIDATE\\\",\\n+  \\\"main_integrated\\\": false,\\n+  \\\"productive_runtime_accepted\\\": false,\\n+  \\\"effect_ack_done\\\": false,\\n+  \\\"human_authorization\\\": \\\"Ingolf Lohmann: QIKVRT Trusted Mesh Repository selbst ist die Stelle, wo das alles zu persistieren ist.\\\",\\n+  \\\"correction\\\": \\\"The prior client file-storage quota is not a blocker for the now verified Authority repository persistence.\\\"\\n+}\"},{\"sha\":\"7e614219fefd077aef000c2f6d27dec0c3836f21\",\"filename\":\"evidence/causal-distance/2026-10-24/README.md\",\"status\":\"added\",\"additions\":46,\"deletions\":0,\"changes\":46,\"blob_url\":\"https://github.com/ingolf-lohmann/qik-vrt/blob/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FREADME.md\",\"raw_url\":\"https://github.com/ingolf-lohmann/qik-vrt/raw/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FREADME.md\",\"contents_url\":\"https://api.github.com/repos/ingolf-lohmann/qik-vrt/contents/evidence%2Fcausal-distance%2F2026-10-24%2FREADME.md?ref=51f516368ae33d1d788e50b0301929d0252187e5\",\"patch\":\"@@ -0,0 +1,46 @@\\n+# Kausale Distanz und lokaler Wirkungsnachweis — persistierter Kandidat\\n+\\n+**Die dauerhafte Ablage dieses Ergebnisses erfolgt im QIKVRT Authority-Repository.** Der frühere Hinweis auf das Dateispeicherlimit dieses Chat-Clients begründet keine Sperre dieser Repository-Ablage und ist insoweit korrigiert.\\n+\\n+## Inhalt und Identität\\n+\\n+- [Vollständiges reproduzierbares Paket](REPRODUCIBLE_PACKAGE.json): ZIP als explizit bezeichnete Base64-Nutzlast, 262030 Originalbytes, mit 71 manifestgebundenen Dateien einschließlich Implementierung, Tests, Originalquellen, Rohreadbacks und Prüfbericht.\\n+- [Lesbarer Quelltext der Distanzkomponente](qikvrt_causal_distance.py).\\n+- [Persistenzquittung](PERSISTENCE_RECEIPT.json): tatsächliche Commits und Blob-IDs sowie bytegleicher unabhängiger Repository-Readback.\\n+\\n+Original-ZIP SHA-256:\\n+\\n+`d070ae7e9c15feeadedddf55b3bf77072a3b74289dad60bb3adce4aee7089f91`\\n+\\n+Das unveränderte ZIP bewahrt auch den historischen Bericht mit dessen damaligem Ablagestatus. Für die jetzt erfolgte Repository-Persistenz ist diese korrigierende Nachfolgernotiz maßgeblich. Die im ZIP enthaltenen früheren Testjournale bleiben historische, nur lesend zu öffnende Exporte.\\n+\\n+## Ergebnis und Grenze\\n+\\n+Im lokalen kontrollierten Programm gibt die passende Zukunftsbedingung eine reale Dateiänderung von 2 auf 3 frei. Unpassende Zukunftsbedingung, falscher Archivtyp und fehlende Verantwortung verhindern sie. Das eingefrorene Vergangenheitsarchiv bleibt unverändert. Der originale Terminal-Leser bestätigt elf Ereignisse nach erneutem Öffnen; ein Feedbackschritt erzeugt aus dem beobachteten Ergebnis die nächste Erwartung 4.\\n+\\n+61 dokumentierte Tests bestehen: 16 neue Metrik-/Witness-Tests, 41 originale EAP-Tests und vier ausgewählte originale Writer-Kontinuitätstests. Alle 4096 gerichteten Graphen mit vier Knoten werden gegen eine unabhängige Floyd-Warshall-Berechnung geprüft.\\n+\\n+Der gerichtete Abstand ist die kleinste Summe positiver ganzzahliger Gewichte entlang eines gerichteten Abhängigkeitspfads. Er ist eine erweiterte Quasimetrik. Die ungerichtete Projektion liefert eine symmetrische Metrik innerhalb jeder zusammenhängenden Komponente. Bei Einheitsgewicht ist die Einheit ein ausdrücklich deklarierter primitiver Abhängigkeitsschritt. Fehlender Pfad in einem unvollständigen Graphen begründet keine physische Unmöglichkeit. Rückwärtsgerichtete Suche ist von physischer Retrokausalität getrennt.\\n+\\n+Diese Ablage integriert den Kandidaten noch nicht in produktive Ausführung oder Main. Die dokumentierten Tests gehören zum eingefrorenen lokalen Kandidaten; ein vollständiges `make test`, neue Lean-Kernelprüfung und Head-CI sind hier nicht als ausgeführt behauptet. Laufzeit- und Domain-Abnahme bleiben eigene Nachweise und verhindern nicht diese Datenablage.\\n+\\n+## Paket lokal wiederherstellen\\n+\\n+Nach einem normalen Checkout dieses Branches im Verzeichnis dieser README ausführen:\\n+\\n+```python\\n+import base64\\n+import hashlib\\n+import json\\n+from pathlib import Path\\n+\\n+package = json.loads(Path(\\\"REPRODUCIBLE_PACKAGE.json\\\").read_text())\\n+data = base64.b64decode(package[\\\"artifact_base64\\\"], validate=True)\\n+assert len(data) == package[\\\"artifact_size_bytes\\\"]\\n+assert hashlib.sha256(data).hexdigest() == package[\\\"artifact_sha256\\\"]\\n+Path(package[\\\"artifact_name\\\"]).write_bytes(data)\\n+```\\n+\\n+Nach dem Entpacken enthält die Paket-README die vollständige mathematische Herleitung und Reproduktionsbefehle. Der ZIP-Manifestindex erlaubt die unabhängige Prüfung jeder enthaltenen Datei.\\n+\\n+Architekturgedanke und Autorisierung: Ingolf Lohmann. Implementierung, lokale Prüfung und Aufbereitung: ChatGPT im autorisierten Auftrag.\"},{\"sha\":\"dfcbb7044b91c3adea882fc2f8261b9df6bee209\",\"filename\":\"evidence/causal-distance/2026-10-24/REPRODUCIBLE_PACKAGE.json\",\"status\":\"added\",\"additions\":15,\"deletions\":0,\"changes\":15,\"blob_url\":\"https://github.com/ingolf-lohmann/qik-vrt/blob/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FREPRODUCIBLE_PACKAGE.json\",\"raw_url\":\"https://github.com/ingolf-lohmann/qik-vrt/raw/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2FREPRODUCIBLE_PACKAGE.json\",\"contents_url\":\"https://api.github.com/repos/ingolf-lohmann/qik-vrt/contents/evidence%2Fcausal-distance%2F2026-10-24%2FREPRODUCIBLE_PACKAGE.json?ref=51f516368ae33d1d788e50b0301929d0252187e5\"},{\"sha\":\"125ea0fefc03462a10e22d8445b9a7cadf1e5cf5\",\"filename\":\"evidence/causal-distance/2026-10-24/qikvrt_causal_distance.py\",\"status\":\"added\",\"additions\":125,\"deletions\":0,\"changes\":125,\"blob_url\":\"https://github.com/ingolf-lohmann/qik-vrt/blob/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2Fqikvrt_causal_distance.py\",\"raw_url\":\"https://github.com/ingolf-lohmann/qik-vrt/raw/51f516368ae33d1d788e50b0301929d0252187e5/evidence%2Fcausal-distance%2F2026-10-24%2Fqikvrt_causal_distance.py\",\"contents_url\":\"https://api.github.com/repos/ingolf-lohmann/qik-vrt/contents/evidence%2Fcausal-distance%2F2026-10-24%2Fqikvrt_causal_distance.py?ref=51f516368ae33d1d788e50b0301929d0252187e5\",\"patch\":\"@@ -0,0 +1,125 @@\\n+# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0\\n+\\\"\\\"\\\"Read-only distances on a finite, explicitly scoped dependency graph.\\n+\\n+Hash verification binds evidence bytes, not their truth. Admission of a causal\\n+interpretation remains the caller's separate proof obligation. Never derive an\\n+edge from ledger sequence, wall-clock order, or shared ancestry alone.\\n+\\\"\\\"\\\"\\n+from dataclasses import dataclass\\n+from heapq import heappop, heappush\\n+from math import inf\\n+from types import MappingProxyType\\n+import unicodedata\\n+from qikvrt_effect_ack import canonical_json, sha256_identifier\\n+\\n+\\n+@dataclass(frozen=True)\\n+class Edge:\\n+    source: str\\n+    target: str\\n+    weight: int\\n+    evidence_ref: str\\n+\\n+\\n+class DependencyGraph:\\n+    \\\"\\\"\\\"Positive integer weights; one fixed subject, resolution and evidence scope.\\n+\\n+    directed() is an extended quasi-metric. metric() is an extended metric on\\n+    the undirected projection and a finite metric within each weak component.\\n+    A metric path may traverse dependencies backwards and confers no influence.\\n+    \\\"\\\"\\\"\\n+    def __setattr__(self, name, value):\\n+        if getattr(self, '_sealed', False):\\n+            raise AttributeError('IMMUTABLE_GRAPH_SNAPSHOT')\\n+        object.__setattr__(self, name, value)\\n+\\n+    def __init__(self, vertices, edges, evidence, *, subject_ref, resolution, scope):\\n+        raw = tuple(vertices)\\n+        if not raw or any(not isinstance(v, str) or not v.strip() for v in raw):\\n+            raise ValueError('NONEMPTY_VERTEX_IDENTITIES_REQUIRED')\\n+        if len(set(raw)) != len(raw):\\n+            raise ValueError('DUPLICATE_VERTEX')\\n+        if any(unicodedata.normalize('NFC', v) != v for v in raw):\\n+            raise ValueError('NFC_VERTEX_IDENTITIES_REQUIRED')\\n+        if any(not isinstance(s, str) or not s.strip() for s in (resolution, scope)):\\n+            raise ValueError('RESOLUTION_AND_SCOPE_REQUIRED')\\n+        if subject_ref not in evidence:\\n+            raise ValueError('SUBJECT_EVIDENCE_REQUIRED')\\n+        if sha256_identifier(evidence[subject_ref]) != subject_ref:\\n+            raise ValueError('SUBJECT_HASH_MISMATCH')\\n+        self.vertices = tuple(sorted(raw))\\n+        self.edges = tuple(sorted(tuple(edges), key=lambda e: (e.source, e.target, e.weight, e.evidence_ref)))\\n+        seen = set()\\n+        for e in self.edges:\\n+            if e.source not in raw or e.target not in raw or e.source == e.target:\\n+                raise ValueError('INVALID_EDGE_ENDPOINT')\\n+            if type(e.weight) is not int or e.weight <= 0:\\n+                raise ValueError('POSITIVE_INTEGER_WEIGHT_REQUIRED')\\n+            if (e.source, e.target) in seen:\\n+                raise ValueError('DUPLICATE_EDGE')\\n+            seen.add((e.source, e.target))\\n+            if e.evidence_ref not in evidence:\\n+                raise ValueError('EDGE_EVIDENCE_REQUIRED')\\n+            data = evidence[e.evidence_ref]\\n+            if sha256_identifier(data) != e.evidence_ref:\\n+                raise ValueError('EDGE_HASH_MISMATCH')\\n+            import json\\n+            receipt = json.loads(data)\\n+            if not isinstance(receipt, dict) or type(receipt.get('weight')) is not int:\\n+                raise ValueError('TYPED_EDGE_RECEIPT_REQUIRED')\\n+            expected = {'source': e.source, 'target': e.target, 'weight': e.weight,\\n+                        'subject_ref': subject_ref, 'resolution': resolution, 'scope': scope}\\n+            if any(receipt.get(k) != v for k, v in expected.items()):\\n+                raise ValueError('EDGE_RECEIPT_BINDING_MISMATCH')\\n+        forward = {v: [] for v in raw}\\n+        undirected = {v: [] for v in raw}\\n+        for e in self.edges:\\n+            forward[e.source].append((e.target, e.weight))\\n+            undirected[e.source].append((e.target, e.weight))\\n+            undirected[e.target].append((e.source, e.weight))\\n+        self._forward = MappingProxyType({v: tuple(sorted(a)) for v, a in forward.items()})\\n+        self._undirected = MappingProxyType({v: tuple(sorted(a)) for v, a in undirected.items()})\\n+        self.subject_ref, self.resolution, self.scope = subject_ref, resolution, scope\\n+        self.graph_ref = sha256_identifier(canonical_json({\\n+            'vertices': self.vertices, 'edges': [\\n+                {'source': e.source, 'target': e.target, 'weight': e.weight,\\n+                 'evidence_ref': e.evidence_ref} for e in self.edges],\\n+            'subject_ref': subject_ref, 'resolution': resolution, 'scope': scope\\n+        }).encode())\\n+        self._sealed = True\\n+\\n+    def _path(self, a, b, adjacency):\\n+        if a not in adjacency or b not in adjacency:\\n+            raise ValueError('UNKNOWN_VERTEX')\\n+        queue = [(0, (a,))]\\n+        best = {a: 0}\\n+        while queue:\\n+            cost, path = heappop(queue)\\n+            node = path[-1]\\n+            if cost != best[node]:\\n+                continue\\n+            if node == b:\\n+                return cost, path\\n+            for nxt, weight in adjacency[node]:\\n+                value = cost + weight\\n+                if value < best.get(nxt, inf):\\n+                    best[nxt] = value\\n+                    heappush(queue, (value, path + (nxt,)))\\n+        return inf, ()\\n+\\n+    def directed(self, a, b):\\n+        return self._path(a, b, self._forward)[0]\\n+\\n+    def metric(self, a, b):\\n+        return self._path(a, b, self._undirected)[0]\\n+\\n+    def query(self, a, b, *, structural=False):\\n+        d, path = self._path(a, b, self._undirected if structural else self._forward)\\n+        return {'graph_ref': self.graph_ref, 'subject_ref': self.subject_ref,\\n+                'resolution': self.resolution, 'scope': self.scope,\\n+                'measure': 'SYMMETRIC_STRUCTURAL_METRIC' if structural else 'DIRECTED_DEPENDENCY_DISTANCE',\\n+                'source': a, 'target': b, 'distance': None if d == inf else d,\\n+                'unit': 'declared_dependency_units', 'path': list(path),\\n+                'status': 'NO_PATH_IN_BOUND_GRAPH' if d == inf else 'PATH_IN_BOUND_GRAPH',\\n+                'physical_impossibility_inferred': False,\\n+                'backwards_physical_influence_inferred': False}\"}]}",
