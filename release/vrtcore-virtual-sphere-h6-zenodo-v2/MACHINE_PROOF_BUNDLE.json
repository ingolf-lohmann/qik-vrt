  "claims": [
    {
      "claim_id": "H6-C01",
      "statement": "Within the inductively declared H6 bitstream/AST model, parsing and grammar derivation are equivalent, render/parse roundtrips recover the AST, successful parse fixes the canonical normalization, and normalization is idempotent and preserves the bound AST semantics.",
      "classification": "FORMAL_PROVED",
      "status": "PROVED",
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "A theorem about the formal codec and inductive grammar encoded in Lean; not yet a kernel proof of this separate EBNF text parser or of every parser implementation.",
      "proof_refs": [
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.parse_some_iff_grammar",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.parse_render_roundtrip",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.normalize_of_parse",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.normalize_idempotent",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.normalize_preserves_semantics",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.semantic_binding_total_unique"
      ],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-02-vrtcore-virtual-sphere-h6/CLAIM_MATRIX.json#H6-C01"
      ]
    },
    {
      "claim_id": "H6-C02",
      "statement": "Within H6, the canonical bitstream/AST/semantic refinement chain is total on declared well-formed inputs, and the concrete growth function refines StepSpec.",
      "classification": "FORMAL_PROVED",
      "status": "PROVED",
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "The receipt must bind the actual package bytes; semantic refinement does not establish physical reference.",
      "proof_refs": [
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.semantic_binding_total_unique",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.canonicalDocument_exact_semanticModel",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.canonicalBits_exact_model",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.next_refines_stepSpec",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.stepSpec_total_unique"
      ],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-02-vrtcore-virtual-sphere-h6/CLAIM_MATRIX.json#H6-C02"
      ]
    },
    {
      "claim_id": "H6-C03",
      "statement": "The H6 virtual cosmos has an explicit non-vacuous valid seed; its transition is deterministic; every non-seed reachable state is generated from a legal predecessor without an index gap; every reachable state has a successor; and invariants plus the persistent core are preserved.",
      "classification": "FORMAL_PROVED",
      "status": "PROVED",
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "The invariants are exactly those declared by H6; the claim is not quantification over every desirable property of every possible virtual world.",
      "proof_refs": [
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.state_nonvacuous",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.stepSpec_deterministic",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.reachable_nonseed_has_predecessor",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.reachable_progress",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.reachable_virtualInvariant",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.next_preserves_shells",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.seed_reachable",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.reachable_noHole"
      ],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-02-vrtcore-virtual-sphere-h6/CLAIM_MATRIX.json#H6-C03"
      ]
    },
    {
      "claim_id": "H6-C04",
      "statement": "Every individually generated H6 state has finite population, while the concrete strict-growth construction yields no finite upper population bound and preserves the declared invariants.",
      "classification": "FORMAL_PROVED",
      "status": "PROVED",
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "Unbounded means no finite population bound in the mathematical construction. It neither executes infinitely many steps in finite hardware nor proves analytic continuity.",
      "proof_refs": [
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.population_eq_radius_succ",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.run_strict_growth",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.reachable_unbounded",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.reachable_virtualInvariant"
      ],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-02-vrtcore-virtual-sphere-h6/CLAIM_MATRIX.json#H6-C04"
      ]
    },
    {
      "claim_id": "H6-C05",
      "statement": "The H6 no-hole top theorem composes a retained external-binding parameter, model-relative grammar and codec laws, semantic totality, StepSpec refinement, non-vacuity, valid initialization, generatedness, no-gap safety, progress for every reachable state, strict growth, derived finite populations, unboundedness and effect-boundary preservation into the kernel-inner VirtualClosure certificate.",
      "classification": "FORMAL_PROVED",
      "status": "PROVED",
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "Lean retains the supplied ExactArtifactBinding but does not compute or authenticate its digest strings. The external exact-inventory verifier and local receipt bind those bytes; PhysicalClosure is unaffected.",
      "proof_refs": [
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.h6_virtualSphere_noHole_complete"
      ],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-02-vrtcore-virtual-sphere-h6/CLAIM_MATRIX.json#H6-C05"
      ]
    },
    {
      "claim_id": "H6-C06",
      "statement": "Every kernel-scoped VirtualClosure Boolean is projected from the named Lean certificate; byte-bound is validated separately by the exact external receipt. VirtualClosureCertificate and PhysicalClosureEvidence remain disjoint variants, while effect-preservation and no-escalation theorems prevent virtual execution from constructing EFFECT_ACK_DONE or external authorization.",
      "classification": "FORMAL_PROVED",
      "status": "PROVED",
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "The separation is a formal and epistemic safeguard; it does not decide whether a future physical correspondence can be established.",
      "proof_refs": [
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.kernelClosureProjection_all_true",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.virtualCertificate_disjoint_physicalEvidence",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.effect_preserved",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.virtual_no_effect_escalation",
        "release/vrtcore-virtual-sphere-h6-zenodo-v2/KERNEL_RECEIPT.json#QIKVRT.VRTCore.VirtualSphereH6.no_external_authorization"
      ],
      "evidence_refs": [],
      "source_refs": [
        "docs/publications/2026-08-02-vrtcore-virtual-sphere-h6/CLAIM_MATRIX.json#H6-C06"
      ]
    },
    {
      "claim_id": "H6-C07",
      "statement": "The receipt-bound H6 local execution completed a finite verification run; that execution observation is distinct from the formal theorem of unboundedness.",
      "classification": "EMPIRICALLY_EVIDENCED",
      "status": "EVIDENCED",
      "publication_wording": "EMPIRICALLY_SUPPORTED",
      "scope": "The empirical execution record is distinct from the mathematical theorem of unboundedness.",
