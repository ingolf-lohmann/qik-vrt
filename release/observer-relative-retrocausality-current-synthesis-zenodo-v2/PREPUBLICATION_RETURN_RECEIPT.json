  "change_notice_path": "release/observer-relative-retrocausality-current-synthesis-zenodo-v2/CHANGE_NOTICE.md",
  "change_reasons": [
    {
      "claim_id": "ORRZ-001",
      "corrected_sha256": "9f0b3c2d53e130a2891a9797715d3f3c696e54409e38dcd03e69606aea5fbfd2",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/QIK-VRT_Beobachterrelative_Retrokausalitaet_DE.tex",
      "original_sha256": "ff7a10e78f8f602352612d797e83a8911be3bc464d0d69e7b88f41f4a9139412",
      "reason": "Die lokale Veränderungszeit wird operativ von einer optionalen metrischen Eigenzeitkalibrierung getrennt; die negative Informationsrichtung wird an steigende Empfangsordnung und absteigende authentische Quellenordnung gebunden. Bei raumartiger Trennung kann ein lokales Gegenwartsereignis in einer gewählten Koordinatisierung im Koordinaten-Zukunftsbereich eines anderen Beobachters liegen; dies ist keine kausale Zukunftsbeziehung und stellt keinen Record vor seiner Quellenerzeugung bereit."
    },
    {
      "claim_id": "ORRZ-002",
      "corrected_sha256": "5546b3d5f5367596438ecbd6c2b00f89dbb21d84e66b54784c45d0b52436388c",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/verify_observer_relative_retrocausality.py",
      "original_sha256": "53e43a4d3d96acc8654379d4cf5f0b09ec41edde686a39b7a5cec16ecdf524c9",
      "reason": "Der endliche Prüfer und sein kanonischer Report werden als ausführbarer Zeuge des deklarierten Modells ausgewiesen, nicht als Lean-Kernel-Receipt, universeller Satz oder Messung des ganzen Universums."
    },
    {
      "claim_id": "ORRZ-003",
      "corrected_sha256": "9f0b3c2d53e130a2891a9797715d3f3c696e54409e38dcd03e69606aea5fbfd2",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/QIK-VRT_Beobachterrelative_Retrokausalitaet_DE.tex",
      "original_sha256": "ff7a10e78f8f602352612d797e83a8911be3bc464d0d69e7b88f41f4a9139412",
      "reason": "Der bedingte endliche Existenzsatz wird für die genau genannten Ordnungs-, Authentizitäts- und Monotonieannahmen quellgebunden dargestellt; für diese aktuelle Claim-Menge liegt kein neues exaktes Lean-Kernel-Receipt vor."
    },
    {
      "claim_id": "ORRZ-004",
      "corrected_sha256": "817b0bbd38ff2d5e811c7ba4c04dff7e6b9310fbb3016309c451317d1de5b471",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/QIKVRT_RETROCAUSALITY_WITNESS.json",
      "original_sha256": "6ed0ae65dd112631b1c952275151c93ed5c8c126f87d9cdd8d1a64caa8fa3cd7",
      "reason": "Die Konstruktion bindet zwei positive vorwärtsgerichtete Laufzeiten und trennt die resultierende Empfangsreihenfolge ausdrücklich von Überlichtübertragung, Empfang vor Emission und vergangenheitsgerichtetem Transport."
    },
    {
      "claim_id": "ORRZ-005",
      "corrected_sha256": "9f0b3c2d53e130a2891a9797715d3f3c696e54409e38dcd03e69606aea5fbfd2",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/QIK-VRT_Beobachterrelative_Retrokausalitaet_DE.tex",
      "original_sha256": "ff7a10e78f8f602352612d797e83a8911be3bc464d0d69e7b88f41f4a9139412",
      "reason": "Delayed-Choice- und Quantenradierer-Arbeiten dienen nur als begrenzte Quellenbrücke für kontextabhängige Klassifikation; ein auswählbares Rückwärtssignal oder eine eindeutige empirische Auswahl von QIK-VRT wird nicht behauptet."
    },
    {
      "claim_id": "ORRZ-006",
      "corrected_sha256": "9f0b3c2d53e130a2891a9797715d3f3c696e54409e38dcd03e69606aea5fbfd2",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/QIK-VRT_Beobachterrelative_Retrokausalitaet_DE.tex",
      "original_sha256": "ff7a10e78f8f602352612d797e83a8911be3bc464d0d69e7b88f41f4a9139412",
      "reason": "Die vom Autor vertretene Korrespondenzthese wird als Interpretation von endlichem Zeugen, unabhängiger empirischer Bestätigung und wissenschaftlichem Konsens getrennt."
    },
    {
      "claim_id": "ORRZ-007",
      "corrected_sha256": "9f84be2e6653bc6c107b1b1a75388ac437c5dafb9c22f069eab35cf07daa4e4b",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/AN_VON_UND_FUER_ALLE_MENSCHEN_DE.md",
      "original_sha256": "a23f96ec7f75dc28dcbc37012f1195a97370fdcfcf8dc92b6e70b0be6c3a18d9",
      "reason": "Die neu hinzugefügte öffentliche Erklärung kennzeichnet „Vergrößere die Menge des Jetzt“ als normativen Verantwortungsimperativ und nicht als mathematischen Satz oder aus Physik erzwungenes Moralgesetz."
    },
    {
      "claim_id": "ORRZ-008",
      "corrected_sha256": "6add926d68205483dfd98d0b1c6f41fd6be393ff3b719589472149bca814855d",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/README.md",
      "original_sha256": "a23f96ec7f75dc28dcbc37012f1195a97370fdcfcf8dc92b6e70b0be6c3a18d9",
      "reason": "Die zwei historischen PDFs bleiben bytegenaue Zwischenstände; spätere Aussagen werden ihnen nicht rückwirkend zugeschrieben und ihre Bytes werden nicht überschrieben."
    },
    {
      "claim_id": "ORRZ-009",
      "corrected_sha256": "9f0b3c2d53e130a2891a9797715d3f3c696e54409e38dcd03e69606aea5fbfd2",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/QIK-VRT_Beobachterrelative_Retrokausalitaet_DE.tex",
      "original_sha256": "ff7a10e78f8f602352612d797e83a8911be3bc464d0d69e7b88f41f4a9139412",
      "reason": "Ein neues Lean-Kernel-Receipt für die aktuelle beobachterrelative Existenzdarstellung, unabhängige empirische Bestätigung und wissenschaftlicher Konsens bleiben ausdrücklich offen."
    },
    {
      "claim_id": "ORRZ-010",
      "corrected_sha256": "9f84be2e6653bc6c107b1b1a75388ac437c5dafb9c22f069eab35cf07daa4e4b",
      "exact_candidate_path": "docs/publications/2026-08-12-observer-relative-retrocausality/AN_VON_UND_FUER_ALLE_MENSCHEN_DE.md",
      "original_sha256": "a23f96ec7f75dc28dcbc37012f1195a97370fdcfcf8dc92b6e70b0be6c3a18d9",
      "reason": "Die neu hinzugefügte öffentliche Erklärung kennzeichnet den Schutz zukünftiger Handlungsfähigkeit und die Nicht-Reduktion von Menschen auf verwertbares Material, Risiko, Datei, Zielgruppe oder Feindbild als normative Position, nicht als mechanisch aus Software, Mathematik oder Physik erzwungene Folgerung."
    }
