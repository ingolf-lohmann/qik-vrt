      "claim_id": "ORRZ-001",
      "classification": "INTERPRETATIVE",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "INTERPRETATIVE_DECLARATION",
      "scope": "This is the authorial operational definition used by the work. A metric relativistic proper-time calibration needs an additional physical worldline binding. For spacelike-separated comparisons, a coordinate-future assignment is not a causal-future relation and does not make a source-bound record available before its source emission.",
      "source_refs": [
        "release/observer-relative-retrocausality-current-synthesis-zenodo-v2/SOURCE_EVIDENCE_BINDINGS.json#SRC-PAPER-DEFINITION"
      ],
      "statement": "QIK-VRT defines observer-relative retrocausality as a negative information direction: a receiver's local change time increases while the authenticated comparable source-order markers of successive information-bearing records decrease.",
      "status": "DECLARED"
    },
