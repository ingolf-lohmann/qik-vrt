  },
  "normalization_rules": {
    "copy_semantics": "COPY_CURRENT_PUBLIC_METADATA_EXACTLY_THEN_SERIALIZE_CANONICALLY",
    "allowed_keys": [
      "access_right",
      "creators",
      "description",
      "keywords",
      "language",
      "license",
      "notes",
      "publication_date",
      "publication_type",
      "related_identifiers",
      "title",
      "upload_type",
      "version"
    ],
    "required_keys": [
      "access_right",
      "creators",
      "description",
      "title",
      "upload_type",
      "version"
    ],
    "forbidden_keys": [
      "prereserve_doi"
