    "bytes": null,
    "sha256": null,
    "git_blob_sha": null,
    "canonical_metadata_sha256": null
  },
  "external_effects": {
    "metadata_before_materialized": false,
    "zenodo_metadata_edit": "NOT_EXECUTED"
  }
