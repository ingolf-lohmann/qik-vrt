{
  "schema": "qikvrt_zenodo_metadata_before_normalization_template_v1",
  "state": "TEMPLATE_NOT_EVIDENCE_NOT_EXECUTABLE",
  "purpose": "Specify how fresh public record.metadata is copied into the exact metadata_before artifact for a same-DOI edit.",
  "input_contract": {
    "required_fresh_capture_path": "release/round-trip-canonical-publication-zenodo-metadata-clarification-v2/FRESH_PUBLIC_RECORD_CAPTURE.json",
    "json_pointer": "/metadata",
    "source_response_sha256": null,
    "source_response_etag": null,
