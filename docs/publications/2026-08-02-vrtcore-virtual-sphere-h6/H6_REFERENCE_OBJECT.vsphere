  vm-image-digest = "NOT_AVAILABLE_NOT_CLAIMED";
  command-digest = "431b74f39e7b8454278dd6a682923cc631a7929af022d23585e07a0c406eab4f";
  lean-source-digest = "2bfc26a7728b7a63cc9ecfb11981ff54d69b710b229259ec035f51acf8b7a1c3";
  audit-source-digest = "01c969946c02e655960e996f55f27bc302b09ca9bea969dae414a28c04e7439e";
