canonical-object H6Object {
  package-bytes = ExternalReceiptBoundPackageBytes;
  token-stream = ListBoolBitstream;
  abstract-syntax = VirtualSphereDocument;
  semantic-object = VirtualSphereSemanticModel;
  byte-manifest = "MANIFEST.json";
  digest-algorithm = SHA-256;
  canonical-encoding = "UTF-8 source bytes with LF line endings and receipt-bound digests";
};

grammar-contract H6Grammar {
  surface-grammar = "VRTCore_VirtualSphere_Syntax.ebnf";
  surface-parser-status = not-kernel-proved;
  formal-grammar = BitstreamGrammar;
  grammar-induction-theorem = render_grammar;
  decode = parseDocument;
  encode = renderDocument;
  normalize = normalizeDocumentBits;
  well-formed = WellFormed;
  unique-parse-theorem = grammar_unique;
  parse-serialize-theorem = parse_render_roundtrip;
  serialize-parse-theorem = normalize_of_parse;
  serialize-injective-theorem = render_injective;
  canonical-idempotence-theorem = normalize_idempotent;
  normalization-semantics-theorem = normalize_preserves_semantics;
  reject-invalid-theorem = parse_none_iff_not_wellFormed;
  rejection-completeness-theorem = parse_none_iff_not_wellFormed;
};

refinement-chain H6Refinement {
  bytes-to-tokens = externalReceiptToListBoolBoundary;
  tokens-to-ast = parseDocument;
  ast-to-semantics = modelOfDocument;
  byte-token-theorem = verify_h6_package_exact_inventory;
  token-ast-theorem = parse_some_iff_grammar;
  semantic-totality-theorem = semantic_binding_total_unique;
  semantic-binding-theorem = canonicalDocument_exact_semanticModel;
  end-to-end-theorem = canonicalBits_exact_model;
};

virtual-cosmos H6Cosmos {
  seed = seed;
  step-spec = StepSpec;
  transition = next;
  step-refinement-theorem = next_refines_stepSpec;
  reachable = Reachable;
  population = population;
  non-vacuity-theorem = state_nonvacuous;
  seed-validity-theorem = state_virtualInvariant;
  determinism-theorem = stepSpec_deterministic;
  generatedness-theorem = every_state_reachable;
  predecessor-theorem = reachable_nonseed_has_predecessor;
  no-gap-theorem = next_shell_delta_exact;
  progress-theorem = reachable_progress;
  strict-growth-theorem = run_strict_growth;
  finite-population-theorem = population_eq_radius_succ;
  unboundedness-theorem = reachable_unbounded;
  growth-meaning = "Each discrete successor preserves the prior informational core, satisfies every invariant and adds at least one reachable unit.";
};

invariant-contract H6Invariants {
  invariants = [noHole,centerPresent,populationDerived];
  legal-state = VirtualInvariant;
  seed-invariants-theorem = state_virtualInvariant;
  preservation-theorem = reachable_virtualInvariant;
  no-illegal-reachable-theorem = reachable_virtualInvariant;
  no-erasure-theorem = next_preserves_shells;
};

virtual-closure H6Closure {
  certificate = BoundVirtualClosureCertificate;
  projection-theorem = kernelClosureProjection_all_true;
  byte-bound = true;
  grammar-sound = true;
  grammar-complete = true;
  canonical-roundtrip = true;
  semantic-totality = true;
  non-vacuous = true;
  initial-state-valid = true;
  invariants-preserved = true;
  no-illegal-reachable-state = true;
  progress = true;
  strict-growth = true;
  unbounded = true;
  effect-boundary-preserved = true;
  result = VIRTUAL_CLOSURE_TRUE;
  closure-theorem = QIKVRT.VRTCore.VirtualSphereH6.h6_virtualSphere_noHole_complete;
};

scope-separation H6Scope {
  kernel-model-closure-status = kernel-proved;
  receipt-bound-package-closure-status = kernel-proved;
  physical-closure-status = open;
  closure-types-distinct = true;
  virtual-to-physical-promotion = false;
  physical-big-bang-identity = open;
  empirical-promotion = open;
  boundary = "H6 proves the declared virtual construction only. It neither completes quantum gravity nor identifies execution with the physical universe or Big Bang.";
};

effect-boundary H6Effect {
  technical-result = kernel-accepted;
  ordinary-release = false;
  external-mutation = false;
  no-escalation-theorem = virtual_no_effect_escalation;
  effect-preservation-theorem = effect_preserved;
  effect-state = EFFECT_ACK_CONTINUE;
  authorization-source = none;
};

outside-scope O01 {
  kind = open;
  statement = "A correspondence from H6 virtual states and transitions to measured physical states and dynamics is not supplied.";
  required-evidence = "A non-circular mathematical map, domain assumptions, preserved observables and independent empirical tests.";
  falsifier = "Failure of the map to recover validated observations in its declared domain.";
  owner = "future mathematical-physics and experimental review";
};

outside-scope O02 {
  kind = open;
  statement = "Independent exact-head reproduction of the final H6 package remains distinct from local kernel execution.";
  required-evidence = "A second environment rebuilds the receipt-bound bytes and obtains the same declared kernel and audit result.";
  falsifier = "Any unexplained source, axiom, theorem, digest or result mismatch.";
  owner = "independent reproducer";
};

outside-scope O03 {
  kind = normative;
  statement = "Growth should enlarge the reachable space without erasing provenance, responsibility or effect boundaries.";
  required-evidence = "A separately governed release decision for every externally consequential application.";
  falsifier = "An authorized policy revision or a demonstrated conflict with protected rights and safety constraints.";
  owner = "responsible human authority";
};
