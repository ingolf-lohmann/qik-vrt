vrtcore-virtual-sphere 6.0 scope qik-vrt-virtual-sphere-h6 author "Ingolf Lohmann" license CC-BY-NC-ND-4-0 effect-state EFFECT_ACK_CONTINUE;

proof-binding H6Proof {
  lean-source = "VRTCore_VirtualSphere.lean";
  axiom-audit = "VRTCore_VirtualSphere_AxiomAudit.lean";
  top-theorem = QIKVRT.VRTCore.VirtualSphereH6.h6_virtualSphere_noHole_complete;
  theorem-count = 55;
  kernel-receipt = H6_LOCAL_KERNEL_RECEIPT;
  kernel-result = audit-accepted;
};

trust-base H6Trust {
  lean-version = "4.19.0";
  kernel = "Lean 4 kernel";
  logic = "dependent type theory as implemented by the declared Lean kernel";
  imports = ["Std"];
  allowed-axioms = ["propext","Quot.sound","Classical.choice"];
  forbidden-declarations = ["sorry","admit","unsafe","project-local axiom"];
  execution-platform = "Ubuntu 24.04.3 LTS; Linux 6.12.13; x86_64; KVM; runtime details bound by TRUST_BASE.json and receipt";
  trust-boundary = "The result is relative to the bound Lean kernel, its declared logical axioms, source bytes and the hardware/software execution chain.";
};

exact-binding H6Binding {
  repository-head = "8b3f8cdc3ac5fc381b0796d5f7503f3a0e9689ba";
  package-root-digest = "BOUND_BY_PACKAGE_ROOT.sha256";
  manifest-digest = "BOUND_BY_H6_LOCAL_KERNEL_RECEIPT_AND_SHA256SUMS";
