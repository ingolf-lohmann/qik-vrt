8464/files/LICENSE-CODE/content"}}, {"id": "48585475-3955-49fc-b2fb-3008824bbc79", "key": "EVIDENCE_BOUNDARY.md", "size": 7107, "checksum": "md5:8bb85daafe74884e2816b5ad9baee279", "links": {"self": "https://zenodo.org/api/records/21518464/files/EVIDENCE_BOUNDARY.md/content"}}, {"id": "1c7a2c82-b059-4d83-8a95-b6e111ea0e19", "key": "ALPHA2_INPUT.json", "size": 2687, "checksum": "md5:01495bb71c38cf0bc35860381a6fcb75", "links": {"self": "https://zenodo.org/api/records/21518464/files/ALPHA2_INPUT.json/content"}}, {"id": "069c4fbc-c5e3-4951-bbd6-96f5fca4f023", "key": "FORMALIZATION_SCOPE.md", "size": 2334, "checksum": "md5:b788a27bc6d9a7d80d24324eab1591bf", "links": {"self": "https://zenodo.org/api/records/21518464/files/FORMALIZATION_SCOPE.md/content"}}, {"id": "f5e434bc-b082-4195-ae48-483e02704007", "key": "QIKVRT_Formalization_v2.0-alpha.2.zip", "size": 823942, "checksum": "md5:db63407c450316cf35d8e50e2333cdb4", "links": {"self": "https://zenodo.org/api/records/21518464/files/QIKVRT_Formalization_v2.0-alpha.2.zip/content"}}, {"id": "b6b1bc5f-6cee-45ef-83f2-73939524b128", "key": "CC-BY-NC-ND-4.0.txt", "size": 19127, "checksum": "md5:c70f85fe39eb601f25b595299c688bfd", "links": {"self": "https://zenodo.org/api/records/21518464/files/CC-BY-NC-ND-4.0.txt/content"}}, {"id": "eca89da6-1148-49fd-be13-7b16ae1976d5", "key": "CLAIM_GRAPH.json", "size": 29162, "checksum": "md5:61af8067bae8bcc0004b4d2e1b5ca1f9", "links": {"self": "https://zenodo.org/api/records/21518464/files/CLAIM_GRAPH.json/content"}}], "swh": null, "owners": [{"id": "1716671"}], "status": "published", "stats": {"downloads": 727, "unique_downloads": 611, "views": 125, "unique_views": 122, "version_downloads": 204, "version_unique_downloads": 158, "version_unique_views": 8, "version_views": 8}, "state": "done", "submitted": true}, {"created": "2026-07-23T01:23:42.977626+00:00", "modified": "2026-07-23T01:23:43.636793+00:00", "id": 21501365, "conceptrecid": "21488115", "doi": "10.5281/zenodo.21501365", "conceptdoi": "10.5281/zenodo.21488115", "doi_url": "https://doi.org/10.5281/zenodo.21501365", "metadata": {"title": "QIK-VRT: Quellengebundene partielle Lean-4-Formalisierung des 62-seitigen Manuskripts", "doi": "10.5281/zenodo.21501365", "publication_date": "2026-07-23", "description": "<p>Quellengebundener, reproduzierbarer Arbeitsstand der theoremweisen Lean-4-Rekonstruktion des 62-seitigen Manuskripts <em>Mandelbrot, Anschlussordnung, Physik und Retrokausalit\u00e4t</em>. Erfasst sind alle 40 formalen LaTeX-Umgebungen, 17 expliziten Beweisbl\u00f6cke, 5 Bemerkungen und 34 Zeilen der Anspruchsmatrix in einem azyklisch gepr\u00fcften Claim-Graphen mit 43 Knoten.</p><p>Der Lean-Kernel pr\u00fcft 12 atomare Bindungen. Neun davon bilden vollst\u00e4ndige Manuskriptanspr\u00fcche ab und decken 10 von 20 theoremartigen LaTeX-Umgebungen vollst\u00e4ndig ab. Drei weitere Bindungen sind ausdr\u00fccklich nur als <code>SOURCE_SUBCLAIM</code> klassifiziert. Zehn aggregierte Theoremanspr\u00fcche und die exakte Typbindung der 20 Manuskriptdefinitionen bleiben offen.</p><p>Der Axiom-Audit erlaubt ausschlie\u00dflich <code>propext</code>, <code>Classical.choice</code> und <code>Quot.sound</code>; projektspezifische Axiome, <code>sorry</code> und <code>admit</code> werden abgewiesen. Dieser Stand ist keine Behauptung, die gesamte Mathematik, Physik, Metaphysik oder Spiritualit\u00e4t sei reverse engineered, und keine empirische Best\u00e4tigung physikalischer oder retrokausaler Deutungen.</p>", "access_right": "open", "creators": [{"name": "Lohmann, Ingolf", "affiliation": "Independent researcher; QIK-VRT"}], "keywords": ["QIK-VRT", "Lean 4", "formal verification", "partial formalization", "claim graph", "source provenance", "proof assistant", "quantization boundary", "dimensional analysis", "retrocausality boundary", "reproducible research"], "related_identifiers": [{"identifier": "10.5281/zenodo.21482023", "relation": "isSupplementTo", "resource_type": "publication-workingpaper", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21488116", "relation": "references", "resource_type": "software", "scheme": "doi"}], "version": "2.0.0-alpha.1", "language": "deu", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "other-nc"}, "relations": {"version": [{"index": 2, "is_last": false, "parent": {"pid_type": "recid", "pid_value": "21488115"}}]}, "notes": "Status: partielle Formalisierung mit expliziten Grenzen. Freigabeprotokoll: qikvrt:formalization-v2-alpha-release:2026-07-23:v1. Autorisiertes Archiv SHA-256: 7cfa6851256bc5bdd9f5cb18ed7760d732dac2544a9f3a5ca514abade3a7825b. Zenodo-Persistenz belegt Identit\u00e4t, Version, Metadaten und Fixit\u00e4t der ver\u00f6ffentlichten Bytes; sie ersetzt weder Peer Review noch empirische Best\u00e4tigung. Das Paket ist gemischt lizenziert: neu erstellter Formalisierungscode unter MIT, wissenschaftliches Ausgangsmaterial und Release-Dokumentation unter CC BY-NC-ND 4.0, jeweils vorbehaltlich abweichender Datei- und Drittanbieterhinweise. Deshalb wird f\u00fcr das Aggregat die Zenodo-Kategorie Other (Non-Commercial) verwendet."}, "title": "QIK-VRT: Quellengebundene partielle Lean-4-Formalisierung des 62-seitigen Manuskripts", "links": {"self": "https://zenodo.org/api/records/21501365", "self_html": "https://zenodo.org/records/21501365", "preview_html": "https://zenodo.org/records/21501365?preview=1", "doi": "https://doi.org/10.5281/zenodo.21501365", "self_doi": "https://doi.org/10.5281/zenodo.21501365", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21501365", "reserve_doi": "https://zenodo.org/api/records/21501365/draft/pids/doi", "parent": "https://zenodo.org/api/records/21488115", "parent_html": "https://zenodo.org/records/21488115", "parent_doi": "https://doi.org/10.5281/zenodo.21488115", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21488115", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21501365/manifest", "self_iiif_sequence": "https://zenodo.org/api/i