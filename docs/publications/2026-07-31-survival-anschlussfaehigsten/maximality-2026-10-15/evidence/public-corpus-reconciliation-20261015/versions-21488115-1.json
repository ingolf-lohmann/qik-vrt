zenodo.org/api/records/21501365/files/MANUSCRIPT_PROOF_MAP.md/content"}}, {"id": "e0dab1b0-85c9-4e3d-9bc4-7c967c17fc89", "key": "release-authorization-EFFECT_ACK_DONE.json", "size": 2935, "checksum": "md5:53e93985619430496e5f0f37e20a9804", "links": {"self": "https://zenodo.org/api/records/21501365/files/release-authorization-EFFECT_ACK_DONE.json/content"}}, {"id": "0a327d0a-38b6-48a3-9b99-848d5d94a4c3", "key": "LICENSE_NOTICE.md", "size": 1218, "checksum": "md5:38b420f3142a41a09df03b94ec106d2b", "links": {"self": "https://zenodo.org/api/records/21501365/files/LICENSE_NOTICE.md/content"}}, {"id": "5126c64c-a798-429f-a213-3fe3f2a58df7", "key": "RELEASE_NOTES_WHATSAPP_DE.md", "size": 2647, "checksum": "md5:e809a1512baad2764f2dea8ac649b5b8", "links": {"self": "https://zenodo.org/api/records/21501365/files/RELEASE_NOTES_WHATSAPP_DE.md/content"}}], "swh": null, "owners": [{"id": "1716671"}], "status": "published", "stats": {"downloads": 727, "unique_downloads": 611, "views": 125, "unique_views": 122, "version_downloads": 141, "version_unique_downloads": 112, "version_unique_views": 27, "version_views": 28}, "state": "done", "submitted": true}, {"created": "2026-07-22T20:12:26.467864+00:00", "modified": "2026-07-22T20:12:26.767053+00:00", "id": 21498774, "conceptrecid": "21488115", "doi": "10.5281/zenodo.21498774", "conceptdoi": "10.5281/zenodo.21488115", "doi_url": "https://doi.org/10.5281/zenodo.21498774", "metadata": {"title": "QIK-VRT: EFFECT_ACK - universalisierbare Wirkungssteuerung und adaptive fail-closed Laufzeit", "doi": "10.5281/zenodo.21498774", "publication_date": "2026-07-22", "description": "<p>Versionierte QIK-VRT-Software mit strengem ANSI-C90-EFFECT_ACK-Kern, exhaustiver endlicher Modellpr\u00fcfung, reproduzierbarer Draft-01-Validierung mit xml2rfc 3.34.0, checksum-gebundenen GitHub-CLI- und Renderer-Laufzeiten sowie einem begrenzten kollektiv-adaptiven Vorschlagsprozess.</p><p>Der Prozess kann endliche, vollst\u00e4ndig und rechtm\u00e4\u00dfig zug\u00e4ngliche Digitalartefakte aufnehmen, klassifizieren und vollst\u00e4ndig mediierte Wirkungen konditional steuern. Er ist kein universeller Decoder, erzeugt keine verlorene Information, l\u00f6st weder Halteproblem noch Rice-Unentscheidbarkeit und beweist keine voraussetzungslose physikalische Sicherheit.</p><p>Der Source-Export ist gemischt lizenziert. Datei- und Verzeichnishinweise f\u00fcr PolyForm Noncommercial 1.0.0, CC BY-NC-ND 4.0, fortgeltende historische Apache-2.0-Gew\u00e4hrungen, IETF Trust Material und sonstige Drittinhalte bleiben ma\u00dfgeblich.</p>", "access_right": "open", "creators": [{"name": "Lohmann, Ingolf", "affiliation": "Independent researcher; QIK-VRT"}], "keywords": ["QIK-VRT", "EFFECT_ACK", "ANSI C90", "effect gating", "finite model checking", "adaptive runtime", "reproducible toolchain", "xml2rfc", "reverse engineering", "semantic factorization", "complete mediation", "provenance"], "related_identifiers": [{"identifier": "10.5281/zenodo.21498773", "relation": "isDocumentedBy", "resource_type": "publication-workingpaper", "scheme": "doi"}, {"identifier": "https://github.com/Goldkelch/qik-vrt/tree/v2026.07.22-effect-ack-universality-1.0.0", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}, {"identifier": "https://github.com/ingolf-lohmann/qik-vrt/tree/v2026.07.22-effect-ack-universality-1.0.0", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}, {"identifier": "10.5281/zenodo.21488116", "relation": "references", "resource_type": "software", "scheme": "doi"}, {"identifier": "10.5281/zenodo.20712301", "relation": "references", "resource_type": "software", "scheme": "doi"}, {"identifier": "https://www.ietf.org/archive/id/draft-lohmann-qikvrt-effect-ack-01.html", "relation": "references", "resource_type": "publication-workingpaper", "scheme": "url"}], "version": "2026.07.22-effect-ack-universality-1.0.0", "language": "deu", "resource_type": {"title": "Software", "type": "software"}, "license"