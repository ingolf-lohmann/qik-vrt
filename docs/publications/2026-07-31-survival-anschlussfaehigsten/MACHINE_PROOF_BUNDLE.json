  "claims": [
    {
      "claim_id": "HIS-001",
      "classification": "SOURCE_BOUND",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "Historical attribution only; it does not make the present computer-science interpretation a quotation from Darwin.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#SPENCER-1864",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#WALLACE-DARWIN-1866-07-02",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#DARWIN-WALLACE-1866-07-05",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#DARWIN-VARIATION-1868",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#DARWIN-ORIGIN-5E-1869"
      ],
      "statement": "Herbert Spencer coined 'survival of the fittest' in 1864; after Wallace recommended it, Darwin used it in 1868 and added it to the fifth Origin edition in 1869 without abandoning natural selection.",
      "status": "BOUND"
    },
    {
      "claim_id": "BIO-001",
      "classification": "SOURCE_BOUND",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "SOURCE_ATTRIBUTED",
      "scope": "Biological fitness admits several precise absolute, relative and time-dependent measures; it is not exhausted by a single colloquial definition.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#GREGORY-2009",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#ORR-2009",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#WADGYMAR-2024"
      ],
      "statement": "Evolutionary fitness quantifies reproductive contribution in a specified population, environment and time context rather than mere physical strength or individual longevity.",
      "status": "BOUND"
    },
    {
      "claim_id": "TRN-001",
      "classification": "INTERPRETATIVE",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "INTERPRETATIVE_DECLARATION",
      "scope": "This is Ingolf Lohmann's stipulated computer-age interpretation, not a literal translation, a historical Darwin quotation, or a biological identity theorem.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#docs/publications/2026-07-31-survival-anschlussfaehigsten/ORIGINAL_THESIS_TRANSCRIPT.md",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#docs/publications/2026-07-31-survival-anschlussfaehigsten/CANONICAL_STATEMENT.md"
      ],
      "statement": "Ingolf Lohmann stipulates, for the QIK-VRT computer-age interpretation, the rendering 'Survival of the fittest = Survival of the Anschlussfähigsten'.",
      "status": "DECLARED"
    },
    {
      "claim_id": "FIT-001",
      "classification": "FORMAL_PROVED",
      "evidence_refs": [],
      "proof_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/KERNEL_RECEIPT.json#QIKVRT.V2.OperationalContinuation.FIT001_checked"
      ],
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "The theorem concerns only the explicitly defined finite continuation system; it does not establish empirical biological or technical survival.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Process/OperationalContinuation.lean"
      ],
      "statement": "In the operational model, every positive finite continuation is exactly a viable successor connection plus tail continuation; without a viable successor no positive continuation is possible, and continuation is monotone under shortening the horizon.",
      "status": "PROVED"
    },
    {
      "claim_id": "FIT-002",
      "classification": "FORMAL_PROVED",
      "evidence_refs": [],
      "proof_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/KERNEL_RECEIPT.json#QIKVRT.V2.ConnectabilitySimulation.FIT002_checked"
      ],
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "The result covers finite viable words from arbitrary viable starts under total viable-state coverage and a shared label type; label meaning is an external correspondence obligation.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Process/ConnectabilitySimulation.lean"
      ],
      "statement": "A viability-preserving simulation covering every viable source state induces global inclusion of the source system's finite viable language in the target system's finite viable language.",
      "status": "PROVED"
    },
    {
      "claim_id": "FIT-003",
      "classification": "FORMAL_PROVED",
      "evidence_refs": [],
      "proof_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/KERNEL_RECEIPT.json#QIKVRT.V2.ConnectabilitySimulation.FIT003_checked"
      ],
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "The result concerns pointed finite traces in the defined transition model; contract semantics are folded into the step relation and real-system correspondence remains unproved.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Process/ConnectabilitySimulation.lean"
      ],
      "statement": "An initial-state-related viability-preserving simulation induces inclusion of the pointed source viable language in the pointed target viable language.",
      "status": "PROVED"
    },
    {
      "claim_id": "MAT-001",
      "classification": "FORMAL_PROVED",
      "evidence_refs": [],
      "proof_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/KERNEL_RECEIPT.json#QIKVRT.V2.WeightedConnectability.MAT001_checked"
      ],
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "Kernel-verified only for the encoded finite duplicate-free trace universe, decidable membership, natural nonnegative weights and a shared positive normalizer. Rational weights require common scaling; arbitrary real weights and empirical survival rates are not established.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Process/WeightedConnectability.lean"
      ],
      "statement": "Within the encoded finite weighted model, viable-language inclusion and a shared positive total weight imply a nondecreasing common-denominator normalized potential-viability score.",
      "status": "PROVED"
    },
    {
      "claim_id": "MAT-002",
      "classification": "FORMAL_PROVED",
      "evidence_refs": [],
      "proof_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/KERNEL_RECEIPT.json#QIKVRT.V2.WeightedConnectability.MAT002_checked"
      ],
      "publication_wording": "ESTABLISHED_WITHIN_SCOPE",
      "scope": "Kernel-verified only for the encoded finite duplicate-free trace universe, decidable membership, natural nonnegative weights, a shared positive normalizer and a constructively located positive-weight witness in the strict difference. It establishes no empirical survival advantage.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#formalization/QIKVRT_Formalization_v2.0/QIKVRTFormalization/Process/WeightedConnectability.lean"
      ],
      "statement": "Within the encoded finite weighted model, viable-language inclusion plus a constructively located positive-weight trace in the strict language difference implies a strictly larger common-denominator normalized potential-viability score.",
      "status": "PROVED"
    },
    {
      "claim_id": "EMP-001",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "This requires preregistered systems, environments, resources, policies or schedulers, outcome definitions and complete trial accounting; the current paper contains no confirming experiment.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#docs/publications/2026-07-31-survival-anschlussfaehigsten/ARTICLE_DE.md"
      ],
      "statement": "It remains an open empirical hypothesis that, under preregistered comparable conditions, greater invariant-preserving connectability produces a non-lower operational-persistence rate.",
      "status": "OPEN"
    },
    {
      "claim_id": "LIM-001",
      "classification": "OPEN",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "EXPLICITLY_OPEN",
      "scope": "Any such correspondence requires explicit population, replication, inheritance, variation and selection models together with an empirical bridge; no identity is asserted here.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#WAGNER-ALTENBERG-1996",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#ADAMI-2006",
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#OFRIA-WILKE-2004"
      ],
      "statement": "Whether a specified technical-connectability measure corresponds empirically to biological fitness or evolvability remains open and is not established by this work.",
      "status": "OPEN"
    },
    {
      "claim_id": "NOR-001",
      "classification": "NORMATIVE",
      "evidence_refs": [],
      "proof_refs": [],
      "publication_wording": "NORMATIVE_DECLARATION",
      "scope": "This is a normative guardrail, not a theorem shared by every ethical system; descriptive viability and normative value remain distinct.",
      "source_refs": [
        "docs/publications/2026-07-31-survival-anschlussfaehigsten/SOURCE_EVIDENCE_BINDINGS.json#docs/publications/2026-07-31-survival-anschlussfaehigsten/EVIDENCE_BOUNDARY.md"
      ],
      "statement": "Greater technical connectability or biological fitness shall not, by itself, be treated as establishing moral preferability.",
      "status": "DECLARED"
    }
