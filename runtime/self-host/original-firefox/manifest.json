{
  "manifest_version": 3,
  "name": "QIKVRT AI Terminal",
  "version": "1.2.0",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/Goldkelch/qik-vrt/*",
    "https://goldkelch.github.io/qik-vrt/*",
    "https://arxiv.org/*",
    "https://*.wikipedia.org/*",
    "https://auth.wikimedia.org/*",
    "http://127.0.0.1:8771/*",
    "http://localhost:8771/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/Goldkelch/qik-vrt/blob/main/AI*",
        "https://goldkelch.github.io/qik-vrt/*"
      ],
      "js": ["content.js"],
      "css": ["terminal.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/Goldkelch/qik-vrt/pull/*/files*"],
      "js": ["review_effect.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arxiv.org/*",
        "https://*.wikipedia.org/*",
        "https://auth.wikimedia.org/*"
      ],
      "js": ["authenticated_delivery.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "qikvrt-ai-terminal@goldkelch.local",
      "strict_min_version": "121.0"
    }
  },
  "default_locale": "en"
}
