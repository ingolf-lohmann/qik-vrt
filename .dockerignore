# The live-build root filesystem contains root-owned paths and is not part
# of the Universal Terminal container source. Keep it out of COPY . builds.
/.build/qikvrt-megast/

# ISO, netboot and Docker release outputs are delivered separately. Do not
# recursively copy generated distribution assets into the container image.
/out/

# Local download caches and credentials are never distribution source inputs.
/.qikvrt/toolchains/
/.git/config
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
