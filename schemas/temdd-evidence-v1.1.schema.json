{
  "$id": "https://temdd.org/schema/1.1/evidence.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEMDD 1.1 Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "temddVersion",
    "evidenceId",
    "transactionId",
    "subjectId",
    "executionId",
    "sourceId",
    "evidenceClass",
    "capturedAt",
    "value"
  ],
  "properties": {
    "temddVersion": {
      "const": "1.1"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "type": "string"
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "E1",
        "E2",
        "E3"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "challengeNonce": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trustDomain": {
      "type": "string"
    },
    "principalId": {
      "type": "string"
    },
    "deviceId": {
      "type": "string"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "calibration": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "ed25519",
            "ecdsa",
            "rsa-pss"
          ]
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
