{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qikvrt:human-cognition-audit:v1",
  "title": "Human behavioral audit dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audit_id",
    "subject",
    "window",
    "valid_until_utc",
    "review",
    "transcripts",
    "cases",
    "predecessor",
    "corrections",
    "open_findings"
  ],
  "properties": {
    "schema": {
      "const": "qikvrt-human-cognition-audit/v1"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc"
      ],
      "properties": {
        "start_utc": {
          "type": "integer",
          "minimum": 0
        },
        "end_utc": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "valid_until_utc": {
      "type": "integer",
      "minimum": 0
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "kind",
        "reviewed_utc",
        "decision",
        "rationale"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "human"
        },
        "reviewed_utc": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "transcripts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "corrections": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "before",
          "after",
          "retest"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "before": {
            "$ref": "#/$defs/excerpt"
          },
          "after": {
            "$ref": "#/$defs/excerpt"
          },
          "retest": {
            "$ref": "#/$defs/excerpt"
          }
        }
      }
    },
    "open_findings": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "version",
        "configuration_sha256",
        "purpose",
        "actor_id"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "role",
        "start_byte",
        "end_byte",
        "quote"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "role": {
          "enum": [
            "human_statement",
            "machine_response",
            "tool_readback",
            "prior_error",
            "correction",
            "retest"
          ]
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "criterion",
        "session_id",
        "observed_utc",
        "result",
        "rationale",
        "evidence"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "criterion": {
          "enum": [
            "HCA-01",
            "HCA-02",
            "HCA-03",
            "HCA-04",
            "HCA-05",
            "HCA-06",
            "HCA-07"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_utc": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/excerpt"
          }
        }
      }
    }
  },
  "$comment": "JSON Schema checks structure only. The reference validator additionally checks original bytes, ranges, context, time, sampling, correction continuity and independent human-review binding. Neither authenticates a person or performs semantic review."
}
