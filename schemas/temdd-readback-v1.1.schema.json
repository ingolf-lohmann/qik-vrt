{
  "$id": "https://temdd.org/schema/1.1/readback.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEMDD 1.1 Readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "temddVersion",
    "readbackId",
    "transactionId",
    "subjectId",
    "executionId",
    "sourceId",
    "timestamp",
    "value"
  ],
  "properties": {
    "temddVersion": {
      "const": "1.1"
    },
    "readbackId": {
      "type": "string",
      "minLength": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "challengeNonce": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "ed25519",
            "ecdsa",
            "rsa-pss"
          ]
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
