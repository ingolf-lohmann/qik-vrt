{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldkelch.github.io/qik-vrt/schemas/temdd-event-v1.schema.json",
  "title": "TEMDD event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "event_type",
    "subject_id",
    "subject_repository",
    "subject_head",
    "subject_tree",
    "producer",
    "timestamp",
    "cause_event_ids",
    "inputs",
    "outputs",
    "evidence_refs",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "temdd_event_v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "REQUEST",
        "EXECUTE",
        "FOLLOW",
        "LEARN",
        "OBSERVATION",
        "VALIDATION",
        "DECISION",
        "EFFECT",
        "READBACK",
        "SUCCESSOR",
        "HOLD"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_repository": {
      "type": "string",
      "minLength": 1
    },
    "subject_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "subject_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "cause_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "FAIL",
        "CONTINUE",
        "HOLD_UNVERIFIED",
        "NONE"
      ]
    }
  }
}
