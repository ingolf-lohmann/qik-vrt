{
  "$id": "https://temdd.org/schema/1.1/effect-certificate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEMDD 1.1 Effect Certificate",
  "type": "object",
  "additionalProperties": false,
  "$comment": "certificateHash is SHA-256 over the RFC 8785 JCS canonical CertificatePayload with certificateHash and signature excluded.",
  "required": [
    "temddVersion",
    "certificateId",
    "transactionId",
    "subjectId",
    "result",
    "policyId",
    "policyDigest",
    "transactionDigest",
    "evidenceSetDigest",
    "acceptanceScopeDigest",
    "evaluationContextDigest",
    "issuedAt",
    "canonicalization",
    "hashAlgorithm",
    "certificateHash",
    "signerId",
    "keyId",
    "signature"
  ],
  "properties": {
    "temddVersion": {
      "const": "1.1"
    },
    "certificateId": {
      "type": "string",
      "minLength": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "const": "EFFECT_ACK_DONE"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transactionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acceptanceScopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluationContextDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalization": {
      "const": "JCS-RFC8785"
    },
    "hashAlgorithm": {
      "const": "SHA-256"
    },
    "certificateHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signerId": {
      "type": "string",
      "minLength": 1
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
