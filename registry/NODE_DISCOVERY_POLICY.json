{
  "qikvrt_event": "OPEN_MULTI_NODE_DISCOVERY_POLICY_4AV1",
  "fixed_node_count": false,
  "node_count_prompt": false,
  "discovery_scope": ["registry/KNOWN_NODE_REQUESTS.tsv", "registry/node_request_queue/*.tsv"],
  "no_global_scanning": true,
  "seed_writes_only_to_seed_repository": true,
  "future_nodes_added_by_queue_rows": true,
  "future_node_split_acceptance": {
    "required_for_queue_rows": true,
    "contract_path": "state/autonomy/WORKFLOW_EXECUTOR_MESH_CONTRACT_V1.json",
    "acceptance_test_path": "tests/test_qikvrt_workflow_executor_mesh_contract.py",
    "seed_validation": "EXACT_NODE_CONTINUITY_RECEIPT_REQUIRED"
  },
  "reflexive_watchdog_acceptance": {
    "required_for_authority_mirror_and_future_nodes": true,
    "contract_path": "state/autonomy/WORKFLOW_EXECUTOR_MESH_CONTRACT_V1.json",
    "workflow_path": ".github/workflows/qikvrt_reflexive_repository_watchdog.yml",
    "controller_path": "tools/qikvrt_reflexive_repository_watchdog.py",
    "acceptance_test_path": "tests/test_qikvrt_reflexive_repository_watchdog.py",
    "maximum_observation_interval": "PT5M",
    "gatewatch_receipt_path": "gatewatch-receipt.json",
    "trusted_gate_matrix": "EXACT_HEAD_ARTIFACT_ONLY",
    "node_liveness": "EXACT_NODE_RECORDS_OR_NOT_APPLICABLE",
    "admission_policy": "PREEMPTIVE_HOLD_BEFORE_SECOND_WRITER",
    "seed_validation": "EXACT_REFLEXIVE_WATCHDOG_CONTRACT_REQUIRED"
  }
}
