{
  "schema": "qikvrt_owner_autonomous_repository_continuation_v2",
  "delegation_id": "OWNER-AUTONOMOUS-REPOSITORY-CONTINUATION-V2",
  "owner": {
    "name": "Ingolf Lohmann",
    "type": "NATURAL_PERSON"
  },
  "effective_at": "2026-08-05T17:13:00+02:00",
  "supersedes_for_new_execution": "OWNER-NO-REINTERACTION-STANDING-DELEGATION-V1",
  "source_instruction": "The repository itself shall contain and operate bounded automations that independently continue objectively determined repository-internal repairs, self-healing and reviewed non-regressing development without repeated owner interaction.",
  "authorization_scope": {
    "state": "ACTIVE",
    "repository_internal_continuation": true,
    "scheduled_observation": true,
    "deterministic_self_healing": true,
    "reviewable_successor_creation": true,
    "semantic_fingerprint_noop_required": true
  },
  "allowed_without_reinteraction": [
    "read_only_repository_and_public_evidence_observation",
    "ai_runtime_bootloader_execution",
    "deterministic_anticipation_projection_materialization",
    "repository_native_integrity_regeneration",
    "bounded_test_and_gate_execution",
    "semantic_fingerprint_bound_branch_creation",
    "draft_pull_request_creation_for_allowlisted_repository_internal_repairs",
    "expected_head_bound_promotion_when_all_declared_conditions_hold",
    "closing_fully_superseded_execution_only_recovery_or_verification_pull_requests_without_merge",
    "append_only_receipt_status_and_work_unit_projection_creation",
    "history_preserving_authority_or_mirror_port_creation"
  ],
  "mandatory_preconditions": [
    "the operation is the smallest deterministic repair of an evidenced blocker or an already declared work unit",
    "all source and target refs are reobserved immediately before mutation",
    "the operation is reversible append_only or isolated on a review branch",
    "the operation cannot weaken evidence rights security effect or claim boundaries",
    "no mutation occurs when the semantic fingerprint is unchanged",
    "all applicable exact_head gates remain mandatory",
    "every generated candidate remains reviewable and must preserve history"
  ],
  "not_authorized": [
    "zenodo_create_upload_metadata_mutation_or_publication",
    "ietf_datatracker_submission_resubmission_or_metadata_mutation",
    "github_release_or_tag_creation",
    "deployment_to_an_external_runtime",
    "financial_legal_medical_physical_or_actuator_effects",
    "force_push_or_history_rewrite",
    "unconditional_automatic_merge_or_unbound_promotion",
    "automatic_branch_protection_change",
    "claiming_repository_wide_PASS_FINAL_PASS_EFFECT_ACK_DONE_synchronization_or_symmetric_canonicality"
  ],
  "external_effect_policy": {
    "default": "FORBIDDEN",
    "required_override": "separate exact artifact hash scope and natural_person authorization",
    "no_retroactive_authorization": true
  },
  "promotion_policy": {
    "unconditional_automatic_merge": "FORBIDDEN",
    "expected_head_bound_promotion": "ALLOWED_ONLY_IF",
    "conditions": [
      "CURRENT_BASE_REOBSERVED",
      "HEAD_UNCHANGED",
      "DIFF_ALLOWLISTED",
      "NO_EXTERNAL_EFFECT",
      "ALL_APPLICABLE_GATES_TERMINAL_GREEN",
      "NO_COMPETING_WRITER"
    ],
    "requires_existing_repository_bound_promotion_contract": true,
    "standing_delegation": true,
    "general_auto_merge_authorization": false
  },
  "revocation": {
    "revocable": true,
    "method": "append a later owner decision naming this delegation_id and setting state to REVOKED"
  },
  "completion_claims": {
    "PASS": false,
    "FINAL_PASS": false,
    "EFFECT_ACK_DONE": false,
    "FULL_SYNC": false,
    "SYMMETRIC_CANONICALITY": false
  }
}
