{
  "schema": "qikvrt_owner_requested_review_and_issue_lifecycle_v1",
  "delegation_id": "OWNER-REQUESTED-REVIEW-AND-ISSUE-LIFECYCLE-V1",
  "state": "ACTIVE",
  "owner": {
    "name": "Ingolf Lohmann",
    "role": "Product Owner",
    "type": "NATURAL_PERSON"
  },
  "effective_at": "2026-08-10T19:06:59+02:00",
  "repositories": [
    "Goldkelch/qik-vrt",
    "ingolf-lohmann/qik-vrt"
  ],
  "source_instructions": [
    {
      "text": "In Zukunft führst du angeforderte Reviews selbstständig, zügigst durch, sage ich, Ingolf Lohmann, als dein Product Owner. Persistiere dieses Verhalten in den Repositories als allgemeine Regel.",
      "sha256": "71dcbd2a5b632edb2f06d9c928dd47fc9bbb750866a050a6849ed4eb28efa423"
    },
    {
      "text": "Das Gleiche gilt für eingetragene Issues in den GitHub Repositories. Das ist inakzeptabel, dass da Issues für längere Zeit offen sind. Entweder werden die abgearbeitet, wenn sie abarbeitbar sind, oder konkretisiert, wenn sie unklar sind, oder geschlossen, wenn sie nicht nachvollziehbar sind, oder unzutreffend.",
      "sha256": "3abc571cb2760480fe976b4059672804e2a3e00946fba62345fb1fbb7de675dd"
    }
  ],
  "combined_source_sha256": "1f66e77ab105f24c95c4d275e1deab5cc97aa0dcc896a1c833fb12cafd06eec6",
  "policy": "policy/REQUESTED_REVIEW_AND_ISSUE_LIFECYCLE_V1.json",
  "human_contract": "docs/REQUESTED_REVIEW_AND_ISSUE_LIFECYCLE.md",
  "authorization_scope": {
    "perform_requested_substantive_reviews_without_reinteraction": true,
    "persist_exact_head_review_findings": true,
    "record_product_owner_review_disposition": true,
    "triage_every_observed_open_issue": true,
    "execute_clear_supported_actionable_issues": true,
    "request_minimum_bounded_clarification": true,
    "close_completed_not_planned_invalid_or_unsupported_issues_with_reason": true,
    "persist_blocker_and_single_next_action": true
  },
  "allowed_without_reinteraction": [
    "read_and_compare_pull_request_base_head_tree_diff_comments_reviews_threads_and_exact_head_gates",
    "perform_and_record_a_substantive_technical_review",
    "record_APPROVE_REQUEST_CHANGES_or_COMMENT_WITH_BLOCKER_findings_when_supported_by_evidence",
    "record_a_product_owner_approval_disposition_when_the_platform_rejects_author_self_approval",
    "read_classify_comment_label_assign_update_or_close_an_issue_with_an_evidence_bound_lifecycle_disposition",
    "execute_the_smallest_deterministic_repository_internal_issue_work_unit",
    "ask_one_or_more_strictly_bounded_clarifications_only_when_required_fields_are_missing",
    "close_an_issue_as_completed_not_planned_invalid_or_unsupported_when_the_reason_is_reproducible_and_recorded"
  ],
  "mandatory_preconditions": [
    "repository_and_current_refs_are_reobserved_immediately_before_mutation",
    "review_disposition_is_bound_to_exact_base_head_tree_and_scope",
    "issue_disposition_is_bound_to_the_current_issue_body_comments_repository_state_and_evidence",
    "head_drift_or_material_scope_drift_invalidates_stale_review_evidence",
    "closure_preserves_discussion_provenance_and_a_concise_reason",
    "ambiguous_or_unverifiable_requests_are_not_silently_closed_as_invalid",
    "all_applicable_security_rights_scientific_and_external_effect_boundaries_remain_fail_closed"
  ],
  "not_authorized": [
    "impersonating_Goldkelch_ingolf_lohmann_or_any_other_GitHub_identity",
    "claiming_an_account_level_APPROVED_state_that_GitHub_did_not_record",
    "fabricating_review_findings_issue_evidence_measurements_credentials_or_external_authorization",
    "closing_an_issue_to_hide_a_real_unresolved_defect_or_avoid_actionable_work",
    "merge_release_deployment_Zenodo_DOI_or_IETF_effect_without_the_separately_required_authorization_and_gates",
    "force_push_history_rewrite_branch_protection_weakening_or_unbound_promotion",
    "claiming_PASS_FINAL_PASS_EFFECT_ACK_DONE_or_full_Authority_Mirror_synchronization_without_complete_evidence"
  ],
  "platform_identity_rule": {
    "natural_person_control_may_be_recorded": true,
    "api_signer_is_the_platform_actor": true,
    "GitHub_self_approval_rejection_must_be_reported_exactly": true,
    "substantive_product_owner_disposition_does_not_equal_independent_account_approval": true
  },
  "revocation": {
    "revocable": true,
    "method": "append a later owner decision naming this delegation_id and setting state to REVOKED"
  },
  "completion_claims": {
    "PASS": false,
    "FINAL_PASS": false,
    "EFFECT_ACK_DONE": false,
    "FULL_AUTHORITY_MIRROR_SYNCHRONIZATION": false
  }
}
