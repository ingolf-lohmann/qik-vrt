{
  "schema": "qikvrt_autonomous_self_healing_contract_v1",
  "contract_id": "qikvrt-autonomous-self-healing-v1",
  "authority_entrypoint": "AI",
  "delegation_path": "state/authorization/delegations/OWNER_AUTONOMOUS_REPOSITORY_CONTINUATION_V2.json",
  "controller_path": "tools/qikvrt_autonomous_self_heal.py",
  "workflow_path": ".github/workflows/qikvrt_autonomous_self_heal.yml",
  "execution_model": {
    "observation": "scheduled_or_manual",
    "mutation": "review_branch_only",
    "promotion": "expected_head_bound_only",
    "unchanged_semantic_fingerprint": "NOOP",
    "unchanged_semantic_fingerprint_scope": "CANDIDATE_BYTES_ONLY_NOT_PENDING_MATERIALIZATION"
  },
  "promotion_policy": {
    "unconditional_automatic_merge": "FORBIDDEN",
    "expected_head_bound_promotion": "ALLOWED_ONLY_IF",
    "conditions": [
      "CURRENT_BASE_REOBSERVED",
      "HEAD_UNCHANGED",
      "DIFF_ALLOWLISTED",
      "NO_EXTERNAL_EFFECT",
      "ALL_APPLICABLE_GATES_TERMINAL_GREEN",
      "NO_COMPETING_WRITER"
    ],
    "requires_existing_repository_bound_promotion_contract": true,
    "proposal_workflow_may_merge": false,
    "general_auto_merge_authorization": false
  },
  "promotion_executor": {
    "decision_path": "tools/qikvrt_expected_head_promotion.py",
    "workflow_path": ".github/workflows/qikvrt_expected_head_promotion.yml",
    "test_path": "tests/test_qikvrt_expected_head_promotion.py",
    "opt_in_marker": "<!-- qikvrt-expected-head-promotion:enabled external_effect=NONE -->",
    "maximum_candidates_per_run": 1,
    "schedule_fallback": "*/10 * * * *",
    "workflow_run_reobservation": true,
    "two_phase_promotion": [
      "DRAFT_TO_READY",
      "STOP_AND_REOBSERVE",
      "EXPECTED_HEAD_BOUND_MERGE"
    ],
    "merge_binding": "GITHUB_PULL_MERGE_REST_SHA_PRECONDITION",
    "old_action_required_may_be_superseded_by_newer_same_workflow_success": true,
    "same_head_verification_proxy_is_competing_writer": false,
    "stale_base_pull_request_is_current_competing_writer": false,
    "current_base_overlapping_pull_request_is_competing_writer": true,
    "external_effect": "FORBIDDEN",
    "completion_claims": {
      "PASS": false,
      "FINAL_PASS": false,
      "EFFECT_ACK_DONE": false,
      "AUTHORITY_MIRROR_EQUALITY": false
    }
  },
  "promotion_gate_order": [
    "NEW_CURRENT_MAIN_DRAFT",
    "REPOSITORY_NATIVE_INTEGRITY_MATERIALIZATION",
    "EXACT_HEAD_GATES",
    "EXPECTED_HEAD_BOUND_PROMOTION"
  ],
  "pull_request_continuation": {
    "workflow_path": ".github/workflows/qikvrt_autonomous_pr_continuation.yml",
    "opt_in_marker": "<!-- qikvrt-autonomous-self-heal:enabled -->",
    "same_repository_only": true,
    "draft_only": true,
    "merge_current_main_before_repair": true,
    "maximum_pull_requests_per_run": 1,
    "history_rewrite": "FORBIDDEN",
    "post_repair_verification": [
      "python3 -B tools/qikvrt_publication_overview.py check",
      "python3 -B tools/qikvrt_integrity.py verify",
      "python3 -B -m unittest -v tests.test_qikvrt_publication_overview tests.test_qikvrt_autonomous_self_heal tests.test_qikvrt_expected_head_promotion",
      "make test"
    ],
    "external_gates": [
      "IDENTIFIED_HUMAN_PHYSICS_REVIEW_WHEN_REQUIRED",
      "SEPARATE_EXPLICIT_ZENODO_AUTHORIZATION"
    ],
    "automatic_promotion": "TWO_PHASE_EXPECTED_HEAD_BOUND_ONLY"
  },
  "workflow_executor_mesh_continuity": {
    "contract_path": "state/autonomy/WORKFLOW_EXECUTOR_MESH_CONTRACT_V1.json",
    "controller_path": "tools/qikvrt_workflow_executor.py",
    "executor_workflow_path": ".github/workflows/qikvrt_workflow_executor.yml",
    "watchdog_workflow_path": ".github/workflows/qikvrt_workflow_executor_watchdog.yml",
    "node_split_acceptance": "QUEUE_ROWS_REQUIRE_EXACT_NODE_CONTINUITY_RECEIPT",
    "external_effect": "FORBIDDEN"
  },
  "allowlisted_handlers": [
    {
      "failure_class": "ANTICIPATION_PROJECTION_DRIFT",
      "probe": [
        "python3",
        "-B",
        "tools/qikvrt_anticipation.py",
        "check"
      ],
      "repair": [
        "python3",
        "-B",
        "tools/qikvrt_anticipation.py",
        "materialize"
      ],
      "failure_signature": "projection drift:",
      "mutable_paths": [
        "anticipation/current.json",
        "anticipation/history.jsonl",
        "anticipation/trends.json",
        "anticipation/derivatives.json",
        "anticipation/next-effect.json",
        "receipts/anticipation/0001-contract-bound.json",
        "receipts/anticipation/0002-anticipation-materialized.json"
      ]
    },
    {
      "failure_class": "PUBLICATION_OVERVIEW_DRIFT",
      "probe": [
        "python3",
        "-B",
        "tools/qikvrt_publication_overview.py",
        "check"
      ],
      "repair": [
        "python3",
        "-B",
        "tools/qikvrt_publication_overview.py",
        "materialize"
      ],
      "failure_signature": "publication overview drift:",
      "mutable_paths": [
        "docs/publications/index.json",
        "docs/publications/index.html"
      ]
    },
    {
      "failure_class": "REPOSITORY_NATIVE_INTEGRITY_STALE",
      "probe": [
        "python3",
        "-B",
        "tools/qikvrt_integrity.py",
        "verify"
      ],
      "repair": [
        "python3",
        "-B",
        "tools/qikvrt_integrity.py",
        "generate"
      ],
      "mutable_paths": [
        "REPOSITORY_FILE_MANIFEST.json",
        "REPOSITORY_FILE_MANIFEST.json.sha256",
        "SHA256SUMS.txt"
      ]
    }
  ],
  "mandatory_gates": [
    [
      "python3",
      "-B",
      "tools/ai_runtime_bootloader.py",
      "--profile",
      "all",
      "--json"
    ],
    [
      "python3",
      "-B",
      "tools/qikvrt_anticipation.py",
      "check"
    ],
    [
      "python3",
      "-B",
      "tools/qikvrt_publication_overview.py",
      "check"
    ],
    [
      "python3",
      "-B",
      "tools/qikvrt_integrity.py",
      "verify"
    ],
    [
      "python3",
      "-B",
      "-m",
      "unittest",
      "-v",
      "tests.test_qikvrt_publication_overview",
      "tests.test_qikvrt_autonomous_self_heal",
      "tests.test_qikvrt_expected_head_promotion"
    ]
  ],
  "forbidden_effects": [
    "unconditional_automatic_merge",
    "unbound_or_stale_head_promotion",
    "force_push",
    "tag_or_release_creation",
    "deployment",
    "zenodo_mutation",
    "ietf_mutation",
    "credentialed_external_write",
    "repository_wide_completion_claim"
  ],
  "candidate_contract": {
    "branch_prefix": "automation/self-heal-",
    "pull_request_mode": "draft",
    "deduplicate_by": "base_revision_and_semantic_fingerprint",
    "no_diff": "NOOP",
    "all_paths_must_be_allowlisted": true,
    "proposal_workflow_may_merge": false,
    "promotion_executor_may_merge": "ONLY_AFTER_TWO_PHASE_EXACT_HEAD_REOBSERVATION",
    "materialization": {
      "implementation": "tools/qikvrt_self_heal_pr_materializer.py",
      "test": "tests/test_qikvrt_self_heal_pr_materializer.py",
      "completion_predicate": "EXACT_CURRENT_BASE_HEAD_TREE_PR_READBACK",
      "existing_branch_without_pr": "RESUME_MISSING_POSTCONDITION",
      "existing_exact_open_pr": "READ_ONLY_NOOP",
      "closed_duplicate_or_mismatched_pr": "HOLD_WITHOUT_REOPEN_OR_REPLACEMENT",
      "ref_creation": "REST_CREATE_ONLY",
      "ambiguous_write": "REOBSERVE_WITHOUT_BLIND_RETRY",
      "maximum_pr_create_attempts_per_run": 1,
      "credential_route": "EXISTING_QIKVRT_MESH_TOKEN_OR_GITHUB_TOKEN",
      "automatic_permission_change": false,
      "self_approval": false,
      "unchanged_blocker_notification": "SUPPRESS_BY_TRANSITION_FINGERPRINT",
      "completion_claims": {
        "PREDECESSOR_EVIDENCE_TRANSFER": false,
        "EFFECT_ACK_DONE": false
      },
      "draft_continuation_opt_in": "<!-- qikvrt-autonomous-self-heal:enabled -->",
      "requires_repeated_chat_authorization": false,
      "legacy_draft_handoff_repair": "ONE_BODY_ONLY_PATCH_ON_VERIFIED_EXACT_INTERNAL_CANDIDATE_WITH_FRESH_READBACK"
    }
  },
  "completion_claims": {
    "PASS": false,
    "FINAL_PASS": false,
    "EFFECT_ACK_DONE": false,
    "FULL_SYNC": false,
    "SYMMETRIC_CANONICALITY": false
  },
  "same_repository_writer_postconditions": {
    "implementation": "tools/qikvrt_pipeline_contracts.py",
    "workflow_paths": [
      ".github/workflows/qikvrt_autonomous_self_heal.yml",
      ".github/workflows/qikvrt_autonomous_pr_continuation.yml",
      ".github/workflows/qikvrt_ci.yml",
      ".github/workflows/qikvrt_batch04_integrity.yml",
      ".github/workflows/qikvrt_batch003_remaining_disposition.yml",
      ".github/workflows/qikvrt_versioned_corrected_candidates.yml",
      ".github/workflows/qikvrt_global_completion.yml",
      ".github/workflows/qikvrt_pr18_integrity_repair.yml",
      ".github/workflows/qikvrt_proof_persistence_integrity.yml",
      ".github/workflows/qikvrt_escape_stages_integrity.yml",
      ".github/workflows/qikvrt_physics_bridge_integrity.yml",
      ".github/workflows/issue-autonomous-processing.yml"
    ],
    "chain": [
      "OBSERVE_EXACT_SOURCE_AND_BASE",
      "NON_FORCE_BRANCH_WRITE_AND_READBACK",
      "EXACT_OPEN_DRAFT_PR_READBACK",
      "EXISTING_EXACT_HEAD_VERIFIER_RUN_READBACK"
    ],
    "helpers": [
      "observe_writer",
      "push_postcondition",
      "draft_postcondition",
      "candidate_postcondition",
      "publish_writer",
      "resume"
    ],
    "staging_base": "PRESERVE_EXACT_NATIVE_TARGET_VERIFY_READ_ONLY_NO_MAIN_CONTINUATION_OPT_IN",
    "main_writer": "ISOLATE_CHANGED_BYTES_ON_BASE_TREE_BOUND_REVIEW_BRANCH",
    "byte_noop": "RESUME_MISSING_PR_OR_VERIFIER_POSTCONDITION_ON_EXISTING_REVIEW_BRANCH",
    "write_transport": "INDEPENDENT_READBACK_AFTER_DENIAL_LOSS_MALFORMED_OR_MISLEADING_RESPONSE",
    "ready_closed_foreign_mismatched_or_competing_candidate": "HOLD_NO_WRITE",
    "attempt_bounds": {
      "branch_push": 1,
      "pr_create": 1,
      "body_patch": 1,
      "verifier_dispatch": 1
    },
    "new_scheduler": false,
    "new_executor": false,
    "automatic_permission_change": false,
    "self_approval": false,
    "promotion_marker_added_by_generic_writers": false,
    "required_acceptance": "NATIVE_REVIEW_GOVERNANCE_AND_EXTERNAL_EFFECT_GATES_UNCHANGED",
    "notification": "DEDUPLICATE_SEMANTIC_TRANSITION_FINGERPRINT",
    "exactly_once_under_arbitrary_concurrency_or_visibility_delays_claimed": false,
    "EFFECT_ACK_DONE": false
  }
}
