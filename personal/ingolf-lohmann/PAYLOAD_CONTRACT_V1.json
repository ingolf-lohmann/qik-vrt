{
  "schema": "qikvrt_personal_payload_contract_v1",
  "owner": "Ingolf Lohmann",
  "status": "NORMATIVE_PERSONAL_MIRROR_EXTENSION",
  "purpose": "Versioned provenance-bound personal payload in the Mirror without weakening Authority/Mirror evidence separation.",
  "root": "personal/ingolf-lohmann",
  "semantics": {
    "mirror_is_personal_payload_authority_for_owner_material": true,
    "authority_repository_not_implicitly_modified": true,
    "append_or_supersede_not_silent_rewrite": true,
    "mutation_creates_successor": true,
    "predecessor_evidence_transfer": false,
    "multiple_epistemic_classes_may_coexist": true,
    "uncertainty_must_be_preserved_not_collapsed": true,
    "personal_quote_requires_owner_attribution": true,
    "audio_quote_requires_exact_audio_provenance": true,
    "time_place_require_explicit_provenance": true,
    "personal_authorization_not_global_personal_data_release": true
  },
  "epistemic_classes": [
    "OWNER_STATEMENT",
    "ENGINEERING_HYPOTHESIS",
    "SCIENTIFIC_HYPOTHESIS",
    "OBSERVATION",
    "PROOF_EVIDENCE",
    "OPEN_INTERPRETATION"
  ],
  "audio": {
    "request_path": "requests/audio/",
    "workflow": ".github/workflows/qikvrt_audio_request.yml",
    "raw_audio_committed_by_default": false,
    "transcription_requires_byte_hash_binding": true,
    "spoken_content_must_not_be_invented": true,
    "human_countercheck_required_for_content_release": true
  },
  "digital_twin": {
    "contract": "policy/QIKVRT_DIGITAL_TWIN_REST_CONTRACT_V1.json",
    "mesh_contract": "policy/QIKVRT_ETHICAL_EVOLUTIONARY_DIGITAL_TWIN_MESH_V1.json",
    "peer_repository": "Goldkelch/qik-vrt",
    "peer_state_is_not_authority": true,
    "transport_ack_not_effect_ack": true
  },
  "completion_claims": {
    "PERSONAL_PAYLOAD_PATH_DEFINED": true,
    "AUDIO_CONTENT_BOUND": false,
    "EFFECT_ACK_DONE": false
  },
  "media": {
    "universal_payload_classes": [
      "text",
      "audio",
      "video",
      "image",
      "binary",
      "structured_data",
      "other_hash_bound_payload"
    ],
    "rule": "Any payload class may be admitted only with explicit provenance, rights/privacy checks, bounded identity and successor semantics.",
    "audio_video_content_requires_exact_provenance": true,
    "time_place_require_explicit_provenance": true,
    "payload_type_does_not_upgrade_claim_truth": true
  },
  "bidirectionality": {
    "engineering_scope": "Authority/Mirror and Universal Terminal/Transputer interfaces may support bidirectional information exchange between versioned states.",
    "temporal_claim_boundary": "Bidirectional exchange across versioned repository/history states does not by itself prove physical backward-in-time information transfer.",
    "physical_time_corridor_claim": "OPEN_HYPOTHESIS_REQUIRES_SEPARATE_EMPIRICAL_EVIDENCE"
  },
  "ethical_neutral_zone": {
    "owner_principle": "QIK-VRT should preserve responsibility, provenance, admissibility and effect-readback boundaries rather than silently deciding the human purpose of an effect.",
    "categorical_imperative_reference": "OWNER_NORMATIVE_ENGINEERING_PRINCIPLE",
    "responsibility_not_eliminated": true
  }
}
