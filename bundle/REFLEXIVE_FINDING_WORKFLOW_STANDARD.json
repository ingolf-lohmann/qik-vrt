{
  "id": "QALL_REFLEXIVE_FINDING_WORKFLOW_STANDARD",
  "status": "IMPLEMENTED",
  "standard_rule": "If the delivered bundle does not work immediately for the user, every finding is a reflexive error class.",
  "applies_to_events": [
    "DOWNLOAD",
    "UNZIP",
    "START",
    "CONFIGURATION",
    "LICENSE_ACCEPTANCE",
    "COUNTERPARTY_TYPE_CLASSIFICATION",
    "OTHER_COUNTERPARTY_DESCRIPTION",
    "LOGGING",
    "LOCAL_REPRODUCTION",
    "GITHUB_PERSISTENCE",
    "TEMPLATE_USE",
    "CLONE",
    "MERGE",
    "REUSE"
  ],
  "mandatory_correction_layers": [
    "ROOT_DELIVERY_STRUCTURE",
    "PAYLOAD",
    "INTERNAL_SCRIPTS",
    "WINDOWS",
    "LINUX",
    "MACOS",
    "GITHUB_PERSISTENCE_PATH",
    "TEMPLATE_CLONE_DOWNLOAD_USE_MERGE_PRESERVATION",
    "LICENSE_COPYRIGHT_GUARD",
    "STRICT_ACCEPTANCE_GATE",
    "STRICT_COUNTERPARTY_TYPE_GATE",
    "OTHER_COUNTERPARTY_DESCRIPTION_GATE",
    "POLICY",
    "MAP",
    "LEARN",
    "ACCEPT",
    "SYNC",
    "REPORTS",
    "TESTS"
  ],
  "forbidden_fix_classes": [
    "ISOLATED_HOTFIX",
    "LINUX_ONLY_FIX_WHEN_CROSS_PLATFORM_RELEVANT",
    "UNMIRRORED_WINDOWS_MACOS_GITHUB_CLONE_FIX",
    "FALSE_PASS_AFTER_LOCAL_ONLY_PATCH",
    "UNPERSISTED_LEARNING",
    "SOFTWARE_DOWNGRADE_AS_ERROR_CORRECTION",
    "UNVERIFIED_CAUSAL_DIAGNOSIS",
    "PERSONAL_PREFERENCE_RECLASSIFICATION_OF_QIKVRT_STANDARD"
  ],
  "required_process": [
    "NAME_FINDING",
    "CLASSIFY_AS_REFLEXIVE_ERROR_CLASS",
    "LOCATE_CAUSE",
    "CORRECT_ALL_RELEVANT_LAYERS",
    "MIRROR_WINDOWS_LINUX_MACOS_WHERE_RELEVANT",
    "UPDATE_GITHUB_TEMPLATE_CLONE_MERGE_PRESERVATION",
    "UPDATE_LICENSE_AND_ACCEPTANCE_GATES_IF_RELEVANT",
    "UPDATE_POLICY_MAP_LEARN_ACCEPT_SYNC_REPORTS",
    "RUN_TESTS",
    "DELIVER_ONLY_ON_PASS"
  ],
  "blocker_error_class": "USER_TEST_FINDING_NOT_REFLEXIVELY_CORRECTED",
  "release_rule": "No new bundle release after a user finding unless the reflexive workflow record and all relevant layer corrections are persisted.",
  "bilingual_ui_user_info_standard": {
    "id": "QALL_BILINGUAL_UI_USER_INFO_STANDARD",
    "status": "IMPLEMENTED",
    "languages": [
      "de",
      "en"
    ],
    "rule": {
      "de": "Alle interaktiven Benutzeroberflächen und alle nutzergerichteten Bundle-Informationen müssen zweisprachig Deutsch/Englisch sein.",
      "en": "All interactive user interfaces and all user-facing bundle information must be bilingual German/English."
    },
    "applies_to": [
      "WINDOWS.bat messages",
      "LINUX.sh messages",
      "MACOS.command messages",
      "RUN.sh prompts",
      "RUN.ps1 prompts",
      "README.md",
      "NOTICE",
      "QALL.ini comments",
      "license acceptance notices",
      "counterparty type notices",
      "OTHER description prompts",
      "block/done messages",
      "user-facing logs/status explanations"
    ],
    "machine_artifact_boundary": {
      "de": "Maschinenlesbare JSON-/Manifest-Artefakte dürfen technisch bleiben, müssen aber für nutzerrelevante Aussagen zweisprachige Begleitinformationen tragen.",
      "en": "Machine-readable JSON/manifest artifacts may remain technical, but user-relevant statements must carry bilingual companion information."
    },
    "blocker_error_class": "USER_FACING_TEXT_NOT_BILINGUAL_DE_EN",
    "preserve_in_clones_download_use_merge": true
  },
  "user_facing_text_must_be_bilingual_de_en": true,
  "bilingual_ui_inheritance_gate": {
    "id": "QALL_BILINGUAL_UI_INHERITANCE_GATE",
    "status": "IMPLEMENTED",
    "property": "BILINGUAL_UI_USER_INFO_DE_EN",
    "inheritance_required": true,
    "must_be_inherited_by": [
      "CLONE",
      "DOWNLOAD",
      "FORK",
      "TEMPLATE_INSTANCE",
      "MERGE",
      "RELEASE",
      "REPACKAGE",
      "BUILD_ARTIFACT",
      "LOCAL_REPRODUCTION",
      "GITHUB_PERSISTENCE_OUTPUT",
      "REPOSITORY_PAYLOAD",
      "FOLLOW_UP_BUNDLE"
    ],
    "required_files": [
      "BILINGUAL_UI_USER_INFO_STANDARD.json",
      "BILINGUAL_UI_USER_INFO_STANDARD.md",
      "BILINGUAL_UI_INHERITANCE_GATE.json",
      "BILINGUAL_UI_INHERITANCE_GATE.md"
    ],
    "required_user_facing_languages": [
      "de",
      "en"
    ],
    "blocker_error_classes": [
      "BILINGUAL_UI_INHERITANCE_MISSING",
      "DERIVED_ARTIFACT_USER_INFO_NOT_BILINGUAL_DE_EN",
      "CLONE_OR_MERGE_DROPPED_BILINGUAL_UI_STANDARD"
    ],
    "release_rule": "No derived artifact may be released unless bilingual DE/EN UI and user-information inheritance is preserved."
  },
  "derived_artifacts_must_inherit_bilingual_ui_de_en": true,
  "official_license_refresh_and_file_enrichment_gate": {
    "id": "QALL_OFFICIAL_LICENSE_REFRESH_AND_FILE_ENRICHMENT_GATE",
    "status": "IMPLEMENTED",
    "official_license_sources": {
      "Apache-2.0": {
        "url": "https://www.apache.org/licenses/LICENSE-2.0.txt",
        "target_file": "LICENSES/Apache-2.0.txt",
        "applies_to": "software/script/source-code components"
      },
      "CC-BY-NC-ND-4.0": {
        "url": "https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode.txt",
        "target_file": "LICENSES/CC-BY-NC-ND-4.0.txt",
        "applies_to": "non-software QIK-VRT content, documentation, policy, mapping, learning and bundle user information"
      }
    },
    "refresh_before_repository_persistence": true,
    "refresh_overwrites_existing_license_files": true,
    "block_if_official_license_refresh_fails_before_persistence": true,
    "all_files_must_be_enriched_or_manifest_covered_before_persistence": true,
    "source_code_requires_embedded_spdx_copyright_marker": true,
    "non_source_files_require_embedded_or_manifest_license_assignment": true,
    "binary_payloads_require_manifest_coverage": true,
    "preserve_in_clones_download_use_merge": true,
    "blocker_error_classes": [
      "OFFICIAL_LICENSE_REFRESH_FAILED",
      "OFFICIAL_LICENSE_FILE_NOT_OVERWRITTEN",
      "FILE_LICENSE_ENRICHMENT_MISSING",
      "SOURCE_FILE_WITHOUT_SPDX_OR_COPYRIGHT",
      "PERSISTENCE_WITH_STALE_LICENSE_FILE"
    ]
  },
  "official_license_files_overwrite_local_copies_before_persistence": true,
  "all_files_enriched_or_manifest_covered_before_persistence": true,
  "qikvrt_file_license_notice": {
    "spdx_license_identifier": "CC-BY-NC-ND-4.0",
    "copyright": "Copyright (c) 2026 Ingolf Lohmann.",
    "urheber_rechteinhaber": "Ingolf Lohmann",
    "vererbung_erforderlich": true,
    "kuenftige_outputs_benoetigen_header_oder_manifestabdeckung": true
  },
  "evidence_based_repair_standard": {
    "id": "QIKVRT_STANDARD_EVIDENCE_BASED_REPAIR_WITHOUT_DOWNGRADE_V1",
    "classification": "QIKVRT_STANDARD_WORKING_RULE",
    "normative_status": "REQUIRED",
    "personal_preference": false,
    "owner_clarification": {
      "actor": "Ingolf Lohmann",
      "role": "PRODUCT_AND_CODE_OWNER",
      "date": "2026-09-21",
      "rule_de": "Das ist die Standard-Arbeitsregel bei QIKVRT."
    },
    "scope": [
      "HUMAN_CONTRIBUTORS",
      "AI_CLIENTS",
      "AGENTS",
      "TOOLS",
      "WORKFLOWS",
      "AUTHORITY",
      "MIRROR",
      "DERIVED_MESH_ARTIFACTS",
      "AUTHORIZED_HANDOFFS"
    ],
    "software_downgrade_as_error_correction": "FORBIDDEN",
    "repair_direction": [
      "EVIDENCE_BASED_REPAIR",
      "JUSTIFIED_PATCH",
      "COMPATIBLE_UPGRADE"
    ],
    "required_evidence_separation": [
      "OBSERVED_SYMPTOM",
      "THIRD_PARTY_REPORT",
      "MAINTAINER_CONFIRMED_DEFECT",
      "CAUSE_ESTABLISHED_FOR_AFFECTED_SYSTEM"
    ],
    "diagnostic_contract": {
      "bind_actual_version_build_environment_and_available_log_or_reproduction": true,
      "bind_head_and_tree_for_repository_claims": true,
      "matching_error_codes_establish_same_cause": false,
      "official_issue_tracker_location_establishes_confirmed_cause": false,
      "mark_hypotheses_and_unknowns_explicitly": true,
      "bounded_authorized_diagnostics_before_causal_closure": "ALLOWED",
      "larger_version_number_establishes_repair": false,
      "verify_originally_failing_operation_after_change": true,
      "separate_planned_prepared_executed_and_verified": true
    },
    "inheritance": {
      "preserve_in": [
        "CLONE",
        "FORK",
        "TEMPLATE",
        "DOWNLOAD",
        "BUILD_ARTIFACT",
        "REPACKAGE",
        "MERGE",
        "REUSE",
        "AUTHORIZED_MESH_HANDOFF"
      ],
      "destination_adoption_requires_exact_readback": true,
      "unobserved_propagation_must_not_be_claimed": true
    },
    "temdd": "Apply existing T1-T16 without renumbering or weakening them.",
    "effect_boundary": {
      "normative_rule_is_not_runtime_repair": true,
      "standard_persistence_is_not_main_promotion": true,
      "publication_deployment_or_unrelated_mutation_authorized": false,
      "all_mesh_nodes_already_updated": false
    },
    "enforcement_scope": "Normative workflow and bootstrap contract; this declaration alone is not evidence of universal automatic runtime enforcement."
  }
}
