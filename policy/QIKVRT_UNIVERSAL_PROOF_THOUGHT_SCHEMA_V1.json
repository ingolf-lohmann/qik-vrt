  "fail_closed_rules": [
    "Reject output with missing or mismatched canonical article binding.",
    "Reject output whose claim kind is absent or unknown.",
    "Reject promotion from FORMAL_THEOREM to EMPIRICAL_CLAIM without separately bound empirical evidence.",
    "Reject physical qualification without reference binding, operationalization, evidence, known-limit recovery, distinctive prediction and independent validation when such qualification is claimed.",
