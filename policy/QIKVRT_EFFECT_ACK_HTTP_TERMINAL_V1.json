{
  "schema": "qikvrt_effect_ack_http_terminal_v1",
  "version": "1.1",
  "status": "PRODUCT_OWNER_AUTHORIZED_CANDIDATE",
  "authority_repository": "ingolf-lohmann/qik-vrt",
  "core_specification": "external/ietf/draft-lohmann-qikvrt-effect-ack-03.xml",
  "http_extension_specification": "external/ietf/draft-lohmann-qikvrt-effect-ack-http-00.xml",
  "invariants": {
    "transport_ack_is_not_effect_authorization": true,
    "ordinary_release_only_after_valid_done": true,
    "prepare_never_executes_protected_effect": true,
    "commit_requires_exact_bound_single_use_token": true,
    "post_effect_reobservation_required_when_observable": true,
    "rendering_is_not_authorization": true,
    "audio_capture_requires_explicit_user_gesture": true,
    "video_capture_requires_explicit_user_gesture": true,
    "media_not_transmitted_until_explicit_submit": true,
    "personalization_is_local_by_default": true,
    "proxy_must_preserve_source_and_hash_bindings": true
  },
  "terminal": {
    "mode": "INTERACTIVE_TERMINAL",
    "reference_client": "FIREFOX_WEBEXTENSION_MV3",
    "entrypoint_match": "https://github.com/ingolf-lohmann/qik-vrt/blob/main/AI*",
    "text": true,
    "audio": "EXPLICIT_CAPTURE_AND_SUBMIT",
    "video": "EXPLICIT_PREVIEW_SNAPSHOT_AND_SUBMIT",
    "personalization": [
      "accent",
      "font_scale",
      "density",
      "panel_position"
    ],
    "counterpart": "QIKVRT_REPOSITORY_BACKEND_ADAPTER",
    "default_external_effect": "NONE"
  },
  "fill_from_sources": {
    "scope": "USER_CONFIRMED_DOM_ENTRY_NOT_PROTECTED_BACKEND_EFFECT",
    "implementation": "browser/firefox/qikvrt-terminal/options.js",
    "inputs": ["USER_SELECTED_FLAT_JSON", "USER_SELECTED_LABEL_VALUE_LINES"],
    "source_transport": "EXPLICIT_SELECTION_OR_MANUAL_IMPORT",
    "source_storage": "BROWSER_STORAGE_SESSION_MEMORY_ONLY",
    "source_revision": "SHA256_OF_SELECTED_UTF8_BYTES",
    "matching": "EXACT_NORMALIZED_UNICODE_KEY_NO_SEMANTIC_TRANSLATION",
    "region_filter": false,
    "required_model_provider": null,
    "model_requests": 0,
    "all_urls_permission": false,
    "access": "ACTIVE_TAB_USER_ACTION_TOP_FRAME_ONLY",
    "automatic_submit": false,
    "overwrite_existing_values": false,
    "conflicting_sources": "HOLD_UNTIL_SOURCE_RESELECTION",
    "preview_expiry_seconds": 600,
    "apply_requires": ["EXPLICIT_CONFIRMATION", "EXACT_TAB", "UNCHANGED_DOCUMENT_AND_FIELDS", "UNCHANGED_SOURCE_SET", "SINGLE_USE_NONCE"],
    "page_handlers_may_have_external_effects": true,
    "dom_readback_proves_external_effect": false,
    "native_firefox_acceptance": false,
    "authenticated_mesh_import_acceptance": false,
    "semantic_model_adapter_acceptance": false,
    "ordinary_release": false
  },
  "proxy_pattern": {
    "name": "QIKVRT_FIREFOX_TERMINAL_PROXY_V1",
    "purpose": "Normalize repository, backend and other client observations into one source-bound terminal frame and gate protected writes through EFFECT_ACK prepare/commit.",
    "input_adapters": [
      "github_public_read",
      "http_backend",
      "local_qikvrt_api_shim",
      "mcp_agent",
      "other_client_snapshot"
    ],
    "output_schema": "qikvrt_terminal_frame_v1",
    "may_render_non_done": true,
    "may_release_non_done": false,
    "may_claim_effect_from_http_success_only": false
  },
  "http": {
    "request_field": "Effect-Ack-Request",
    "response_field": "Effect-Ack",
    "structured_type": "Dictionary",
    "link_relation": "effect-ack",
    "html_element": "link",
    "new_html_parser_feature": false
  },
  "completion_claims": {
    "PASS": false,
    "FINAL_PASS": false,
    "EFFECT_ACK_DONE": false
  },
  "historical_origin_authority": {
    "repository": "Goldkelch/qik-vrt",
    "commit": "88dde0ba2394e941f11b8e848fcd4899bbc5d29c"
  },
  "role_policy_path": "policy/CANONICAL_UPSTREAM_REMOTE_V1.json"
}
