{
  "schema": "qikvrt_action_required_trusted_carrier_proxy_v1",
  "version": "1.0",
  "purpose": "Recover same-repository pull-request exact-head verification when GitHub marks a machine-authored head action_required and direct retry is unavailable.",
  "default_behavior": "AUTO_ATTEMPT_TRUSTED_TREE_IDENTICAL_CARRIER_BEFORE_HUMAN_REINTERACTION",
  "preconditions": {"pull_request_open":true,"same_repository_head":true,"head_matches_expected_sha":true,"head_branch_is_not_default_branch":true,"head_tree_observed":true,"action_required_observed":true,"direct_retry_unavailable_or_rejected":true,"trusted_authenticated_proxy_available":true},
  "operation": {"create_single_parent_commit":true,"parent":"EXACT_OBSERVED_PR_HEAD","tree":"EXACT_OBSERVED_PR_HEAD_TREE","tree_identical":true,"fast_forward_pr_head_only":true,"force_push":false,"main_write":false,"merge":false,"release":false,"deployment":false,"publication":false,"external_effect":false},
  "postconditions": {"reobserve_pr_head":true,"verify_tree_unchanged":true,"discard_prior_head_gate_results":true,"require_fresh_exact_head_gates":true},
  "client_adapters": ["firefox_effect_ack_proxy","cli_gh","http_backend","mcp_agent","authenticated_connector"],
  "failure_mode": "HOLD_WITHOUT_REPEATED_HUMAN_PROMPT_WHEN_NO_TRUSTED_PROXY_IS_AVAILABLE"
}
