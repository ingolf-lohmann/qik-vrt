{
  "schema": "qikvrt_mesh_self_explanation_v1",
  "version": "1.0.0",
  "status": "NORMATIVE_CANDIDATE",
  "owner": "Ingolf Lohmann",
  "purpose": "Make QIK-VRT rapidly understandable, adaptable, integrable, implementable and safely continuable from any ordinary mesh entrypoint without collapsing evidence classes.",
  "entrypoint_contract": {
    "canonical_human_machine_entrypoint": "/AI",
    "public_discovery": [
      "/README.md",
      "/.well-known/qik-vrt-delivery-contract.json",
      "/docs/MESH_SELF_EXPLANATION_AND_DELIVERY.md"
    ],
    "required_progression": [
      "IDENTIFY_SUBJECT_AND_SCOPE",
      "IDENTIFY_CURRENT_EXACT_BINDING",
      "CLASSIFY_CLAIMS",
      "SHOW_SUPPORTING_EVIDENCE",
      "SHOW_NON_EQUIVALENCES",
      "SHOW_OPEN_UNCERTAINTY",
      "SELECT_SMALLEST_SAFE_NEXT_ACTION",
      "EXECUTE_ONLY_IF_AUTHORIZED",
      "READ_BACK_EFFECT",
      "RECLASSIFY_REMAINING_UNCERTAINTY"
    ]
  },
  "uncertainty_rule": {
    "hidden_ambiguity_forbidden": true,
    "plausibility_is_not_resolution": true,
    "every_material_question_must_end_as": [
      "RESOLVED_BY_EVIDENCE",
      "OPEN",
      "HOLD",
      "REOBSERVE",
      "REQUEST_AUTHORITY"
    ],
    "no_false_certainty": true
  },
  "mesh_interoperability": {
    "must_preserve": [
      "provenance",
      "claim_class",
      "uncertainty",
      "exact_subject_binding",
      "authorization_boundary",
      "effect_readback"
    ],
    "adapters_may_extend": true,
    "adapters_may_weaken_core_semantics": false,
    "unknown_required_field": "HOLD"
  },
  "mandatory_non_equivalences": [
    "BYTES != MEANING",
    "SEQUENCE != CAUSALITY",
    "TRANSPORT_ACK != EFFECT_ACK",
    "OBSERVATION != TRUTH",
    "MODEL != REALITY",
    "FORMAL_VERIFIED != PHYSICAL_CORRESPONDENCE",
    "REPOSITORY_EVIDENCE != ZENODO_PUBLICATION",
    "ZENODO_PUBLICATION != EMPIRICAL_CONFIRMATION",
    "DELIVERY_PREPARATION != DELIVERY_ACCEPTED"
  ]
}
