{
  "schema": "qikvrt_github_main_ruleset_v1",
  "repository": "Goldkelch/qik-vrt",
  "ruleset_id": 19344903,
  "name": "QIK-VRT main protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main"
      ]
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_extra_approval_for_unattributed_changes": true,
        "require_last_push_approval": true,
        "required_approving_review_count": 1,
        "required_review_thread_resolution": true,
        "required_reviewers": []
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "QIKVRT required code-owner review",
            "integration_id": 15368
          },
          {
            "context": "test",
            "integration_id": 15368
          }
        ],
        "strict_required_status_checks_policy": true
      }
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "deletion"
    }
  ],
  "authority": {
    "credential": "QIKVRT_RULESET_ADMIN_TOKEN",
    "minimum_permission": "Administration: write",
    "ordinary_github_token_is_sufficient": false,
    "missing_or_rejected_authority": "HOLD_RULESET_ADMIN_AUTHORITY"
  },
  "effect_contract": {
    "pre_state_digest_required": true,
    "conditional_update_required": true,
    "post_update_readback_required": true,
    "exact_post_state_required": true,
    "workflow_success_without_readback_is_effect": false
  }
}
