    "INDEPENDENT_PUBLIC_READBACK",
    "COMPARE_ORACLE_AND_FILE_DIGESTS",
    "APPEND_DURABLE_RECEIPT_TO_ORIGINAL_JOURNAL",
    "EFFECT_ACK_DONE_FOR_THIS_TARGET_ONLY"
  ],
  "invariants": [
    "TRANSPORT_ACK_NE_EFFECT_ACK",
    "EXEC_ACK_NE_EFFECT_ACK",
    "VERIFIED_TARGET_A_NOT_IMPLIES_VERIFIED_TARGET_B",
    "PREDECESSOR_EVIDENCE_TRANSFER=false",
    "NO_GLOBAL_DONE_FROM_LOCAL_PUBLICATION",
