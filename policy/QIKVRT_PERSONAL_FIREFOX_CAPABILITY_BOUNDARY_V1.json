{
  "schema": "qikvrt_personal_firefox_capability_boundary_v1",
  "version": "1.3",
  "source_subject": {
    "repository_roles_source": "policy/CANONICAL_UPSTREAM_REMOTE_V1.json",
    "standard_repository": "ingolf-lohmann/qik-vrt",
    "mirror_repository": "Goldkelch/qik-vrt",
    "personal_repository": "ingolf-lohmann/qik-vrt",
    "personal_payload_root": "personal/ingolf-lohmann/firefox-assistant",
    "predecessor_evidence_transfer": false
  },
  "transitions": {
    "standard_to_personal": "ALLOW_WITH_FRESH_BINDING",
    "personal_to_standard": "DENY_BY_DEFAULT"
  },
  "standard_to_personal_binding": {
    "standard_action": "EXPLICIT_PACKAGED_TAB_NAVIGATION_ONLY",
    "destination": "http://127.0.0.1:8771/personal/#terminal",
    "protected_exchange_in_standard": false,
    "personal_origin": "EXACT_REGISTERED_LOOPBACK_ORIGIN",
    "authentication": "EXISTING_OIDC_WITH_FORCED_FRESH_PROVIDER_VALIDATION",
    "native_admission": "EXPLICIT_CLEAN_HEAD_TREE_REPOSITORY_AND_PR",
    "protocol": "EXISTING_EFFECT_ACK_PREPARE_COMMIT_AND_INDEPENDENT_NATIVE_READBACK",
    "preparation_ttl_seconds": 120,
    "single_use": true,
    "ambiguous_commit": "EXPLICIT_AUTHENTICATED_READBACK_WITHOUT_RETRY",
    "release_scope": "AUTHENTICATED_NATIVE_PERSONAL_BINDING_ONLY",
    "productive_sso_firefox_or_public_delivery_inferred": false
  },
  "invariants": {
    "personal_capability_leak_to_standard": "DENY",
    "personal_state_leak_to_standard": "DENY",
    "personal_credential_leak_to_repository": "DENY",
    "personal_evidence_transfer_to_standard": "DENY",
    "chatgpt_runtime_integration": "AUTHENTICATED_EXTERNAL_SERVICE",
    "chatgpt_proprietary_runtime_redistribution": "DENY",
    "qikvrt_codex_runtime": "LOCAL_DETERMINISTIC",
    "external_service_required_for_codex": false
  },
  "standard_firefox_package": {
    "root": "browser/firefox/qikvrt-terminal",
    "files": [
      "manifest.json",
      "background.js",
      "content.js",
      "terminal.css",
      "options.html",
      "options.js",
      "client.html",
      "README.md"
    ],
    "forbidden_personal_markers": [
      "personal/ingolf-lohmann/",
      "qikvrt_personal_assistant",
      "QIKVRT_PERSONAL_FIREFOX_CAPABILITY_BOUNDARY_V1",
      "QIKVRT_PERSONAL_FIREFOX",
      "OPENAI_API_KEY",
      "CHATGPT_ACCESS_TOKEN",
      "qikvrt_personal_auth",
      "QIKVRT_PERSONAL_AUTH_CONFIG"
    ]
  },
  "personal_release_acceptance": {
    "requires": [
      "exact_subject_binding",
      "personal_capability_manifest",
      "authenticated_runtime_boundary",
      "credential_non_persistence",
      "build_test_observe_readback_accept"
    ],
    "current_candidate": {
      "boundary_contract_materialized": true,
      "personal_capability_manifest_materialized": true,
      "personal_capability_manifest": "personal/ingolf-lohmann/firefox-assistant/CAPABILITIES.json",
      "executable_adapter_materialized": true,
      "normal_baseline_implementation_materialized": true,
      "normal_baseline_runtime_readback": false,
      "authenticated_runtime_readback": false,
      "personal_release_effect_ack_done": false,
      "state": "HOLD"
    }
  },
  "standpoint_codex": "policy/QIKVRT_STANDPOINT_CODEX_V1.json"
}
