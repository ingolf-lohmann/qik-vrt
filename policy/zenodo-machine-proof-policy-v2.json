    "legacy_manifest_readable_for_historical_verification": true,
    "legacy_manifest_may_start_new_production_mutation": false,
    "legacy_v1_bundle_and_return_schemas_are_byte_frozen": true,
    "retrospective_records_require_proof_envelopes": true
