{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QIKVRT formal proof obligation v1",
  "type": "object",
  "required": [
    "schema",
    "required_count",
    "checkers",
    "source_files",
    "module",
    "theorems",
    "change_classes",
    "receipt_required",
    "scope",
    "archives",
    "vectors_path",
    "vectors_sha256",
    "native_workflow_name"
  ],
  "properties": {
    "schema": {
      "const": "qikvrt-formal-proof-obligation/v1"
    },
    "required_count": {
      "const": 7
    },
    "checkers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "repository_url",
          "commit",
          "version",
          "build_command",
          "check_command",
          "expected_output"
        ],
        "properties": {
          "id": {
            "enum": [
              "own-kernel",
              "lean-paranoid",
              "lean4lean",
              "nanoda",
              "con-leche",
              "con-ron",
              "lean-default"
            ]
          },
          "repository_url": {
            "type": "string",
            "pattern": "^https://github.com/[^/]+/[^/]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "build_command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "check_command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "vectors_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
