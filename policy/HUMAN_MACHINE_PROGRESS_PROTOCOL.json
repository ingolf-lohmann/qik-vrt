{
  "schema": "qikvrt-human-machine-progress-protocol/1.4",
  "authority": "docs/HUMAN_MACHINE_PROGRESS_PROTOCOL.md",
  "required_files": {
    "machine_state": "AI_PROGRESS.json",
    "human_projection": "AI_STATUS.md"
  },
  "states": [
    "IDLE",
    "RUNNING",
    "WAITING",
    "PASS",
    "BLOCK",
    "FAIL",
    "TIMEOUT",
    "CANCELLED"
  ],
  "step_states": {
    "completed": "✓",
    "running": "⟳",
    "pending": "□",
    "failed": "✗",
    "blocked": "!"
  },
  "mandatory_fields": [
    "schema",
    "operation_id",
    "repository",
    "ref_name",
    "source_sha",
    "state",
    "percent",
    "current_action",
    "completed_steps",
    "pending_steps",
    "blockers",
    "next_action",
    "updated_at"
  ],
  "communication_rules": {
    "work_before_explanation": true,
    "compact_updates": true,
    "progress_frame_before_every_github_action": true,
    "progress_frame_after_every_github_action": true,
    "progress_frame_on_every_workflow_transition": true,
    "progress_frame_on_every_job_transition": true,
    "progress_frame_on_every_step_transition": true,
    "allow_batched_github_actions_without_intermediate_frame": false,
    "later_summary_compensates_for_missing_frame": false,
    "repeat_unchanged_state": false,
    "claim_pass_without_evidence": false,
    "include_repository_ref_sha": true,
    "include_progress_bar": true,
    "include_concrete_blocker": true,
    "complete_persistence_before_response": true,
    "observation_with_successor_is_terminal_snapshot": false,
    "continue_same_roundtrip_when_successor_exists": true,
    "return_to_user_before_executable_successor_exhausted": false,
    "observation_frequency": "EVENT_AND_WORKLOAD_SENSITIVE",
    "deduplicate_unchanged_observations": true,
    "monitoring_activity_is_progress": false
  },
  "tracked_snapshot": {
    "schema": "qikvrt-ai-progress/3.1",
    "required_fields": [
      "source_semantics",
      "source_evidence",
      "scopes",
      "incomplete_scope_count",
      "repository_effects",
      "projection_owner"
    ],
    "ownerless_state": "IDLE",
    "projection_input_ref_and_sha_are_not_current_remote_state": true,
    "projection_input_must_have_portable_git_object_closure": true,
    "portable_closure_must_recompute_commit_tree_and_blob_git_identities": true,
    "portable_closure_must_traverse_selected_paths_from_commit_root_tree": true,
    "portable_closure_must_reject_missing_or_surplus_objects": true,
    "portable_closure_must_bind_capsule_bytes_sha256_and_git_blob": true,
    "available_local_git_objects_must_match_capsule_bytes": true,
    "portable_closure_does_not_prove_current_ref_history_or_repository_effects": true,
    "scope_specific_release_claims_remain_nested": true,
    "done_scope_requires_repository_ref_sha_checks_and_evidence": true,
    "incomplete_scope_cannot_inherit_pass": true,
    "top_level_continue_or_block_requires_false_release_claims": true,
    "transient_repository_effects_require_fresh_external_evidence": true
  },
  "architecture_rules": {
    "reuse_before_create": true,
    "required_order": [
      "REUSE",
      "EXTEND",
      "PARAMETERIZE",
      "GENERALIZE",
      "REFACTOR",
      "CREATE_NEW"
    ],
    "parallel_component_requires_reuse_evidence": true,
    "repository_is_runtime_authority": true,
    "chat_is_disposable_transport": true,
    "runtime_capabilities_accumulate_in_repository": true,
    "tool_locks_bootstrap_checksums_provenance_tests_and_recovery_are_committed": true,
    "credentials_or_mutable_auth_state_in_cache": false
  },
  "effect_boundary": {
    "transport_ack_is_effect_ack": false,
    "exit_zero_is_final_pass": false,
    "pass_is_scope_bound": true,
    "required_pass_evidence": [
      "repository",
      "ref_name",
      "source_sha",
      "checks",
      "evidence"
    ]
  },
  "client_continuation": {
    "owner_instruction": "Ingolf Lohmann, 2026-10-11",
    "binding_for_all_clients": true,
    "receipt_schema": "qikvrt-client-continuation/1",
    "validator": "tools/ai_handoff.py --client-receipt",
    "regression_gate": "make ai-runtime-contract",
    "preserve_existing_authorization": true,
    "preserve_original_goal_across_handoffs": true,
    "inspect_existing_routes": [
      "repository",
      "connector",
      "cli",
      "mesh"
    ],
    "github_route": "REST_API_ONLY",
    "execute_safe_deterministic_authorized_successors": true,
    "unchanged_causal_failure": "NOOP",
    "ambiguous_effect_requires_readback_before_retry": true,
    "closing_readback": [
      "current_repository_HEAD_TREE",
      "raumzeitterminal.de"
    ],
    "receipt_consistency_proves_live_effect": false,
    "persisted_rule_proves_other_client_adoption": false,
    "end_of_action_rule": {
      "path": "state/authorization/delegations/OWNER_END_OF_ACTION_VERIFICATION_GRUNDREGEL_V1.json",
      "sha256": "598d99efe1605ef7fa5deab70a04fbb5cdc756bd4b368e3394d7c833be58a9d8",
      "source_head": "42008f98a94c28e9bfc1ae902fb190296c6ac5a6",
      "source_pr": 507,
      "git_blob_sha1": "0cda572c33f46216bab7d569a2e61569a61f6722"
    },
    "closing_readback_after_each_effectful_action": true,
    "closing_readback_requires_action_id_and_observation_times": true
  },
  "continuation_semantics": {
    "roundtrip": [
      "OBSERVE",
      "DIAGNOSE",
      "ACT",
      "OBSERVE_EFFECT",
      "VERIFY_READBACK",
      "CONTINUE"
    ],
    "nonterminal_observation_state": "RUNNING",
    "waiting_only_when_external_effect_pending_and_no_local_successor": true,
    "snapshot_allowed_only_when": [
      "NO_EXECUTABLE_SUCCESSOR",
      "EXTERNAL_AUTHORITY_OR_INPUT_REQUIRED",
      "BOUNDED_OBSERVATION_WINDOW_ENDED"
    ],
    "causal_failure_becomes_next_work_unit": true,
    "owner_clarification_date": "2026-10-12",
    "predecessor_failures_omissions_and_gaps_become_successor_tasks": true,
    "automatic_adjoining_run_preserves_existing_authorization": true,
    "predecessor_execution_binding": "previous_run.execution_id",
    "inherited_open_obligations": "previous_run.open_work",
    "successor_disposition": "work: OPEN with next_action or VERIFIED with evidence",
    "silently_dropping_predecessor_open_work": false,
    "rule_persistence_proves_unattended_execution": false
  }
}
