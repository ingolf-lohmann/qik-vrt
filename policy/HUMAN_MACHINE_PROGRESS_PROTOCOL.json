{
  "schema": "qikvrt-human-machine-progress-protocol/1.5",
  "authority": "docs/HUMAN_MACHINE_PROGRESS_PROTOCOL.md",
  "required_files": {
    "machine_state": "AI_PROGRESS.json",
    "human_projection": "AI_STATUS.md"
  },
  "states": [
    "IDLE",
    "RUNNING",
    "WAITING",
    "PASS",
    "BLOCK",
    "FAIL",
    "TIMEOUT",
    "CANCELLED"
  ],
  "step_states": {
    "completed": "✓",
    "running": "⟳",
    "pending": "□",
    "failed": "✗",
    "blocked": "!"
  },
  "mandatory_fields": [
    "schema",
    "operation_id",
    "repository",
    "ref_name",
    "source_sha",
    "state",
    "percent",
    "current_action",
    "completed_steps",
    "pending_steps",
    "blockers",
    "next_action",
    "updated_at"
  ],
  "communication_rules": {
    "work_before_explanation": true,
    "compact_updates": true,
    "progress_frame_before_every_github_action": true,
    "progress_frame_after_every_github_action": true,
    "progress_frame_on_every_workflow_transition": true,
    "progress_frame_on_every_job_transition": true,
    "progress_frame_on_every_step_transition": true,
    "allow_batched_github_actions_without_intermediate_frame": false,
    "later_summary_compensates_for_missing_frame": false,
    "repeat_unchanged_state": false,
    "claim_pass_without_evidence": false,
    "include_repository_ref_sha": true,
    "include_progress_bar": true,
    "include_concrete_blocker": true,
    "complete_persistence_before_response": true,
    "observation_with_successor_is_terminal_snapshot": false,
    "continue_same_roundtrip_when_successor_exists": true,
    "return_to_user_before_executable_successor_exhausted": false,
    "observation_frequency": "EVENT_AND_WORKLOAD_SENSITIVE",
    "deduplicate_unchanged_observations": true,
    "monitoring_activity_is_progress": false
  },
  "tracked_snapshot": {
    "schema": "qikvrt-ai-progress/3.1",
    "required_fields": [
      "source_semantics",
      "source_evidence",
      "scopes",
      "incomplete_scope_count",
      "repository_effects",
      "projection_owner"
    ],
    "ownerless_state": "IDLE",
    "projection_input_ref_and_sha_are_not_current_remote_state": true,
    "projection_input_must_have_portable_git_object_closure": true,
    "portable_closure_must_recompute_commit_tree_and_blob_git_identities": true,
    "portable_closure_must_traverse_selected_paths_from_commit_root_tree": true,
    "portable_closure_must_reject_missing_or_surplus_objects": true,
    "portable_closure_must_bind_capsule_bytes_sha256_and_git_blob": true,
    "available_local_git_objects_must_match_capsule_bytes": true,
    "portable_closure_does_not_prove_current_ref_history_or_repository_effects": true,
    "scope_specific_release_claims_remain_nested": true,
    "done_scope_requires_repository_ref_sha_checks_and_evidence": true,
    "incomplete_scope_cannot_inherit_pass": true,
    "top_level_continue_or_block_requires_false_release_claims": true,
    "transient_repository_effects_require_fresh_external_evidence": true
  },
  "architecture_rules": {
    "reuse_before_create": true,
    "required_order": [
      "REUSE",
      "EXTEND",
      "PARAMETERIZE",
      "GENERALIZE",
      "REFACTOR",
      "CREATE_NEW"
    ],
    "parallel_component_requires_reuse_evidence": true,
    "repository_is_runtime_authority": true,
    "chat_is_disposable_transport": true,
    "runtime_capabilities_accumulate_in_repository": true,
    "tool_locks_bootstrap_checksums_provenance_tests_and_recovery_are_committed": true,
    "credentials_or_mutable_auth_state_in_cache": false
  },
  "effect_boundary": {
    "transport_ack_is_effect_ack": false,
    "exit_zero_is_final_pass": false,
    "pass_is_scope_bound": true,
    "required_pass_evidence": [
      "repository",
      "ref_name",
      "source_sha",
      "checks",
      "evidence"
    ]
  },
  "client_continuation": {
    "owner_instruction": "Ingolf Lohmann, 2026-10-11",
    "binding_for_all_clients": true,
    "receipt_schema": "qikvrt-client-continuation/1",
    "validator": "tools/ai_handoff.py --client-receipt",
    "regression_gate": "make ai-runtime-contract",
    "preserve_existing_authorization": true,
    "preserve_original_goal_across_handoffs": true,
    "inspect_existing_routes": [
      "repository",
      "connector",
      "cli",
      "mesh"
    ],
    "github_route": "REST_API_ONLY",
    "ionos_route": "REST_API_ONLY",
    "ionos_route_owner_instruction": {
      "owner": "Ingolf Lohmann",
      "date": "2026-10-13",
      "exact_text": "REST-only beibehalten",
      "scope": "IONOS authentication and domain/DNS operations for raumzeitterminal.de",
      "browser_login_fallback": false
    },
    "execute_safe_deterministic_authorized_successors": true,
    "unchanged_causal_failure": "NOOP",
    "ambiguous_effect_requires_readback_before_retry": true,
    "closing_readback": [
      "current_repository_HEAD_TREE",
      "raumzeitterminal.de"
    ],
    "receipt_consistency_proves_live_effect": false,
    "persisted_rule_proves_other_client_adoption": false,
    "end_of_action_rule": {
      "path": "state/authorization/delegations/OWNER_END_OF_ACTION_VERIFICATION_GRUNDREGEL_V1.json",
      "sha256": "598d99efe1605ef7fa5deab70a04fbb5cdc756bd4b368e3394d7c833be58a9d8",
      "source_head": "42008f98a94c28e9bfc1ae902fb190296c6ac5a6",
      "source_pr": 507,
      "git_blob_sha1": "0cda572c33f46216bab7d569a2e61569a61f6722"
    },
    "closing_readback_after_each_effectful_action": true,
    "closing_readback_requires_action_id_and_observation_times": true,
    "self_application_rule": {
      "rule_id": "QIKVRT_RECURSIVE_SELF_APPLICATION_20261013",
      "policy": "policy/QIKVRT_DUAL_POLE_RECURSIVE_VERSIONED_CONTINUATION_V1.json#/self_application_working_rule",
      "owner_instruction": "Ingolf Lohmann, 2026-10-13",
      "reuses_existing_client_work_and_causal_gate": true,
      "persists_observer_tasks_without_inventing_an_executor": true
    },
    "immediate_execution_rule": {
      "rule_id": "QIKVRT_IMMEDIATE_EXECUTION_20261013",
      "policy": "policy/QIKVRT_DUAL_POLE_RECURSIVE_VERSIONED_CONTINUATION_V1.json#/self_application_working_rule/immediate_execution_principle",
      "default_disposition": "EXECUTE_IMMEDIATELY_IN_CURRENT_WORK_RING",
      "reuses_existing_successor_admission_and_return_gate": true,
      "defer_executable_work_to_another_turn": false
    },
    "anticipated_transitions": {
      "owner_instruction": "Ingolf Lohmann, 2026-10-15",
      "policy": "policy/QIKVRT_DUAL_POLE_RECURSIVE_VERSIONED_CONTINUATION_V1.json#/self_application_working_rule/anticipated_transitions",
      "receipt_field": "transition_plan",
      "current_input_binding": "input_sha256",
      "validator_output": "CLIENT_TRANSITION_PLAN",
      "available_preparation_requires_continue": true,
      "changed_inputs_require_plan_reassessment": true,
      "unchanged_causal_failure_remains_noop": true,
      "historical_receipts_without_plan_remain_readable": true,
      "plan_is_execution_or_speedup_proof": false
    },
    "communication_evidence": {
      "owner_instruction": "Ingolf Lohmann, 2026-10-19: Erkenne dich selbst und verbessere dich.",
      "receipt_field": "communications",
      "validator": "tools/ai_handoff.py --client-receipt",
      "original_claim_tool": "node-tools/qikvrt_mirror_emit.py claim",
      "historical_receipts_without_field_remain_readable": true,
      "canonical_message_sha256_and_named_node_required": true,
      "unsent_packet_proves_arrival_or_receiver_nack": false,
      "principal_return_proves_named_receiver_or_application": false,
      "application_requires_exact_independent_native_readback": true,
      "validator_issues_effect_ack_assessments": false,
      "consistency_proves_evidence_authenticity_or_client_adoption": false
    },
    "knowledge_continuity": {
      "owner_instruction": "Ingolf Lohmann, 2026-10-16: Knowledge loss itself is the defect regardless of when it occurs.",
      "existing_policy": "policy/QIKVRT_EPISTEMIC_CONNECTABILITY_CONTINUITY_V1.json",
      "existing_policy_sha256": "1e4e9d30a730559e801c7cd840b8f02795b39fbfe1988fe2a85bbeecbf40d909",
      "existing_policy_git_blob_sha1": "bac643895963db5ccf6bfd87588aa5b38aa580e7",
      "receipt_field": "knowledge",
      "predecessor_binding_fields": [
        "receipt_path",
        "receipt_sha256"
      ],
      "record_required_fields": [
        "id",
        "epistemic_class",
        "subject",
        "scope",
        "statement",
        "evidence",
        "record_sha256"
      ],
      "record_digest_encoding": "UTF-8 JSON, sorted keys, compact separators, ensure_ascii=false, allow_nan=false; omit record_sha256",
      "preserve_declared_predecessor_records": true,
      "correction_is_append_only_supersedes": true,
      "derive_knowledge_and_open_work_from_pinned_predecessor": true,
      "local_environment_absence_proves_remote_binding_absent": false,
      "historical_receipts_without_snapshot_remain_readable": true,
      "consistency_proves_truth_or_complete_initial_knowledge": false,
      "preserved_observation_proves_current_successor_acceptance": false,
      "existing_validator": "tools/ai_handoff.py --client-receipt",
      "current_baseline": "state/work_units/QIKVRT_CLIENT_KNOWLEDGE_CONTINUITY_REPAIR_20261016_V1.json",
      "historical_encoding_migration": {
        "schema": "qikvrt-knowledge-historical-encoding-migration/v1",
        "codec": "json-sorted-spaced-utf8/v1",
        "scope": "EXACT_PINNED_PREDECESSOR_RECORDS_ONLY",
        "requires_pinned_predecessor": true,
        "new_records_remain_canonical": true,
        "receipt_field": "knowledge_encoding_migration",
        "maximum_records": 128,
        "original_bytes_and_record_fields_immutable": true,
        "automatic_encoding_fallback": false,
        "semantic_or_epistemic_promotion": false,
        "predecessor_pass_transfer": false
      }
    }
  },
  "continuation_semantics": {
    "roundtrip": [
      "OBSERVE",
      "DIAGNOSE",
      "ACT",
      "OBSERVE_EFFECT",
      "VERIFY_READBACK",
      "CONTINUE"
    ],
    "nonterminal_observation_state": "RUNNING",
    "waiting_only_when_external_effect_pending_and_no_local_successor": true,
    "snapshot_allowed_only_when": [
      "NO_EXECUTABLE_SUCCESSOR",
      "EXTERNAL_AUTHORITY_OR_INPUT_REQUIRED",
      "BOUNDED_OBSERVATION_WINDOW_ENDED"
    ],
    "causal_failure_becomes_next_work_unit": true,
    "owner_clarification_date": "2026-10-12",
    "predecessor_failures_omissions_and_gaps_become_successor_tasks": true,
    "automatic_adjoining_run_preserves_existing_authorization": true,
    "predecessor_execution_binding": "previous_run.execution_id",
    "inherited_open_obligations": "previous_run.open_work",
    "successor_disposition": "work: OPEN with next_action or VERIFIED with evidence",
    "silently_dropping_predecessor_open_work": false,
    "rule_persistence_proves_unattended_execution": false
  }
}
