{
  "schema": "QIKVRT_BINARY_PROGRESS_CLOSURE_V1",
  "purpose": "Make progress total: every observed exact-subject state is either terminal or has exactly one admissible continuation.",
  "states": {
    "0": "TERMINAL_NO_WORK",
    "1": "CONTINUATION_REQUIRED"
  },
  "invariants": [
    "work_remaining => continuation_required",
    "continuation_required => admissible_action_count == 1",
    "stale_canonical_integrity => action == CANONICAL_INTEGRITY_CLOSURE",
    "canonical_integrity_closure => successor_required",
    "successor_created => fresh_successor_local_validation_required",
    "fresh_validation_reset_is_transition_not_terminal_state",
    "external_authority_required => event_subscription_required",
    "external_authority_required => synthetic_authority_forbidden",
    "no_predecessor_evidence_transfer"
  ],
  "forbidden_states": [
    "work_remaining && action == NONE",
    "stale_canonical_integrity && state == HOLD && action == NONE",
    "successor_created && fresh_validation == NONE",
    "event_required && subscription == NONE",
    "reset && terminal"
  ],
  "closure": {
    "technical_gap": "materialize_one_bounded_successor_then_validate_fresh",
    "authority_gap": "subscribe_to_native_event_then_reobserve_exact_subject",
    "no_gap": "TERMINAL_NO_WORK"
  },
  "fixed_point": "work_remaining == false",
  "non_claims": [
    "review approval",
    "Main integration",
    "deployment",
    "publication",
    "EFFECT_ACK_DONE"
  ]
}
