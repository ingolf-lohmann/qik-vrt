temdd 0.1;
authority owner = "Ingolf Lohmann";
subject transputer {
  repository = "Goldkelch/qik-vrt";
  binding = exact;
}
request roundtrip { target = BOOLEAN_ROUNDTRIP; }
on event {
  follow exact;
  classify causal;
  effect boolean_lut {
    require authority;
    require validation;
    commit;
    readback;
  }
}
on blocker {
  learn smallest_sound_successor;
  execute successor;
}
until { RESULT_MATCHES && DURABLE_READBACK; }
